//@version=6
// =============================================================================
// MTF Confluence System — MODULE M1: Pivot Engine (Confirmed ZigZag)
// -----------------------------------------------------------------------------
// Özgün algoritma: "Dual-Tracker Confirmed Deviation ZigZag"
//
//   - Onaylanmış pivotlar: bir tepe/dip, fiyat ondan (dondurulmuş) theta = k*ATR
//     kadar TERS yöne çekildiğinde VE en az minBars kapanmış bar geçtiğinde
//     KESİNLEŞİR.
//   - İki bağımsız motor: MAIN (yapısal, büyük eşik) ve FAST (taktik, küçük eşik).
//     İkisi de aynı fonksiyonu farklı parametreyle örnekler; ayrı state tutarlar.
//   - REPAINT YOK: pivot fiyatı/indeksi (bidx) geçmişte sabittir; yalnızca "onay"
//     olayı ileri bir barda (confIdx) tetiklenir. Tüm state mutasyonu
//     barstate.isconfirmed ile yalnızca KAPANMIŞ barlarda çalışır.
//
// Bu dosya M1'in izole görsel testidir. Mimari kararı gereği STRATEGY iskeleti
// olarak yazılmıştır (indicator değil) — böylece çekirdek fonksiyonlar ileride
// başka dosyadan TAŞINMAYACAK; sonraki modüller (M2..M9) bu dosyaya eklenecektir.
// Şimdilik hiçbir entry/exit emri yoktur; yalnızca görsel doğrulama çalışır.
//
// Yasaklı gösterge yok: yalnızca OHLC geometrisi + ATR (volatilite ölçüsü).
// EMA/RSI/MACD/hacim/momentum veya başka dış filtre KULLANILMAZ.
// =============================================================================

strategy("M1 · Pivot Engine (Confirmed ZigZag)", overlay = true, pyramiding = 0,
     max_lines_count = 500, max_labels_count = 500)

// ----------------------------------------------------------------------------
// Tipler
// ----------------------------------------------------------------------------

// Onaylanmış pivot kaydı. kind: +1 = HIGH (tepe), -1 = LOW (dip).
// bidx  : pivotun GERÇEKLEŞTİĞİ bar_index (geçmişte, sabit) — fiyat burada oluştu.
// confIdx: pivotun BİLİNDİĞİ/onaylandığı bar_index (bidx'ten büyük/eşit).
// theta : onayı sağlayan, aday barında DONDURULMUŞ sapma eşiği (k*ATR).
// NOT (strateji tasarımı): gelecekte strateji girişleri YALNIZCA confIdx barında
// veya SONRASINDA yapılabilir; asla bidx'te değil. Çünkü pivot bidx'te henüz
// "bilinmiyordu"; bidx'te giriş geleceğe bakmak (repaint) olurdu.
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Motor durumu (state machine).
//   init  : ilk (ATR'li) bar görüldü mü?
//   booted: yön belirlendi mi? (bootstrap tamamlandı mı?)
//   dir   : +1 => bir TEPE arıyoruz, -1 => bir DİP arıyoruz.
//   cur*  : mevcut aday uç (aranan yöndeki ekstrem)  + curTheta (aday barında donmuş eşik)
//   opp*  : ters uç takipçisi (geri çekilme derinliği) + oppTheta (o barda donmuş eşik)
// Bootstrap sırasında cur* = TEPE takipçisi, opp* = DİP takipçisi olarak kullanılır.
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// ----------------------------------------------------------------------------
// Girdiler
// ----------------------------------------------------------------------------
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Genel")

grpMain     = "MAIN motor (yapısal)"
mainK       = input.float(3.0, "MAIN sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = grpMain)
mainMinBars = input.int(8,     "MAIN minimum bar",         minval = 1, group = grpMain)

grpFast     = "FAST motor (taktik)"
fastK       = input.float(1.0, "FAST sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = grpFast)
fastMinBars = input.int(3,     "FAST minimum bar",         minval = 1, group = grpFast)

grpViz      = "Görsel"
showMain    = input.bool(true, "MAIN zigzag göster", group = grpViz)
showFast    = input.bool(true, "FAST zigzag göster", group = grpViz)

// ----------------------------------------------------------------------------
// M1 çekirdek fonksiyonları
// ----------------------------------------------------------------------------

// Yeni, sıfırlanmış bir motor üretir.
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

// Bir motoru tek bar ileri adımlar. Bir pivot ONAYLANDIYSA onu döndürür, aksi
// halde na döndürür. State doğrudan `e` nesnesi üzerinde mutasyona uğrar.
// NOT: yalnızca KAPANMIŞ barlarda çağrılmalıdır (repaint güvenliği).
//
// KONSERVATİF BAR-İÇİ KURAL (madde 3):
//   Bir mumun içinde high ve low'un hangi sırada oluştuğu Pine'de BİLİNMEZ.
//   Bu yüzden AYNI mumda hem yeni bir ekstrem oluşur hem de ters sapma
//   koşulu sağlanırsa, o ekstremi kullanan pivot onayı O BARDA VERİLMEZ.
//   Uygulama: onay kontrolleri yalnızca "yeni ekstrem oluşmayan" dalda çalışır
//   (normal modda 'else' dalı; bootstrap'ta 'not newHigh' / 'not newLow' koşulu).
f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            // İlk (ATR'li) bar: bootstrap trackerlarını kur. Yön HENÜZ belirsiz.
            // theta ilk andan itibaren gerçek ATR ile donar (na değil).
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            // ---- BOOTSTRAP: hem tepe (cur) hem dip (opp) adayını izle ----------
            // İlk yeterli ATR sapması gerçekleşince ilk yönü ve ilk pivotu belirle.
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr    // aday güncellendi -> eşik yeni aday barının ATR'si
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            // Ters sapma onayları — konservatif kural gereği yeni ekstrem oluşan
            // takipçi için AYNI barda onay verilmez.
            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            // İki koşul da doğruysa: kronolojik olarak DAHA ERKEN ekstrem ilk pivottur.
            // curIdx == oppIdx ise (her iki uç AYNI barda) sıra bilinmediğinden HİÇBİRİ
            // seçilmez — konservatif kural gereği bu barda pivot verilmez.
            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                // İlk pivot = TEPE (cur). Artık DİP arıyoruz.
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                // Yeni dip adayı = bu barın low'u. (Bootstrap opp-low tepe ÖNCESİNE
                // ait olabileceğinden yeni aday olarak kullanılmaz.)
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                // İlk pivot = DİP (opp). Artık TEPE arıyoruz.
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            // ---- NORMAL: yön belli, tek yönde aday izle -----------------------
            if e.dir == 1
                // TEPE arıyoruz
                if high > e.curPrice
                    // Daha yüksek tepe: adayı yükselt, eşiği YENİ aday barında dondur,
                    // geri-çekilme takipçisini sıfırla.
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    // Yeni tepe YOK (konservatif kural sağlanır): geri çekilmeyi izle,
                    // gerekiyorsa onayla. Eşik curTheta SABİT kalır (sonraki ATR'ler etkilemez).
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        // DİP aramaya geç: yeni aday = geri-çekilme dibi (tepe SONRASI, geçerli).
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta   // aday dip barında donmuş eşik
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                // DİP arıyoruz
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// ----------------------------------------------------------------------------
// Motorların örneklenmesi + ring buffer
// ----------------------------------------------------------------------------
var Engine mainEng = f_engine_new()
var Engine fastEng = f_engine_new()

var array<Pivot> mainPivots = array.new<Pivot>()
var array<Pivot> fastPivots = array.new<Pivot>()

BUFFER_MAX = 32

// Ring buffer'a pivot ekler, kapasiteyi korur.
f_push(array<Pivot> buf, Pivot p) =>
    array.push(buf, p)
    if array.size(buf) > BUFFER_MAX
        array.shift(buf)

atr = ta.atr(atrLen)

// REPAINT GÜVENLİĞİ: state yalnızca bar kapanınca ilerler.
Pivot mainNew = na
Pivot fastNew = na
if barstate.isconfirmed
    mainNew := f_engine_step(mainEng, mainK, mainMinBars, atr)
    fastNew := f_engine_step(fastEng, fastK, fastMinBars, atr)
    if not na(mainNew)
        f_push(mainPivots, mainNew)
    if not na(fastNew)
        f_push(fastPivots, fastNew)

// ----------------------------------------------------------------------------
// Görsel doğrulama (yalnızca M1 testi için)
//   - Zigzag çizgisi + H/L etiketi pivotun GERÇEK barında (bidx) çizilir.
//   - Onay barında (confIdx == bu bar) ayrıca küçük "confirmed" işareti konur.
// ----------------------------------------------------------------------------
var Pivot mainLast = na
var Pivot fastLast = na

if not na(mainNew)
    if showMain
        if not na(mainLast)
            line.new(mainLast.bidx, mainLast.price, mainNew.bidx, mainNew.price,
                 xloc = xloc.bar_index, color = color.new(color.orange, 0), width = 2)
        label.new(mainNew.bidx, mainNew.price, mainNew.kind == 1 ? "H" : "L",
             xloc = xloc.bar_index,
             yloc = mainNew.kind == 1 ? yloc.abovebar : yloc.belowbar,
             style = mainNew.kind == 1 ? label.style_label_down : label.style_label_up,
             color = color.new(color.orange, 20), textcolor = color.white, size = size.small)
    mainLast := mainNew

if not na(fastNew)
    if showFast
        if not na(fastLast)
            line.new(fastLast.bidx, fastLast.price, fastNew.bidx, fastNew.price,
                 xloc = xloc.bar_index, color = color.new(color.teal, 40),
                 width = 1, style = line.style_dashed)
    fastLast := fastNew

// "confirmed" işaretleri: onay barında (bar_index == confIdx) çizilir.
// Bu bar, strateji girişinin en erken yapılabileceği bardır.
plotshape(showMain and not na(mainNew), title = "MAIN confirmed",
     style = shape.circle, location = location.belowbar,
     color = color.new(color.orange, 0), size = size.tiny)
plotshape(showFast and not na(fastNew), title = "FAST confirmed",
     style = shape.circle, location = location.abovebar,
     color = color.new(color.teal, 0), size = size.tiny)

// ----------------------------------------------------------------------------
// Denetim tablosu — MAIN ve FAST motorları yan yana (etiket | MAIN | FAST)
// ----------------------------------------------------------------------------

// Bir motor için tablo değer dizisini (string) üretir.
f_engine_dir_str(Engine e) =>
    e.booted ? (e.dir == 1 ? "tepe arıyor" : "dip arıyor") : "bootstrap"

if barstate.islast
    var table t = table.new(position.top_right, 3, 10, border_width = 1)

    // MAIN sütunu
    hasM     = not na(mainLast)
    mKind    = hasM ? (mainLast.kind == 1 ? "H (tepe)" : "L (dip)") : "-"
    mPrice   = hasM ? str.tostring(mainLast.price, format.mintick) : "-"
    mBidx    = hasM ? str.tostring(mainLast.bidx) : "-"
    mConf    = hasM ? str.tostring(mainLast.confIdx) : "-"
    mDelay   = hasM ? str.tostring(mainLast.confIdx - mainLast.bidx) : "-"
    mTheta   = hasM ? str.tostring(mainLast.theta, format.mintick) : "-"

    // FAST sütunu
    hasF     = not na(fastLast)
    fKind    = hasF ? (fastLast.kind == 1 ? "H (tepe)" : "L (dip)") : "-"
    fPrice   = hasF ? str.tostring(fastLast.price, format.mintick) : "-"
    fBidx    = hasF ? str.tostring(fastLast.bidx) : "-"
    fConf    = hasF ? str.tostring(fastLast.confIdx) : "-"
    fDelay   = hasF ? str.tostring(fastLast.confIdx - fastLast.bidx) : "-"
    fTheta   = hasF ? str.tostring(fastLast.theta, format.mintick) : "-"

    // Başlık satırı
    table.cell(t, 0, 0, "M1 · Alan", bgcolor = color.gray, text_color = color.white)
    table.cell(t, 1, 0, "MAIN",      bgcolor = color.new(color.orange, 0), text_color = color.white)
    table.cell(t, 2, 0, "FAST",      bgcolor = color.new(color.teal, 0),   text_color = color.white)

    table.cell(t, 0, 1, "Pivot sayısı")
    table.cell(t, 1, 1, str.tostring(array.size(mainPivots)))
    table.cell(t, 2, 1, str.tostring(array.size(fastPivots)))

    table.cell(t, 0, 2, "Motor yön")
    table.cell(t, 1, 2, f_engine_dir_str(mainEng))
    table.cell(t, 2, 2, f_engine_dir_str(fastEng))

    table.cell(t, 0, 3, "Son pivot türü")
    table.cell(t, 1, 3, mKind)
    table.cell(t, 2, 3, fKind)

    table.cell(t, 0, 4, "Son pivot fiyat")
    table.cell(t, 1, 4, mPrice)
    table.cell(t, 2, 4, fPrice)

    table.cell(t, 0, 5, "Pivot barı (bidx)")
    table.cell(t, 1, 5, mBidx)
    table.cell(t, 2, 5, fBidx)

    table.cell(t, 0, 6, "Confirm barı (confIdx)")
    table.cell(t, 1, 6, mConf)
    table.cell(t, 2, 6, fConf)

    table.cell(t, 0, 7, "Confirm gecikmesi")
    table.cell(t, 1, 7, mDelay)
    table.cell(t, 2, 7, fDelay)

    table.cell(t, 0, 8, "Theta (sabit)")
    table.cell(t, 1, 8, mTheta)
    table.cell(t, 2, 8, fTheta)
