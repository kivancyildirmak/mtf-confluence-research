//@version=6
// =============================================================================
// HARMONIC PREDICTION ENGINE — Historical Prediction Display
// -----------------------------------------------------------------------------
// AMAÇ: confirmed XABC anında üretilen "Primary D Target" prediction'larını
//   geçmişte BAR BAR üretip, her birini SNAPSHOT kayıt olarak saklamak ve
//   seçilen görüntüleme moduna göre çizmek. Böylece geçmiş prediction'ların
//   gerçekten oluştuğu görsel olarak doğrulanabilir.
//
// KORUNAN ALTYAPI (davranış değişmedi): repaint-safe pivot motoru, XABC
//   doğrulaması, XA/BC projection hesapları, P0 cluster/confluence motoru,
//   adaptif tolerans, minimum support ve Primary D Target mantığı.
//
// BU SÜRÜMDE YOK (henüz): strategy(), entry/exit, HIT/FAILED/EXPIRED, trade logic.
//   Yalnızca historical prediction ÜRETİMİ ve GÖRÜNTÜLEME davranışı.
//
// REPAINT/TEST GÜVENLİĞİ: motor yalnızca barstate.isconfirmed içinde ilerler;
//   her kutu, prediction'ın OLUŞTUĞU (confirmed C) bardan itibaren çizilir;
//   geçmişe gelecek bilgisi taşınmaz; request.security/lookahead yok; kayıtlar
//   bir daha hesaplanmaz.
// =============================================================================

// =============================================================================
// STRATEGY WRAPPER (Strategy Tester). Bu dosya, gösterge dosyasının BİREBİR
// kopyası + long-only trade katmanıdır. Pivot / harmonik / qualification /
// evaluation mantığı DEĞİŞTİRİLMEDİ (satır satır aynı). Eklenen tek şey: onaylı
// BUY sinyali barında (C-confirmation bar) emir üretimi.
//
// ÖNEMLİ: Giriş, C'nin OLUŞTUĞU tarihsel fiyattan DEĞİL, C'nin ONAYLANDIĞI
// (sinyalin doğduğu) bardan yapılır. Emir sinyal barının KAPANIŞINDA verilir ve
// Strategy Tester varsayimi ile BİR SONRAKİ barın açılışında dolar (lookahead
// yok). Etiketlerde C→giriş bar farkı açıkça gösterilir.
//
// COMMISSION / SLIPPAGE: Pine, strategy() başlığında bunları CONST ister
// (input veremezsin — CE10123). Aşağıdaki değerler VARSAYILAN; kullanıcı bunları
// Strategy Tester'ın "Properties" (Özellikler) sekmesinden düzenler — commission
// ve slippage için TradingView'ın yerel, düzenlenebilir yeri budur.
// =============================================================================
strategy("Harmonic Prediction Strategy", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000, pyramiding = 0, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, calc_on_every_tick = false, process_orders_on_close = false, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1)

// --- Strategy katmanı input'ları ---
grpStrat   = "Strategy"
tradeMode  = input.string("QUALIFIED + WEAK", "Trade mode", options = ["All", "QUALIFIED only", "QUALIFIED + WEAK"], group = grpStrat, tooltip = "Hangi qStatus'lu sinyaller işleme girer. QUALIFIED=1, WEAK=2 (SHADOW etiketleri; qualification mantığı DEĞİŞMEZ).")
riskPct    = input.float(1.0, "Risk % of equity per trade", minval = 0.01, maxval = 100.0, step = 0.1, group = grpStrat)
// Giriş: pivot ~3*ATR yükselince onaylandığından, C-confirmation'da MARKET girmek
// çok geç/pahalı. Varsayılan PULLBACK: C'ye doğru geri çekilmede limit ile daha
// iyi fiyat → daha küçük stop → R:R yükselir. Dolmazsa iptal (işlem yok).
entryMode  = input.string("Pullback", "Entry mode", options = ["Pullback", "Market"], group = grpStrat, tooltip = "Pullback: C'ye geri çekilmede limit emir. Market: sinyal barı kapanışında piyasa (agresif, daha çok dolum ama düşük R:R).")
pullbackFrac   = input.float(0.5, "Pullback fraction (C->signal)", minval = 0.0, maxval = 0.95, step = 0.05, group = grpStrat, tooltip = "Limit = C + f*(sinyal kapanışı - C). 0=C'de, 0.5=ortada.")
entryValidBars = input.int(8, "Entry limit valid (bars)", minval = 1, group = grpStrat, tooltip = "Limit bu kadar bar içinde dolmazsa iptal.")
stopBufferATR  = input.float(0.25, "Stop buffer (× ATR below C)", minval = 0.0, step = 0.05, group = grpStrat, tooltip = "Yapısal stop = C - max(bufferATR*ATR, minStopTicks).")
minStopTicks   = input.int(5, "Stop buffer min ticks", minval = 0, group = grpStrat)
minRR      = input.float(2.0, "Minimum R:R", minval = 0.0, step = 0.1, group = grpStrat, tooltip = "entry->stop mesafesine göre hedefe uzaklık bu orandan küçükse işlem reddedilir.")
minTargetDistATR = input.float(1.0, "Min target distance (× ATR)", minval = 0.0, step = 0.1, group = grpStrat, tooltip = "Giriş D hedefine bu ATR'den yakınsa işlem reddedilir (D'ye çok yakın).")
maxTradeBars = input.int(15, "Max trade duration (bars)", minval = 1, group = grpStrat, tooltip = "Doldurulan pozisyon bu kadar bar sonra piyasadan kapatılır (evaluation maxActiveBars'tan AYRI).")

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Pivot Engine")
pivK        = input.float(3.0, "Pivot sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = "Pivot Engine")
pivMinBars  = input.int(8,     "Pivot minimum bar",         minval = 1, group = "Pivot Engine")

grpPred     = "Prediction / Cluster"
projLen     = input.int(50, "Kutu uzunluğu (bar)",        minval = 5, group = grpPred)
patternTolPct = input.float(0.50, "Pattern tolerance (% of XA)", minval = 0.01, maxval = 5.0, step = 0.01, group = grpPred)
atrFloorMult  = input.float(0.10, "ATR floor multiplier",         minval = 0.0,  step = 0.01, group = grpPred)
minTolTicks   = input.int(5,      "Minimum tolerance ticks",      minval = 1, group = grpPred)
minSupport    = input.int(2,      "Minimum projections per cluster", minval = 2, group = grpPred)
showSecond  = input.bool(false, "Secondary D Target göster (yalnız görsel)", group = grpPred)
showSources = input.bool(false, "Kutuda kaynakları göster (XA/BC ratio)", group = grpPred)
colPrimary  = input.color(color.new(color.lime,   0), "Primary kutu rengi",   group = grpPred)
colSecond   = input.color(color.new(color.orange, 0), "Secondary kutu rengi", group = grpPred)

grpFilt     = "XABC Geçerlilik Filtreleri"
abXaMin     = input.float(0.25, "AB/XA min", step = 0.01, group = grpFilt)
abXaMax     = input.float(0.90, "AB/XA max", step = 0.01, group = grpFilt)
bcAbMin     = input.float(0.30, "BC/AB min", step = 0.01, group = grpFilt)
bcAbMax     = input.float(2.00, "BC/AB max", step = 0.01, group = grpFilt)

grpView     = "Görünüm / Historical"
histDisplay = input.string("All historical", "Historical display mode", options = ["Latest only", "All historical", "Last N predictions"], group = grpView)
histCount   = input.int(50, "Historical prediction count", minval = 1, group = grpView)
showXABC    = input.bool(false, "X/A/B/C harflerini göster", group = grpView)

grpEval       = "Evaluation Engine"
failMode      = input.string("C ± ATR", "Failure Mode", options = ["C ± ATR", "X Pivot", "None"], group = grpEval)
evalAtrMult   = input.float(0.50, "ATR Multiplier", minval = 0.0, step = 0.05, group = grpEval)
maxActiveBars = input.int(50, "Maximum Active Bars", minval = 1, group = grpEval)
ambigMode     = input.string("Conservative", "Ambiguous Handling", options = ["Conservative", "Optimistic", "Ignore"], group = grpEval)

grpAn         = "Prediction Analytics"
analyticsView = input.string("Evaluation Summary", "Analytics View", options = ["Evaluation Summary", "Score Thresholds", "Support Thresholds", "Direction", "Cluster Width", "Target Distance", "XA Scale", "BC Ratio"], group = grpAn)
minReliableN  = input.int(20, "Minimum Reliable Sample", minval = 1, group = grpAn)

grpRes         = "Prediction Research"
researchView   = input.string("Research Summary", "Research View", options = ["Research Summary", "Top Features", "Negative Features", "Top Combinations", "Stability", "Recommendations"], group = grpRes)
minStrongN     = input.int(50, "Minimum Strong Sample", minval = 1, group = grpRes)
coverageFloor  = input.float(10.0, "Coverage Floor (%)", minval = 0.0, step = 1.0, group = grpRes)
maxPerFamily   = input.int(2, "Maximum Results Per Feature Family", minval = 1, group = grpRes)

grpConf      = "Confidence Engine"
confGain     = input.float(2.0, "Confidence spread (gain)", minval = 0.5, maxval = 5.0, step = 0.1, group = grpConf)
showConfBox  = input.bool(true, "Kutuda Confidence göster", group = grpConf)

// =============================================================================
// DASHBOARD MANAGER — tek yerden yerleşim/görünürlük yönetimi (motor matematiği
// değişmez; yalnızca hangi tablonun nerede/nasıl gösterileceğini belirler).
// =============================================================================
grpDash       = "Dashboard"
dashLayout    = input.string("Single Panel", "Dashboard Layout", options = ["Single Panel", "Multi Panel", "Minimal"], group = grpDash)
dashView      = input.string("Evaluation", "Dashboard View (Single Panel)", options = ["Evaluation", "Analytics", "Research", "Confidence", "Debug"], group = grpDash)
mShowEval     = input.bool(true,  "Show Evaluation (Multi)", group = grpDash)
mShowConf     = input.bool(true,  "Show Confidence (Multi)", group = grpDash)
mShowAnalytic = input.bool(false, "Show Analytics (Multi)",  group = grpDash)
mShowResearch = input.bool(false, "Show Research (Multi)",   group = grpDash)
mShowDebug    = input.bool(false, "Show Debug (Multi)",      group = grpDash)

grpMeta      = "Meta Research"
researchMode = input.string("Local", "Research Mode", options = ["Local", "Export"], group = grpMeta)
exportFmt    = input.string("CSV", "Export Format", options = ["CSV", "JSON"], group = grpMeta)

// Qualification V1 — SHADOW MODE. Sınıflandırır ama HİÇBİR prediction'ı bastırmaz.
grpQual            = "Qualification (Shadow)"
qMinMarketResolved = input.int(40,   "Min market resolved (N0)", minval = 1, group = grpQual)
qMinBucketResolved = input.int(20,   "Min bucket resolved",      minval = 1, group = grpQual)
qMinCoverage       = input.float(0.05, "Min coverage",           minval = 0.0, step = 0.01, group = grpQual)
qQualifiedMinLift  = input.float(0.05, "Qualified min lift",     step = 0.01, group = grpQual)
qRejectedMaxLift   = input.float(-0.05,"Rejected max lift",      step = 0.01, group = grpQual)
showQual           = input.bool(true, "Show Qualification panel (orta)", group = grpQual)
qStudyExport       = input.bool(false, "Export per-prediction log (threshold study)", group = grpQual, tooltip = "Pine Logs'a her prediction için tek satır: QSTUDY,id,createBar,resolveBar,outcome,scB,tdB. tests/threshold_study.py bunu okur. SHADOW; hiçbir kararı etkilemez.")

// =============================================================================
// Veri yapıları
// =============================================================================
// Onaylanmış pivot. kind: +1 = HIGH (tepe), -1 = LOW (dip).
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Pivot motoru durumu (state machine).
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// Tek bir ham projeksiyon seviyesi. src: 0 = XA, 1 = BC.
type Proj
    float price
    int   src
    float ratio

// Bir prediction'ın çizim nesneleri (grup bazlı gizleme/silme için).
type PredGroup
    array<label> labels
    array<box>   boxes

// Prediction SNAPSHOT kaydı. Oluşturulunca yazılır, bir daha DEĞİŞMEZ/SİLİNMEZ.
// direction: +1 = D yukarıda (H-L-H-L), -1 = D aşağıda (L-H-L-H).
type PredRec
    int   id
    int   creationBar
    int   pivotCBar
    int   direction
    float targetLow
    float targetHigh
    float centerPrice
    float score
    int   support
    PredGroup viz        // canlı çizim nesneleri (yoksa boş/na)
    // --- Evaluation Engine snapshot alanları (oluşumda yazılır, bir daha değişmez) ---
    int   status             // 0 ACTIVE, 1 HIT, 2 FAILED, 3 EXPIRED
    int   resolvedBar        // çözüldüğü bar (na = henüz ACTIVE)
    float resultPrice        // çözümü tetikleyen fiyat (hedef / invalidation / expire close)
    int   barsAlive          // resolvedBar - creationBar
    float invalidationPrice  // FAILED seviyesi (snapshot; na = invalidation yok)
    float creationATR        // oluşum anındaki ATR (snapshot)
    // --- Analytics snapshot alanları (oluşumda dondurulur, pasif; algoritmayı etkilemez) ---
    float clusterSpread
    float clusterTolerance
    float normalizedClusterWidth
    float xaLength
    float bcLength
    float xaAtrMultiple
    float bcAtrMultiple
    float abXaRatio
    float bcAbRatio
    float targetDistance
    float targetDistanceATR
    float targetDistanceXA
    // --- Confidence Engine (oluşum anında, yalnız geçmiş istatistikten; dondurulur) ---
    float confidence
    // --- Qualification V1 (SHADOW) — oluşumda dondurulur; hiçbir kararı ETKİLEMEZ ---
    // qStatus: 0 UNKNOWN, 1 QUALIFIED, 2 WEAK, 3 REJECTED
    // qReason: 0 evaluated | 1 MARKET_SAMPLE_LOW | 2 INVALID_BASELINE | 3 NO_BUCKET
    //          4 SINGLE_SAMPLE_LOW | 5 COVERAGE_LOW | 6 OTHER
    // qBucketType: 0 none, 1 joint(Score×Dist), 2 single Score, 3 single Dist
    int   qStatus
    int   qReason
    int   qBucketType
    int   qBucketN
    int   qMarketN
    float qBaseline
    float qCond
    float qLift
    float qCoverage
    // Threshold-study export (as-of-creation, lookahead-safe): raw score/dist bins.
    int   qScBin
    int   qTdBin
    // --- Feature Engineering bin'leri (oluşumda dondurulur; pasif; yalnız analytics/research) ---
    int   emaTrendBin    // 0 bull (EMA50>EMA200), 1 bear
    int   emaSlopeBin    // 0 up, 1 flat, 2 down
    int   adxBin         // 0 <20, 1 20-30, 2 30-40, 3 40+
    int   rsiBin         // 0 <40, 1 40-50, 2 50-60, 3 60-70, 4 70+
    int   volBin         // 0 low, 1 normal, 2 high (ATR percentile)
    int   distE50Bin     // 0 near, 1 mid, 2 far
    int   distE200Bin    // 0 near, 1 mid, 2 far
    int   trendStrBin    // 0 HH-HL, 1 LH-LL, 2 range
    int   swingBin       // 0 small, 1 mid, 2 large (XA impulse in ATR)
    int   volExpBin      // 0 expanding, 1 contracting
    int   timePivBin     // 0 short, 1 mid, 2 long (bars since C pivot)
    int   ageBin         // 0 trend start, 1 mid, 2 end (ADX regime proxy)

// Research Engine aday temsili (yalnızca son barda, sıralama/sınıflandırma için).
// fam: 0 Score 1 Support 2 Direction 3 ClusterWidth 4 TargetDist 5 XA 6 BC 7 Combo
// Tekil adayda kindB = -1. kind kodları: 0 Score,1 Support,2 TargetDist,3 ClusterWidth,4 Direction.
type Cand
    int    fam
    int    ord
    string label
    string cond2
    int    kindA
    int    lvlA
    int    kindB
    int    lvlB
    int    hit
    int    fail
    int    exp

// =============================================================================
// Repaint-safe pivot motoru (KORUNAN ALTYAPI — davranış değişmedi)
// -----------------------------------------------------------------------------
// "Dual-Tracker Confirmed Deviation ZigZag": bir uç, fiyat ondan (dondurulmuş)
// theta = k*ATR kadar TERS çekildiğinde VE en az minBars kapanmış bar geçince
// KESİNLEŞİR. Konservatif bar-içi kural: aynı mumda hem yeni ekstrem hem ters
// sapma oluşursa o barda onay verilmez. Yalnızca KAPANMIŞ barlarda çağrılır.
// =============================================================================
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// Prediction / Cluster yardımcıları (KORUNAN ALTYAPI)
// =============================================================================

// XABC geçerlilik kontrolü (oranlar GRAFİKTE gösterilmez; yalnızca filtre).
f_xabc_valid(Pivot X, Pivot A, Pivot B, Pivot C) =>
    bool chrono = X.bidx < A.bidx and A.bidx < B.bidx and B.bidx < C.bidx
    bool alt    = X.kind != A.kind and A.kind != B.kind and B.kind != C.kind
    bool form   = (X.kind == -1 and A.kind == 1 and B.kind == -1 and C.kind == 1) or (X.kind == 1 and A.kind == -1 and B.kind == 1 and C.kind == -1)
    float xa = math.abs(A.price - X.price)
    float ab = math.abs(B.price - A.price)
    float bc = math.abs(C.price - B.price)
    bool legs = xa > 0 and ab > 0 and bc > 0
    bool ratios = false
    if legs
        float abXa = ab / xa
        float bcAb = bc / ab
        ratios := abXa >= abXaMin and abXa <= abXaMax and bcAb >= bcAbMin and bcAb <= bcAbMax
    chrono and alt and form and legs and ratios

// En YÜKSEK SKORLU kümeyi bulur (used=true olanlar hariç). Skor = ağırlıklı:
//   + farklı ratio sayısı (aynı ratio tekrarına ekstra yok)
//   + XA ve BC birlikte varsa mix bonusu (+2)  (yalnız-BC / yalnız-XA daha düşük)
//   + sıkılık bonusu: 2*max(0, 1 - spread/(2*tol))  (spread=0→2, =tol→1, =2*tol→0)
// Bir küme aday olabilmek için en az minSupport DISTINCT projeksiyon içermelidir
//   (aynı fiyat+aynı oran kopyası ayrı destek saymaz). Uygun küme yoksa bestIdx=-1.
// DÖNÜŞ: [merkezIndex, skor, altFiyat, üstFiyat, destekSayısı].
f_best_cluster(array<Proj> projs, array<bool> used, float tol, int minSupport) =>
    int   nD = array.size(projs)
    int   bestIdx = -1
    float bestScore = -1.0
    float bestLo = na
    float bestHi = na
    int   bestSupport = 0
    // Sıfıra bölünmeye karşı güvenli alt sınır (tol zaten tickFloor ile > 0'dır).
    float safeTol = math.max(tol, syminfo.mintick)
    for i = 0 to nD - 1
        if not array.get(used, i)
            float center = array.get(projs, i).price
            float lo = na
            float hi = na
            bool  hasXA = false
            bool  hasBC = false
            int   distinct = 0
            int   support  = 0
            for j = 0 to nD - 1
                if not array.get(used, j)
                    Proj pj = array.get(projs, j)
                    if math.abs(pj.price - center) <= tol
                        lo := na(lo) ? pj.price : math.min(lo, pj.price)
                        hi := na(hi) ? pj.price : math.max(hi, pj.price)
                        if pj.src == 0
                            hasXA := true
                        else
                            hasBC := true
                        bool firstOfRatio  = true
                        bool firstOfMember = true
                        for k = 0 to j - 1
                            if not array.get(used, k)
                                Proj pk = array.get(projs, k)
                                if math.abs(pk.price - center) <= tol
                                    if pk.ratio == pj.ratio
                                        firstOfRatio := false
                                    // Aynı fiyat VE aynı oran = kaza eseri kopya; destek saymaz.
                                    if pk.ratio == pj.ratio and pk.price == pj.price
                                        firstOfMember := false
                        if firstOfRatio
                            distinct += 1
                        if firstOfMember
                            support += 1
            float spread     = na(hi) ? 0.0 : hi - lo
            float normSpread = spread / (2.0 * safeTol)
            float tight      = 2.0 * math.max(0.0, 1.0 - normSpread)
            float score      = distinct + (hasXA and hasBC ? 2.0 : 0.0) + tight
            // En az minSupport DISTINCT projeksiyon içeren kümeler aday olabilir.
            if support >= minSupport and score > bestScore
                bestIdx     := i
                bestScore   := score
                bestLo      := lo
                bestHi      := hi
                bestSupport := support
    [bestIdx, bestScore, bestLo, bestHi, bestSupport]

// Merkez etrafındaki (tol içi, used olmayan) üyeleri işaretler ve kaynak metnini
// ("XA 0.886, BC 2.240") döndürür. Skorlama sonrası kutu metni + used için tek geçiş.
f_cluster_src_and_mark(array<Proj> projs, array<bool> used, float tol, int centerIdx) =>
    float center = array.get(projs, centerIdx).price
    string s = ""
    for j = 0 to array.size(projs) - 1
        if not array.get(used, j)
            Proj pj = array.get(projs, j)
            if math.abs(pj.price - center) <= tol
                s := s + (s == "" ? "" : ", ") + (pj.src == 0 ? "XA " : "BC ") + str.tostring(pj.ratio, "#.###")
                array.set(used, j, true)
    s

// Bir pivotu harf etiketiyle işaretler ve label'ı döndürür.
f_mark(int bidx, float price, string txt) =>
    label.new(bidx, price, txt, xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 25), textcolor = color.white, size = size.small,
         force_overlay = true)

// D-target kümesini kutu olarak çizer ve kutuyu DÖNDÜRÜR (grup çağıran tarafından yönetilir).
// conf: na değilse "Confidence NN%" satırı eklenir (yalnız Score'un YANINDA; Score değişmez).
f_target_box(int x1, int x2, float lo, float hi, float score, string title, color col, float atrv, string srcText, float conf) =>
    float pad = (hi - lo) < atrv * 0.05 ? atrv * 0.20 : 0.0
    string txt = title + "\n" + str.tostring(lo, format.mintick) + " – " + str.tostring(hi, format.mintick) + "\nScore " + str.tostring(score, "#.#")
    if showConfBox and not na(conf)
        txt := txt + "\nConfidence " + str.tostring(conf, "#") + "%"
    if showSources and str.length(srcText) > 0
        txt := txt + "\n" + srcText
    box.new(x1, hi + pad, x2, lo - pad, border_color = col, bgcolor = color.new(col, 82),
         text = txt, text_color = col, text_size = size.small,
         text_halign = text.align_left, text_valign = text.align_center, force_overlay = true)

// Bir prediction grubunun tüm ÇİZİM nesnelerini güvenle siler (KAYIT silinmez).
f_group_delete(PredGroup g) =>
    if array.size(g.labels) > 0
        for lb in g.labels
            label.delete(lb)
        array.clear(g.labels)
    if array.size(g.boxes) > 0
        for bx in g.boxes
            box.delete(bx)
        array.clear(g.boxes)

// Debug tabloya bir "etiket | değer" satırı yazar.
f_drow(table t, int r, string lbl, string val, color bg) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_right)

// =============================================================================
// Evaluation Engine yardımcıları (saf; prediction algoritmasına dokunmaz)
// =============================================================================
f_scoreBucket(float s) => s < 5.0 ? 0 : s < 6.0 ? 1 : s < 7.0 ? 2 : 3
f_supBucket(int sup)   => sup <= 2 ? 0 : sup == 3 ? 1 : sup == 4 ? 2 : 3
f_pctS(int num, int den) => den > 0 ? str.tostring(100.0 * num / den, "#.#") + "%" : "—"
f_avgS(int sum, int den) => den > 0 ? str.tostring(sum / den, "#.#") : "—"

