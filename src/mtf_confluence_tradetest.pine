var array<int> feD200_hit  = array.from(0, 0, 0)
var array<int> feD200_fail = array.from(0, 0, 0)
var array<int> feD200_exp  = array.from(0, 0, 0)
var array<int> feTr_hit    = array.from(0, 0, 0)
var array<int> feTr_fail   = array.from(0, 0, 0)
var array<int> feTr_exp    = array.from(0, 0, 0)
var array<int> feSw_hit    = array.from(0, 0, 0)
var array<int> feSw_fail   = array.from(0, 0, 0)
var array<int> feSw_exp    = array.from(0, 0, 0)
var array<int> feEx_hit    = array.from(0, 0)
var array<int> feEx_fail   = array.from(0, 0)
var array<int> feEx_exp    = array.from(0, 0)
var array<int> feTm_hit    = array.from(0, 0, 0)
var array<int> feTm_fail   = array.from(0, 0, 0)
var array<int> feTm_exp    = array.from(0, 0, 0)
var array<int> feAg_hit    = array.from(0, 0, 0)
var array<int> feAg_fail   = array.from(0, 0, 0)
var array<int> feAg_exp    = array.from(0, 0, 0)
// Feature bucket etiketleri (research tekil aday satırları için).
var array<string> feEmaT_lbl = array.from("EMA Bull", "EMA Bear")
var array<string> feSlp_lbl  = array.from("Slope Up", "Slope Flat", "Slope Down")
var array<string> feAdx_lbl  = array.from("ADX<20", "ADX20-30", "ADX30-40", "ADX40+")
var array<string> feRsi_lbl  = array.from("RSI<40", "RSI40-50", "RSI50-60", "RSI60-70", "RSI70+")
var array<string> feVol_lbl  = array.from("Vol Low", "Vol Norm", "Vol High")
var array<string> feD50_lbl  = array.from("E50 Near", "E50 Mid", "E50 Far")
var array<string> feD200_lbl = array.from("E200 Near", "E200 Mid", "E200 Far")
var array<string> feTr_lbl   = array.from("HH-HL", "LH-LL", "Range")
var array<string> feSw_lbl   = array.from("Swing S", "Swing M", "Swing L")
var array<string> feEx_lbl   = array.from("ATR Exp", "ATR Contr")
