// =============================================================================
// PREDICTION ANALYTICS yardımcıları (pasif; prediction/evaluation'a dokunmaz)
// =============================================================================
// Bucket / bin fonksiyonları (saf).
f_scBin(float s) => s < 5.0 ? 0 : s < 5.5 ? 1 : s < 6.0 ? 2 : s < 6.5 ? 3 : s < 7.0 ? 4 : 5
f_spBin(int sup) => sup <= 2 ? 0 : sup == 3 ? 1 : sup == 4 ? 2 : 3
f_cwBin(float w) => na(w) ? 3 : w <= 0.25 ? 0 : w <= 0.50 ? 1 : w <= 1.00 ? 2 : 3
f_tdBin(float t) => na(t) ? 3 : t <= 1.0 ? 0 : t <= 2.0 ? 1 : t <= 4.0 ? 2 : 3
f_xaBin(float x) => na(x) ? 0 : x < 3.0 ? 0 : x < 6.0 ? 1 : x < 10.0 ? 2 : 3
f_bcBin(float r) => na(r) ? 0 : r < 0.382 ? 0 : r < 0.50 ? 1 : r < 0.618 ? 2 : r < 0.786 ? 3 : 4

// CONFIDENCE v2 — evidence-weighted LOG-ODDS kanıt birikimi (Naive-Bayes tarzı).
// Bir feature bucket'ının log-odds kaymasını (δ) ve kanıt ağırlığını (evidence-weighted
// feature weight) döndürür: [wNum, wDen]. Bunlar dış tarafta ağırlıklı ORTALAMA'ya girer.
//   δ  = clamp( logit(hitRate_bucket) - logit(baseline), ±dmax )   (tek feature domine edemez)
//   ev = (h+f) / ((h+f)+K)   → düşük örneklem yumuşak biçimde sönümlenir (K = prior)
//   wNum = wFeat*ev*δ , wDen = wFeat*ev
// Veri yoksa (h+f=0) katkı 0. Additif "lift/10" sıkıştırması KALDIRILDI.
f_confAcc(int h, int f, float p0, int K, float dmax, float wFeat) =>
    float wn = 0.0
    float wd = 0.0
    if (h + f) >= 1 and not na(p0) and p0 > 0.0 and p0 < 1.0
        float pb = math.max(0.02, math.min(0.98, h / (h + f)))
        float d  = math.max(-dmax, math.min(dmax, math.log(pb / (1.0 - pb)) - math.log(p0 / (1.0 - p0))))
        float ev = (h + f) / (float(h + f) + K)
        wn := wFeat * ev * d
        wd := wFeat * ev
    [wn, wd]

// Confidence kalibrasyon bini: 0:0-20 1:20-40 2:40-60 3:60-80 4:80-100.
f_confBin(float conf) => na(conf) ? 2 : conf < 20 ? 0 : conf < 40 ? 1 : conf < 60 ? 2 : conf < 80 ? 3 : 4

// ---- FEATURE ENGINEERING bin fonksiyonları (saf; değerleri parametre alır) ----
f_binEmaTrend(float e50, float e200) => (na(e50) or na(e200)) ? 0 : e50 > e200 ? 0 : 1
f_binEmaSlope(float s)  => na(s) ? 1 : s > 0.15 ? 0 : s < -0.15 ? 2 : 1
f_binAdx(float a)       => na(a) ? 0 : a < 20 ? 0 : a < 30 ? 1 : a < 40 ? 2 : 3
f_binRsi(float r)       => na(r) ? 1 : r < 40 ? 0 : r < 50 ? 1 : r < 60 ? 2 : r < 70 ? 3 : 4
f_binVol(float pct)     => na(pct) ? 1 : pct < 33 ? 0 : pct < 66 ? 1 : 2
f_binDist(float dATR)   => na(dATR) ? 1 : dATR < 1.0 ? 0 : dATR < 2.5 ? 1 : 2
f_binSwing(float xaATR) => na(xaATR) ? 0 : xaATR < 3.0 ? 0 : xaATR < 6.0 ? 1 : 2
f_binVolExp(bool exp)   => exp ? 0 : 1
f_binTimePiv(int bars)  => bars < 10 ? 0 : bars < 25 ? 1 : 2
f_binAge(float adx, bool rising) => na(adx) ? 0 : adx < 25.0 ? 0 : rising ? 1 : 2

// Bir üçlü (hit/fail/exp) sayaç dizisinde bucket b'yi rs sonucuna göre artırır.
f_bump3(array<int> h, array<int> f, array<int> e, int b, int rs) =>
    if rs == 1
        array.set(h, b, array.get(h, b) + 1)
    else if rs == 2
        array.set(f, b, array.get(f, b) + 1)
    else
        array.set(e, b, array.get(e, b) + 1)

// start bin'den sona kümülatif toplam (threshold tabloları için).
f_cumFrom(array<int> a, int start) =>
    int s = 0
    for i = start to array.size(a) - 1
        s += array.get(a, i)
    s

// Analytics renk paleti (task 14).
var color ANA_TITLE = color.rgb(25, 25, 25)
var color ANA_HDR   = color.rgb(50, 50, 50)
var color ANA_CELL  = color.rgb(20, 20, 20)
var color ANA_LEFT  = color.rgb(55, 55, 55)
var color ANA_LOWN  = color.rgb(90, 70, 0)   // koyu sarı/kahve
var color ANA_POS   = color.rgb(0, 90, 0)    // pozitif lift
var color ANA_NEG   = color.rgb(120, 0, 0)   // negatif lift

// Analytics sütun başlığı satırı (11 sütun).
f_anHeader(table t, int r) =>
    table.cell(t, 0,  r, "Group",   text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1,  r, "N",       text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2,  r, "Hit",     text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3,  r, "Fail",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4,  r, "Exp",     text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5,  r, "ResHit%", text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6,  r, "Ovr%",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7,  r, "Cov%",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8,  r, "Lift",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 9,  r, "AvgH",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 10, r, "AvgF",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)

// Analytics veri satırı. sumHit/sumFail < 0 => AvgH/AvgF sütunu boş. base100 na olabilir.
f_anRow(table t, int r, string lbl, int h, int f, int e, int totRes, float base100, int minN, int sumHit, int sumFail) =>
    int   n     = h + f + e
    bool  lowN  = n < minN
    color cb    = lowN ? ANA_LOWN : ANA_CELL
    int   resDen = h + f
    string resStr  = resDen > 0 ? str.tostring(100.0 * h / resDen, "#.#") + "%" + (lowN ? " LOW N" : "") : "—"
    string ovStr   = n > 0 ? str.tostring(100.0 * h / n, "#.#") + "%" : "—"
    string covStr  = totRes > 0 ? str.tostring(100.0 * n / totRes, "#.#") + "%" : "—"
    float  lift    = resDen > 0 ? (100.0 * h / resDen - base100) : na
    string liftStr = na(lift) ? "—" : (lift >= 0 ? "+" : "") + str.tostring(lift, "#.#") + " pp"
    color  liftBg  = lowN ? ANA_LOWN : na(lift) ? ANA_CELL : lift > 0 ? ANA_POS : lift < 0 ? ANA_NEG : ANA_CELL
    string ahStr   = sumHit  < 0 ? "" : (h > 0 ? str.tostring(sumHit  / h, "#.#") : "—")
    string afStr   = sumFail < 0 ? "" : (f > 0 ? str.tostring(sumFail / f, "#.#") : "—")
    color  ahBg    = sumHit  < 0 ? ANA_CELL : cb
    color  afBg    = sumFail < 0 ? ANA_CELL : cb
    table.cell(t, 0,  r, lbl,             text_color = color.white, bgcolor = ANA_LEFT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1,  r, str.tostring(n), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2,  r, str.tostring(h), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3,  r, str.tostring(f), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4,  r, str.tostring(e), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5,  r, resStr,          text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6,  r, ovStr,           text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7,  r, covStr,          text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8,  r, liftStr,         text_color = color.white, bgcolor = liftBg, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 9,  r, ahStr,           text_color = color.white, bgcolor = ahBg,   text_size = size.small, text_halign = text.align_right)
    table.cell(t, 10, r, afStr,           text_color = color.white, bgcolor = afBg,   text_size = size.small, text_halign = text.align_right)

// Analytics özet metrik satırı (label | value; kalan sütunlar doldurulur).
f_anMetric(table t, int r, string lbl, string val) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = ANA_LEFT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = ANA_CELL, text_size = size.small, text_halign = text.align_right)
    for c = 2 to 10
        table.cell(t, c, r, "", bgcolor = ANA_CELL)

// =============================================================================
// Motor örneği + confirmed pivot ring buffer (KORUNAN ALTYAPI, çizilmez)
// =============================================================================
var Engine        pivEng = f_engine_new()
var array<Pivot>  pivots = array.new<Pivot>()
BUFFER_MAX = 16

atr = ta.atr(atrLen)

// =============================================================================
// FEATURE ENGINEERING — bağımsız pasif göstergeler (yalnızca snapshot/analytics
// için; prediction/target/confidence'ı ETKİLEMEZ). Global scope'ta her barda
// hesaplanır (repaint-safe); oluşum anında değerleri dondurulur.
// =============================================================================
grpFeat    = "Feature Engineering"
feEmaFast  = input.int(50,  "EMA fast",  minval = 2, group = grpFeat)
feEmaSlow  = input.int(200, "EMA slow",  minval = 5, group = grpFeat)
feAdxLen   = input.int(14,  "ADX length", minval = 2, group = grpFeat)
feRsiLen   = input.int(14,  "RSI length", minval = 2, group = grpFeat)
feVolLook  = input.int(100, "ATR percentile lookback", minval = 10, group = grpFeat)
feSlopeLb  = input.int(5,   "EMA slope / expansion lookback", minval = 1, group = grpFeat)

feEma50  = ta.ema(close, feEmaFast)
feEma200 = ta.ema(close, feEmaSlow)
[feDiP, feDiM, feAdx] = ta.dmi(feAdxLen, feAdxLen)
feRsi    = ta.rsi(close, feRsiLen)
feAtrPct = ta.percentrank(atr, feVolLook)
feSlopeAtr  = atr > 0 ? (feEma50 - feEma50[feSlopeLb]) / atr : na
feAtrExpand = atr > atr[feSlopeLb]
feAdxRising = feAdx >= feAdx[feSlopeLb]

var array<float> xaRatios = array.from(0.786, 0.886, 1.000, 1.130, 1.272, 1.618)
var array<float> bcRatios = array.from(1.272, 1.414, 1.618, 2.000, 2.240, 2.618, 3.140, 3.618)

