//@version=6
// =============================================================================
// HARMONIC PREDICTION ENGINE — Historical Prediction Display
// -----------------------------------------------------------------------------
// AMAÇ: confirmed XABC anında üretilen "Primary D Target" prediction'larını
//   geçmişte BAR BAR üretip, her birini SNAPSHOT kayıt olarak saklamak ve
//   seçilen görüntüleme moduna göre çizmek. Böylece geçmiş prediction'ların
//   gerçekten oluştuğu görsel olarak doğrulanabilir.
//
// KORUNAN ALTYAPI (davranış değişmedi): repaint-safe pivot motoru, XABC
//   doğrulaması, XA/BC projection hesapları, P0 cluster/confluence motoru,
//   adaptif tolerans, minimum support ve Primary D Target mantığı.
//
// BU SÜRÜMDE YOK (henüz): strategy(), entry/exit, HIT/FAILED/EXPIRED, trade logic.
//   Yalnızca historical prediction ÜRETİMİ ve GÖRÜNTÜLEME davranışı.
//
// REPAINT/TEST GÜVENLİĞİ: motor yalnızca barstate.isconfirmed içinde ilerler;
//   her kutu, prediction'ın OLUŞTUĞU (confirmed C) bardan itibaren çizilir;
//   geçmişe gelecek bilgisi taşınmaz; request.security/lookahead yok; kayıtlar
//   bir daha hesaplanmaz.
// =============================================================================

indicator("Harmonic Prediction Engine", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Pivot Engine")
pivK        = input.float(3.0, "Pivot sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = "Pivot Engine")
pivMinBars  = input.int(8,     "Pivot minimum bar",         minval = 1, group = "Pivot Engine")

grpPred     = "Prediction / Cluster"
projLen     = input.int(50, "Kutu uzunluğu (bar)",        minval = 5, group = grpPred)
patternTolPct = input.float(0.50, "Pattern tolerance (% of XA)", minval = 0.01, maxval = 5.0, step = 0.01, group = grpPred)
atrFloorMult  = input.float(0.10, "ATR floor multiplier",         minval = 0.0,  step = 0.01, group = grpPred)
minTolTicks   = input.int(5,      "Minimum tolerance ticks",      minval = 1, group = grpPred)
minSupport    = input.int(2,      "Minimum projections per cluster", minval = 2, group = grpPred)
showSecond  = input.bool(false, "Secondary D Target göster (yalnız görsel)", group = grpPred)
showSources = input.bool(false, "Kutuda kaynakları göster (XA/BC ratio)", group = grpPred)
colPrimary  = input.color(color.new(color.lime,   0), "Primary kutu rengi",   group = grpPred)
colSecond   = input.color(color.new(color.orange, 0), "Secondary kutu rengi", group = grpPred)

grpFilt     = "XABC Geçerlilik Filtreleri"
abXaMin     = input.float(0.25, "AB/XA min", step = 0.01, group = grpFilt)
abXaMax     = input.float(0.90, "AB/XA max", step = 0.01, group = grpFilt)
bcAbMin     = input.float(0.30, "BC/AB min", step = 0.01, group = grpFilt)
bcAbMax     = input.float(2.00, "BC/AB max", step = 0.01, group = grpFilt)

grpView     = "Görünüm / Historical"
histDisplay = input.string("All historical", "Historical display mode", options = ["Latest only", "All historical", "Last N predictions"], group = grpView)
histCount   = input.int(50, "Historical prediction count", minval = 1, group = grpView)
showXABC    = input.bool(false, "X/A/B/C harflerini göster", group = grpView)
showDebug   = input.bool(false, "Debug tablo göster (sağ alt)", group = grpView)

grpEval       = "Evaluation Engine"
failMode      = input.string("C ± ATR", "Failure Mode", options = ["C ± ATR", "X Pivot", "None"], group = grpEval)
evalAtrMult   = input.float(0.50, "ATR Multiplier", minval = 0.0, step = 0.05, group = grpEval)
maxActiveBars = input.int(50, "Maximum Active Bars", minval = 1, group = grpEval)
ambigMode     = input.string("Conservative", "Ambiguous Handling", options = ["Conservative", "Optimistic", "Ignore"], group = grpEval)
showEval      = input.bool(true, "Evaluation dashboard göster (sağ üst)", group = grpEval)

grpAn         = "Prediction Analytics"
analyticsView = input.string("Evaluation Summary", "Analytics View", options = ["Evaluation Summary", "Score Thresholds", "Support Thresholds", "Direction", "Cluster Width", "Target Distance", "XA Scale", "BC Ratio"], group = grpAn)
minReliableN  = input.int(20, "Minimum Reliable Sample", minval = 1, group = grpAn)
showAnalytics = input.bool(true, "Show Analytics Dashboard (sol üst)", group = grpAn)

// =============================================================================
// Veri yapıları
// =============================================================================
// Onaylanmış pivot. kind: +1 = HIGH (tepe), -1 = LOW (dip).
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Pivot motoru durumu (state machine).
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// Tek bir ham projeksiyon seviyesi. src: 0 = XA, 1 = BC.
type Proj
    float price
    int   src
    float ratio

// Bir prediction'ın çizim nesneleri (grup bazlı gizleme/silme için).
type PredGroup
    array<label> labels
    array<box>   boxes

// Prediction SNAPSHOT kaydı. Oluşturulunca yazılır, bir daha DEĞİŞMEZ/SİLİNMEZ.
// direction: +1 = D yukarıda (H-L-H-L), -1 = D aşağıda (L-H-L-H).
type PredRec
    int   id
    int   creationBar
    int   pivotCBar
    int   direction
    float targetLow
    float targetHigh
    float centerPrice
    float score
    int   support
    PredGroup viz        // canlı çizim nesneleri (yoksa boş/na)
    // --- Evaluation Engine snapshot alanları (oluşumda yazılır, bir daha değişmez) ---
    int   status             // 0 ACTIVE, 1 HIT, 2 FAILED, 3 EXPIRED
    int   resolvedBar        // çözüldüğü bar (na = henüz ACTIVE)
    float resultPrice        // çözümü tetikleyen fiyat (hedef / invalidation / expire close)
    int   barsAlive          // resolvedBar - creationBar
    float invalidationPrice  // FAILED seviyesi (snapshot; na = invalidation yok)
    float creationATR        // oluşum anındaki ATR (snapshot)
    // --- Analytics snapshot alanları (oluşumda dondurulur, pasif; algoritmayı etkilemez) ---
    float clusterSpread
    float clusterTolerance
    float normalizedClusterWidth
    float xaLength
    float bcLength
    float xaAtrMultiple
    float bcAtrMultiple
    float abXaRatio
    float bcAbRatio
    float targetDistance
    float targetDistanceATR
    float targetDistanceXA

// =============================================================================
// Repaint-safe pivot motoru (KORUNAN ALTYAPI — davranış değişmedi)
// -----------------------------------------------------------------------------
// "Dual-Tracker Confirmed Deviation ZigZag": bir uç, fiyat ondan (dondurulmuş)
// theta = k*ATR kadar TERS çekildiğinde VE en az minBars kapanmış bar geçince
// KESİNLEŞİR. Konservatif bar-içi kural: aynı mumda hem yeni ekstrem hem ters
// sapma oluşursa o barda onay verilmez. Yalnızca KAPANMIŞ barlarda çağrılır.
// =============================================================================
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// Prediction / Cluster yardımcıları (KORUNAN ALTYAPI)
// =============================================================================

// XABC geçerlilik kontrolü (oranlar GRAFİKTE gösterilmez; yalnızca filtre).
f_xabc_valid(Pivot X, Pivot A, Pivot B, Pivot C) =>
    bool chrono = X.bidx < A.bidx and A.bidx < B.bidx and B.bidx < C.bidx
    bool alt    = X.kind != A.kind and A.kind != B.kind and B.kind != C.kind
    bool form   = (X.kind == -1 and A.kind == 1 and B.kind == -1 and C.kind == 1) or (X.kind == 1 and A.kind == -1 and B.kind == 1 and C.kind == -1)
    float xa = math.abs(A.price - X.price)
    float ab = math.abs(B.price - A.price)
    float bc = math.abs(C.price - B.price)
    bool legs = xa > 0 and ab > 0 and bc > 0
    bool ratios = false
    if legs
        float abXa = ab / xa
        float bcAb = bc / ab
        ratios := abXa >= abXaMin and abXa <= abXaMax and bcAb >= bcAbMin and bcAb <= bcAbMax
    chrono and alt and form and legs and ratios

// En YÜKSEK SKORLU kümeyi bulur (used=true olanlar hariç). Skor = ağırlıklı:
//   + farklı ratio sayısı (aynı ratio tekrarına ekstra yok)
//   + XA ve BC birlikte varsa mix bonusu (+2)  (yalnız-BC / yalnız-XA daha düşük)
//   + sıkılık bonusu: 2*max(0, 1 - spread/(2*tol))  (spread=0→2, =tol→1, =2*tol→0)
// Bir küme aday olabilmek için en az minSupport DISTINCT projeksiyon içermelidir
//   (aynı fiyat+aynı oran kopyası ayrı destek saymaz). Uygun küme yoksa bestIdx=-1.
// DÖNÜŞ: [merkezIndex, skor, altFiyat, üstFiyat, destekSayısı].
f_best_cluster(array<Proj> projs, array<bool> used, float tol, int minSupport) =>
    int   nD = array.size(projs)
    int   bestIdx = -1
    float bestScore = -1.0
    float bestLo = na
    float bestHi = na
    int   bestSupport = 0
    // Sıfıra bölünmeye karşı güvenli alt sınır (tol zaten tickFloor ile > 0'dır).
    float safeTol = math.max(tol, syminfo.mintick)
    for i = 0 to nD - 1
        if not array.get(used, i)
            float center = array.get(projs, i).price
            float lo = na
            float hi = na
            bool  hasXA = false
            bool  hasBC = false
            int   distinct = 0
            int   support  = 0
            for j = 0 to nD - 1
                if not array.get(used, j)
                    Proj pj = array.get(projs, j)
                    if math.abs(pj.price - center) <= tol
                        lo := na(lo) ? pj.price : math.min(lo, pj.price)
                        hi := na(hi) ? pj.price : math.max(hi, pj.price)
                        if pj.src == 0
                            hasXA := true
                        else
                            hasBC := true
                        bool firstOfRatio  = true
                        bool firstOfMember = true
                        for k = 0 to j - 1
                            if not array.get(used, k)
                                Proj pk = array.get(projs, k)
                                if math.abs(pk.price - center) <= tol
                                    if pk.ratio == pj.ratio
                                        firstOfRatio := false
                                    // Aynı fiyat VE aynı oran = kaza eseri kopya; destek saymaz.
                                    if pk.ratio == pj.ratio and pk.price == pj.price
                                        firstOfMember := false
                        if firstOfRatio
                            distinct += 1
                        if firstOfMember
                            support += 1
            float spread     = na(hi) ? 0.0 : hi - lo
            float normSpread = spread / (2.0 * safeTol)
            float tight      = 2.0 * math.max(0.0, 1.0 - normSpread)
            float score      = distinct + (hasXA and hasBC ? 2.0 : 0.0) + tight
            // En az minSupport DISTINCT projeksiyon içeren kümeler aday olabilir.
            if support >= minSupport and score > bestScore
                bestIdx     := i
                bestScore   := score
                bestLo      := lo
                bestHi      := hi
                bestSupport := support
    [bestIdx, bestScore, bestLo, bestHi, bestSupport]

// Merkez etrafındaki (tol içi, used olmayan) üyeleri işaretler ve kaynak metnini
// ("XA 0.886, BC 2.240") döndürür. Skorlama sonrası kutu metni + used için tek geçiş.
f_cluster_src_and_mark(array<Proj> projs, array<bool> used, float tol, int centerIdx) =>
    float center = array.get(projs, centerIdx).price
    string s = ""
    for j = 0 to array.size(projs) - 1
        if not array.get(used, j)
            Proj pj = array.get(projs, j)
            if math.abs(pj.price - center) <= tol
                s := s + (s == "" ? "" : ", ") + (pj.src == 0 ? "XA " : "BC ") + str.tostring(pj.ratio, "#.###")
                array.set(used, j, true)
    s

// Bir pivotu harf etiketiyle işaretler ve label'ı döndürür.
f_mark(int bidx, float price, string txt) =>
    label.new(bidx, price, txt, xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 25), textcolor = color.white, size = size.small,
         force_overlay = true)

// D-target kümesini kutu olarak çizer ve kutuyu DÖNDÜRÜR (grup çağıran tarafından yönetilir).
f_target_box(int x1, int x2, float lo, float hi, float score, string title, color col, float atrv, string srcText) =>
    float pad = (hi - lo) < atrv * 0.05 ? atrv * 0.20 : 0.0
    string txt = title + "\n" + str.tostring(lo, format.mintick) + " – " + str.tostring(hi, format.mintick) + "\nScore " + str.tostring(score, "#.#")
    if showSources and str.length(srcText) > 0
        txt := txt + "\n" + srcText
    box.new(x1, hi + pad, x2, lo - pad, border_color = col, bgcolor = color.new(col, 82),
         text = txt, text_color = col, text_size = size.small,
         text_halign = text.align_left, text_valign = text.align_center, force_overlay = true)

// Bir prediction grubunun tüm ÇİZİM nesnelerini güvenle siler (KAYIT silinmez).
f_group_delete(PredGroup g) =>
    if array.size(g.labels) > 0
        for lb in g.labels
            label.delete(lb)
        array.clear(g.labels)
    if array.size(g.boxes) > 0
        for bx in g.boxes
            box.delete(bx)
        array.clear(g.boxes)

// Debug tabloya bir "etiket | değer" satırı yazar.
f_drow(table t, int r, string lbl, string val, color bg) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_right)

// =============================================================================
// Evaluation Engine yardımcıları (saf; prediction algoritmasına dokunmaz)
// =============================================================================
f_scoreBucket(float s) => s < 5.0 ? 0 : s < 6.0 ? 1 : s < 7.0 ? 2 : 3
f_supBucket(int sup)   => sup <= 2 ? 0 : sup == 3 ? 1 : sup == 4 ? 2 : 3
f_pctS(int num, int den) => den > 0 ? str.tostring(100.0 * num / den, "#.#") + "%" : "—"
f_avgS(int sum, int den) => den > 0 ? str.tostring(sum / den, "#.#") : "—"

// Dashboard renk paleti (Light/Dark okunabilir, yüksek kontrast).
var color EV_TITLE  = color.rgb(35, 35, 35)
var color EV_LEFT   = color.rgb(55, 55, 55)
var color EV_RIGHT  = color.rgb(20, 20, 20)
var color EV_HIT    = color.rgb(0, 90, 0)
var color EV_FAIL   = color.rgb(120, 0, 0)
var color EV_EXP    = color.rgb(120, 70, 0)
var color EV_ACTIVE = color.rgb(0, 50, 120)
var color EV_SECT   = color.rgb(45, 45, 45)

// "etiket | değer" metrik satırı (kalan sütunlar valBg ile doldurulur, kompakt görünüm).
f_evMetric(table t, int r, string lbl, string val, color lblBg, color valBg) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = lblBg, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = valBg, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, "", bgcolor = valBg)
    table.cell(t, 3, r, "", bgcolor = valBg)
    table.cell(t, 4, r, "", bgcolor = valBg)
    table.cell(t, 5, r, "", bgcolor = valBg)

// Bölüm başlığı satırı (sarı yazı).
f_evSection(table t, int r, string title) =>
    for c = 0 to 5
        table.cell(t, c, r, c == 0 ? title : "", text_color = color.yellow, bgcolor = EV_SECT, text_size = size.small, text_halign = text.align_left)

// Analiz alt-tablosu başlık satırı.
f_evAnalyseHdr(table t, int r) =>
    table.cell(t, 0, r, "Group", text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, "N",     text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, "Hit",   text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3, r, "Fail",  text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, "Exp",   text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, "Hit%",  text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)

// Analiz alt-tablosu veri satırı.
f_evAnalyseRow(table t, int r, string lbl, int c, int h, int f, int e) =>
    table.cell(t, 0, r, lbl,               text_color = color.white, bgcolor = EV_LEFT,  text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, str.tostring(c),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, str.tostring(h),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3, r, str.tostring(f),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, str.tostring(e),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, f_pctS(h, h + f),  text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)

// =============================================================================
// PREDICTION ANALYTICS yardımcıları (pasif; prediction/evaluation'a dokunmaz)
// =============================================================================
// Bucket / bin fonksiyonları (saf).
f_scBin(float s) => s < 5.0 ? 0 : s < 5.5 ? 1 : s < 6.0 ? 2 : s < 6.5 ? 3 : s < 7.0 ? 4 : 5
f_spBin(int sup) => sup <= 2 ? 0 : sup == 3 ? 1 : sup == 4 ? 2 : 3
f_cwBin(float w) => na(w) ? 3 : w <= 0.25 ? 0 : w <= 0.50 ? 1 : w <= 1.00 ? 2 : 3
f_tdBin(float t) => na(t) ? 3 : t <= 1.0 ? 0 : t <= 2.0 ? 1 : t <= 4.0 ? 2 : 3
f_xaBin(float x) => na(x) ? 0 : x < 3.0 ? 0 : x < 6.0 ? 1 : x < 10.0 ? 2 : 3
f_bcBin(float r) => na(r) ? 0 : r < 0.382 ? 0 : r < 0.50 ? 1 : r < 0.618 ? 2 : r < 0.786 ? 3 : 4

// Bir üçlü (hit/fail/exp) sayaç dizisinde bucket b'yi rs sonucuna göre artırır.
f_bump3(array<int> h, array<int> f, array<int> e, int b, int rs) =>
    if rs == 1
        array.set(h, b, array.get(h, b) + 1)
    else if rs == 2
        array.set(f, b, array.get(f, b) + 1)
    else
        array.set(e, b, array.get(e, b) + 1)

// start bin'den sona kümülatif toplam (threshold tabloları için).
f_cumFrom(array<int> a, int start) =>
    int s = 0
    for i = start to array.size(a) - 1
        s += array.get(a, i)
    s

// Analytics renk paleti (task 14).
var color ANA_TITLE = color.rgb(25, 25, 25)
var color ANA_HDR   = color.rgb(50, 50, 50)
var color ANA_CELL  = color.rgb(20, 20, 20)
var color ANA_LEFT  = color.rgb(55, 55, 55)
var color ANA_LOWN  = color.rgb(90, 70, 0)   // koyu sarı/kahve
var color ANA_POS   = color.rgb(0, 90, 0)    // pozitif lift
var color ANA_NEG   = color.rgb(120, 0, 0)   // negatif lift

// Analytics sütun başlığı satırı (11 sütun).
f_anHeader(table t, int r) =>
    table.cell(t, 0,  r, "Group",   text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1,  r, "N",       text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2,  r, "Hit",     text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3,  r, "Fail",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4,  r, "Exp",     text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5,  r, "ResHit%", text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6,  r, "Ovr%",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7,  r, "Cov%",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8,  r, "Lift",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 9,  r, "AvgH",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 10, r, "AvgF",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)

// Analytics veri satırı. sumHit/sumFail < 0 => AvgH/AvgF sütunu boş. base100 na olabilir.
f_anRow(table t, int r, string lbl, int h, int f, int e, int totRes, float base100, int minN, int sumHit, int sumFail) =>
    int   n     = h + f + e
    bool  lowN  = n < minN
    color cb    = lowN ? ANA_LOWN : ANA_CELL
    int   resDen = h + f
    string resStr  = resDen > 0 ? str.tostring(100.0 * h / resDen, "#.#") + "%" + (lowN ? " LOW N" : "") : "—"
    string ovStr   = n > 0 ? str.tostring(100.0 * h / n, "#.#") + "%" : "—"
    string covStr  = totRes > 0 ? str.tostring(100.0 * n / totRes, "#.#") + "%" : "—"
    float  lift    = resDen > 0 ? (100.0 * h / resDen - base100) : na
    string liftStr = na(lift) ? "—" : (lift >= 0 ? "+" : "") + str.tostring(lift, "#.#") + " pp"
    color  liftBg  = lowN ? ANA_LOWN : na(lift) ? ANA_CELL : lift > 0 ? ANA_POS : lift < 0 ? ANA_NEG : ANA_CELL
    string ahStr   = sumHit  < 0 ? "" : (h > 0 ? str.tostring(sumHit  / h, "#.#") : "—")
    string afStr   = sumFail < 0 ? "" : (f > 0 ? str.tostring(sumFail / f, "#.#") : "—")
    color  ahBg    = sumHit  < 0 ? ANA_CELL : cb
    color  afBg    = sumFail < 0 ? ANA_CELL : cb
    table.cell(t, 0,  r, lbl,             text_color = color.white, bgcolor = ANA_LEFT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1,  r, str.tostring(n), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2,  r, str.tostring(h), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3,  r, str.tostring(f), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4,  r, str.tostring(e), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5,  r, resStr,          text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6,  r, ovStr,           text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7,  r, covStr,          text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8,  r, liftStr,         text_color = color.white, bgcolor = liftBg, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 9,  r, ahStr,           text_color = color.white, bgcolor = ahBg,   text_size = size.small, text_halign = text.align_right)
    table.cell(t, 10, r, afStr,           text_color = color.white, bgcolor = afBg,   text_size = size.small, text_halign = text.align_right)

// Analytics özet metrik satırı (label | value; kalan sütunlar doldurulur).
f_anMetric(table t, int r, string lbl, string val) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = ANA_LEFT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = ANA_CELL, text_size = size.small, text_halign = text.align_right)
    for c = 2 to 10
        table.cell(t, c, r, "", bgcolor = ANA_CELL)

// =============================================================================
// Motor örneği + confirmed pivot ring buffer (KORUNAN ALTYAPI, çizilmez)
// =============================================================================
var Engine        pivEng = f_engine_new()
var array<Pivot>  pivots = array.new<Pivot>()
BUFFER_MAX = 16

atr = ta.atr(atrLen)

var array<float> xaRatios = array.from(0.786, 0.886, 1.000, 1.130, 1.272, 1.618)
var array<float> bcRatios = array.from(1.272, 1.414, 1.618, 2.000, 2.240, 2.618, 3.140, 3.618)

// =============================================================================
// KAYITLAR + ÇİZİM DURUMU
// -----------------------------------------------------------------------------
// records : TÜM prediction snapshot'ları (asla silinmez).  drawn : şu an çizili
// olan kayıtlara referanslar (obje limiti / display moduna göre budanır).
// =============================================================================
var array<PredRec> records = array.new<PredRec>()
var array<PredRec> drawn   = array.new<PredRec>()
var int predSeq = 0

// Duplicate engelleme: en son üretilen X-A-B-C bar imzası.
var int lastX = na
var int lastA = na
var int lastB = na
var int lastC = na

// Debug sayaçları.
var int cntXabc     = 0   // geçerli (confirmed) XABC sayısı
var int cntClusters = 0   // geçerli Primary cluster sayısı
var int cntCreated  = 0   // gerçekten oluşturulan prediction sayısı
var int cntDup      = 0   // atlanan duplicate sayısı

// -----------------------------------------------------------------------------
// EVALUATION ENGINE durumu (incremental). activeList yalnızca ACTIVE kayıtları
// tutar; çözülen kayıt listeden çıkar ve sayaçlar bir kez güncellenir.
// -----------------------------------------------------------------------------
var array<PredRec> activeList = array.new<PredRec>()
var int evTotal   = 0
var int evHit     = 0
var int evFail    = 0
var int evExp     = 0
var int evSumHitBars  = 0
var int evSumFailBars = 0
var int evSumLifeBars = 0
var array<int> scCount = array.from(0, 0, 0, 0)
var array<int> scHit   = array.from(0, 0, 0, 0)
var array<int> scFail  = array.from(0, 0, 0, 0)
var array<int> scExp   = array.from(0, 0, 0, 0)
var array<int> spCount = array.from(0, 0, 0, 0)
var array<int> spHit   = array.from(0, 0, 0, 0)
var array<int> spFail  = array.from(0, 0, 0, 0)
var array<int> spExp   = array.from(0, 0, 0, 0)

// -----------------------------------------------------------------------------
// PREDICTION ANALYTICS sayaçları (incremental, çözüm anında O(1) güncellenir).
// Yalnızca çözülen kayıtları (HIT/FAILED/EXPIRED) sınıflandırır; pasif.
// -----------------------------------------------------------------------------
// Score fine-bins: 0:<5.0 1:[5,5.5) 2:[5.5,6) 3:[6,6.5) 4:[6.5,7) 5:>=7
var array<int> anSc_hit  = array.from(0, 0, 0, 0, 0, 0)
var array<int> anSc_fail = array.from(0, 0, 0, 0, 0, 0)
var array<int> anSc_exp  = array.from(0, 0, 0, 0, 0, 0)
// Support bins: 0:2 1:3 2:4 3:5+
var array<int> anSp_hit  = array.from(0, 0, 0, 0)
var array<int> anSp_fail = array.from(0, 0, 0, 0)
var array<int> anSp_exp  = array.from(0, 0, 0, 0)
// Direction: 0:bull 1:bear (+ bars toplamları)
var array<int> anDir_hit     = array.from(0, 0)
var array<int> anDir_fail    = array.from(0, 0)
var array<int> anDir_exp     = array.from(0, 0)
var array<int> anDir_hitBars = array.from(0, 0)
var array<int> anDir_failBars= array.from(0, 0)
// Cluster width bins: 0:<=0.25 1:(0.25,0.50] 2:(0.50,1.00] 3:>1.00
var array<int> anCw_hit  = array.from(0, 0, 0, 0)
var array<int> anCw_fail = array.from(0, 0, 0, 0)
var array<int> anCw_exp  = array.from(0, 0, 0, 0)
// Target distance (ATR) bins: 0:<=1 1:(1,2] 2:(2,4] 3:>4 (+ hit bars)
var array<int> anTd_hit     = array.from(0, 0, 0, 0)
var array<int> anTd_fail    = array.from(0, 0, 0, 0)
var array<int> anTd_exp     = array.from(0, 0, 0, 0)
var array<int> anTd_hitBars = array.from(0, 0, 0, 0)
// XA scale (ATR) bins: 0:<3 1:[3,6) 2:[6,10) 3:>=10
var array<int> anXa_hit  = array.from(0, 0, 0, 0)
var array<int> anXa_fail = array.from(0, 0, 0, 0)
var array<int> anXa_exp  = array.from(0, 0, 0, 0)
// BC/AB ratio bins: 0:<0.382 1:[0.382,0.50) 2:[0.50,0.618) 3:[0.618,0.786) 4:>=0.786
var array<int> anBc_hit  = array.from(0, 0, 0, 0, 0)
var array<int> anBc_fail = array.from(0, 0, 0, 0, 0)
var array<int> anBc_exp  = array.from(0, 0, 0, 0, 0)

// -----------------------------------------------------------------------------
// Görüntüleme penceresi: kaç prediction ÇİZİLİ tutulacak (kayıt sayısını etkilemez).
// Obje limitine (500) göre güvenli üst sınır hesaplanır.
// -----------------------------------------------------------------------------
int boxesPer  = 1 + (showSecond ? 1 : 0)
int labelsPer = showXABC ? 4 : 0
int capBox    = int(490 / boxesPer)
int capLbl    = labelsPer > 0 ? int(490 / labelsPer) : 1000000
int allCap    = math.min(capBox, capLbl)
int maxDrawn  = histDisplay == "Latest only" ? 1 : histDisplay == "Last N predictions" ? math.min(histCount, allCap) : allCap

// =============================================================================
// ANA AKIŞ — yalnızca KAPANMIŞ (confirmed) barlarda; ileri doğru, bar bar.
// =============================================================================
if barstate.isconfirmed
    // 0) Pivot motorunu ilerlet (repaint-safe).
    Pivot newPiv = f_engine_step(pivEng, pivK, pivMinBars, atr)
    if not na(newPiv)
        array.push(pivots, newPiv)
        if array.size(pivots) > BUFFER_MAX
            array.shift(pivots)

    // -------------------------------------------------------------------------
    // 0b) EVALUATION ENGINE — yalnızca ACTIVE prediction'ları bu barın high/low'u
    //     ile ileri doğru değerlendir. Oluşum barının kendi high/low'u kullanılmaz
    //     (creationBar < bar_index). Çözülen kayıt bir kez işlenir, listeden çıkar.
    // -------------------------------------------------------------------------
    int ai = 0
    while ai < array.size(activeList)
        PredRec p = array.get(activeList, ai)
        bool resolved = false
        if p.creationBar < bar_index
            bool bull     = p.direction == 1
            bool hitCond  = bull ? (high >= p.targetLow) : (low <= p.targetHigh)
            bool hasInval = not na(p.invalidationPrice)
            bool failCond = hasInval ? (bull ? (low <= p.invalidationPrice) : (high >= p.invalidationPrice)) : false

            int   rs     = 0
            float rprice = na
            if hitCond and failCond
                // Aynı mumda hem hedef hem invalidation: sıra bilinemez.
                if ambigMode == "Optimistic"
                    rs     := 1
                    rprice := bull ? p.targetLow : p.targetHigh
                else if ambigMode == "Ignore"
                    rs     := 0   // çözme; sonraki barda takip devam
                else
                    rs     := 2   // Conservative
                    rprice := p.invalidationPrice
            else if hitCond
                rs     := 1
                rprice := bull ? p.targetLow : p.targetHigh
            else if failCond
                rs     := 2
                rprice := p.invalidationPrice
            else if (bar_index - p.creationBar) >= maxActiveBars
                rs     := 3
                rprice := close

            if rs != 0
                // Snapshot'a çözüm yaz (bir daha değişmez).
                p.status      := rs
                p.resolvedBar := bar_index
                p.resultPrice := rprice
                p.barsAlive   := bar_index - p.creationBar

                int sb  = f_scoreBucket(p.score)
                int spb = f_supBucket(p.support)
                if rs == 1
                    evHit         += 1
                    evSumHitBars  += p.barsAlive
                    array.set(scHit, sb,  array.get(scHit, sb)  + 1)
                    array.set(spHit, spb, array.get(spHit, spb) + 1)
                else if rs == 2
                    evFail        += 1
                    evSumFailBars += p.barsAlive
                    array.set(scFail, sb,  array.get(scFail, sb)  + 1)
                    array.set(spFail, spb, array.get(spFail, spb) + 1)
                else
                    evExp         += 1
                    array.set(scExp, sb,  array.get(scExp, sb)  + 1)
                    array.set(spExp, spb, array.get(spExp, spb) + 1)
                evSumLifeBars += p.barsAlive

                // ---- ANALYTICS incremental güncelleme (pasif; yalnızca çözülen kayıt) ----
                f_bump3(anSc_hit, anSc_fail, anSc_exp, f_scBin(p.score), rs)
                f_bump3(anSp_hit, anSp_fail, anSp_exp, f_spBin(p.support), rs)
                int dbin = p.direction == 1 ? 0 : 1
                f_bump3(anDir_hit, anDir_fail, anDir_exp, dbin, rs)
                if rs == 1
                    array.set(anDir_hitBars, dbin, array.get(anDir_hitBars, dbin) + p.barsAlive)
                else if rs == 2
                    array.set(anDir_failBars, dbin, array.get(anDir_failBars, dbin) + p.barsAlive)
                f_bump3(anCw_hit, anCw_fail, anCw_exp, f_cwBin(p.normalizedClusterWidth), rs)
                int tbin = f_tdBin(p.targetDistanceATR)
                f_bump3(anTd_hit, anTd_fail, anTd_exp, tbin, rs)
                if rs == 1
                    array.set(anTd_hitBars, tbin, array.get(anTd_hitBars, tbin) + p.barsAlive)
                f_bump3(anXa_hit, anXa_fail, anXa_exp, f_xaBin(p.xaAtrMultiple), rs)
                f_bump3(anBc_hit, anBc_fail, anBc_exp, f_bcBin(p.bcAbRatio), rs)

                array.remove(activeList, ai)
                resolved := true
        if not resolved
            ai += 1

    // 1) Yeni confirmed pivot (yeni C): doğrula, projeksiyon, kümelendir, kaydet+çiz.
    if not na(newPiv) and array.size(pivots) >= 4
        int n = array.size(pivots)
        Pivot X = array.get(pivots, n - 4)
        Pivot A = array.get(pivots, n - 3)
        Pivot B = array.get(pivots, n - 2)
        Pivot C = array.get(pivots, n - 1)

        if f_xabc_valid(X, A, B, C)
            cntXabc += 1
            bool wantDown = X.kind == -1   // L-H-L-H -> D aşağı ; H-L-H-L -> D yukarı

            // 1a) Geçerli D seviyelerini (price, src, ratio) havuza topla (HAM ÇİZME).
            array<Proj> projs = array.new<Proj>()
            float xaDelta = A.price - X.price
            float bcDelta = C.price - B.price
            for i = 0 to array.size(xaRatios) - 1
                float r = array.get(xaRatios, i)
                float d = A.price - r * xaDelta
                if (wantDown ? d < C.price : d > C.price)
                    array.push(projs, Proj.new(d, 0, r))
            for i = 0 to array.size(bcRatios) - 1
                float r = array.get(bcRatios, i)
                float d = C.price - r * bcDelta
                if (wantDown ? d < C.price : d > C.price)
                    array.push(projs, Proj.new(d, 1, r))

            if array.size(projs) > 0
                // Adaptif tolerans: pattern boyutuna (XA) orantılı, ATR ve tick tabanı ile.
                // C onaylanınca bir kez hesaplanır (snapshot) — sonradan yeniden hesaplanmaz.
                float patternTolerance = math.abs(A.price - X.price) * (patternTolPct / 100.0)
                float atrFloor  = atr * atrFloorMult
                float tickFloor = syminfo.mintick * minTolTicks
                float tol = math.max(patternTolerance, math.max(atrFloor, tickFloor))
                array<bool> used = array.new<bool>(array.size(projs), false)

                // Primary = en yüksek skorlu küme (en az minSupport üye şart).
                [pIdx, pScore, pLo, pHi, pSupport] = f_best_cluster(projs, used, tol, minSupport)
                if pIdx >= 0
                    cntClusters += 1

                    // 1b) Duplicate engelle: aynı X-A-B-C bar imzası tekrar üretilmesin.
                    bool dup = not na(lastC) and X.bidx == lastX and A.bidx == lastA and B.bidx == lastB and C.bidx == lastC
                    if dup
                        cntDup += 1
                    else
                        lastX := X.bidx
                        lastA := A.bidx
                        lastB := B.bidx
                        lastC := C.bidx

                        float pCenter = array.get(projs, pIdx).price
                        int   dir     = wantDown ? -1 : 1

                        // 1c) Çizim: kutu, oluştuğu (confirmed C) bardan itibaren sağa.
                        //     Geçmişe gelecek bilgisi taşınmaz; kutu şimdi doğuyor.
                        PredGroup g = PredGroup.new(array.new<label>(), array.new<box>())
                        int x1 = bar_index
                        int x2 = bar_index + projLen
                        string pSrc = f_cluster_src_and_mark(projs, used, tol, pIdx)
                        array.push(g.boxes, f_target_box(x1, x2, pLo, pHi, pScore, "D Target", colPrimary, atr, pSrc))
                        if showXABC
                            array.push(g.labels, f_mark(X.bidx, X.price, "X"))
                            array.push(g.labels, f_mark(A.bidx, A.price, "A"))
                            array.push(g.labels, f_mark(B.bidx, B.price, "B"))
                            array.push(g.labels, f_mark(C.bidx, C.price, "C"))
                        if showSecond
                            [sIdx, sScore, sLo, sHi, sSupport] = f_best_cluster(projs, used, tol, minSupport)
                            if sIdx >= 0 and sScore > 0
                                string sSrc = f_cluster_src_and_mark(projs, used, tol, sIdx)
                                array.push(g.boxes, f_target_box(x1, x2, sLo, sHi, sScore, "Secondary", colSecond, atr, sSrc))

                        // 1d) Evaluation snapshot: invalidation seviyesi + ATR (oluşum anında sabitlenir).
                        float cATR = atr
                        float invalP = na
                        if failMode == "C ± ATR"
                            invalP := dir == 1 ? C.price - cATR * evalAtrMult : C.price + cATR * evalAtrMult
                        else if failMode == "X Pivot"
                            invalP := X.price
                        // "None" -> invalP = na (yalnız HIT/EXPIRED)

                        // 1e) Analytics snapshot — oluşum anında dondurulan pasif özellikler.
                        float anSpread   = pHi - pLo
                        float anNormW    = anSpread / math.max(tol, syminfo.mintick)
                        float anXaLen    = math.abs(X.price - A.price)
                        float anBcLen    = math.abs(B.price - C.price)
                        float anAbLen    = math.abs(B.price - A.price)
                        float anXaAtr    = cATR > 0 ? anXaLen / cATR : na
                        float anBcAtr    = cATR > 0 ? anBcLen / cATR : na
                        float anAbXa     = anXaLen > 0 ? anAbLen / anXaLen : na
                        float anBcAb     = anAbLen > 0 ? anBcLen / anAbLen : na
                        float anTDist    = math.abs(pCenter - close)
                        float anTDistAtr = cATR > 0 ? anTDist / cATR : na
                        float anTDistXa  = anXaLen > 0 ? anTDist / anXaLen : na

                        // 1f) Snapshot kaydı — asla silinmez/yeniden hesaplanmaz. status = ACTIVE.
                        PredRec rec = PredRec.new(id = predSeq + 1, creationBar = bar_index, pivotCBar = C.bidx,
                             direction = dir, targetLow = pLo, targetHigh = pHi, centerPrice = pCenter,
                             score = pScore, support = pSupport, viz = g,
                             status = 0, resolvedBar = na, resultPrice = na, barsAlive = na,
                             invalidationPrice = invalP, creationATR = cATR,
                             clusterSpread = anSpread, clusterTolerance = tol, normalizedClusterWidth = anNormW,
                             xaLength = anXaLen, bcLength = anBcLen, xaAtrMultiple = anXaAtr, bcAtrMultiple = anBcAtr,
                             abXaRatio = anAbXa, bcAbRatio = anBcAb, targetDistance = anTDist,
                             targetDistanceATR = anTDistAtr, targetDistanceXA = anTDistXa)
                        predSeq += 1
                        array.push(records, rec)
                        cntCreated += 1

                        // 1g) Evaluation kaydı: ACTIVE olarak izlemeye al + oluşum sayaçları.
                        array.push(activeList, rec)
                        evTotal += 1
                        int csb  = f_scoreBucket(pScore)
                        int cspb = f_supBucket(pSupport)
                        array.set(scCount, csb,  array.get(scCount, csb)  + 1)
                        array.set(spCount, cspb, array.get(spCount, cspb) + 1)

                        // 1e) Görüntüleme penceresini uygula: yalnızca ÇİZİMLERİ buda.
                        //     En eski çizim silinir; ilgili KAYIT records içinde kalır.
                        array.push(drawn, rec)
                        while array.size(drawn) > maxDrawn
                            PredRec old = array.shift(drawn)
                            f_group_delete(old.viz)

// =============================================================================
// DEBUG TABLO (yalnızca son barda güncellenir)
// =============================================================================
var table dbg = na
if showDebug and barstate.islast
    if na(dbg)
        dbg := table.new(position.bottom_right, 2, 6, border_width = 1, frame_width = 1, frame_color = color.gray)
    color hdr = color.new(color.blue, 20)
    color bg1 = color.new(color.gray, 90)
    color bg2 = color.new(color.gray, 80)
    table.cell(dbg, 0, 0, "Prediction Debug", text_color = color.white, bgcolor = hdr, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 0, "", bgcolor = hdr)
    f_drow(dbg, 1, "Total confirmed XABC",        str.tostring(cntXabc),           bg1)
    f_drow(dbg, 2, "Total valid clusters",        str.tostring(cntClusters),       bg2)
    f_drow(dbg, 3, "Total predictions created",   str.tostring(cntCreated),        bg1)
    f_drow(dbg, 4, "Predictions currently drawn", str.tostring(array.size(drawn)), bg2)
    f_drow(dbg, 5, "Duplicate predictions skipped", str.tostring(cntDup),          bg1)

// =============================================================================
// EVALUATION DASHBOARD (sağ üst; yalnızca son barda)
// =============================================================================
var table ev = na
if showEval and barstate.islast
    if na(ev)
        ev := table.new(position.top_right, 6, 23, border_width = 1, frame_width = 1, frame_color = color.rgb(70, 70, 70))

    int evActive = array.size(activeList)

    // Başlık
    table.cell(ev, 0, 0, "PREDICTION EVALUATION", text_color = color.white, bgcolor = EV_TITLE, text_size = size.normal, text_halign = text.align_left)
    table.cell(ev, 1, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 2, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 3, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 4, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 5, 0, "", bgcolor = EV_TITLE)

    // Özet metrikler
    f_evMetric(ev, 1,  "Total Predictions",      str.tostring(evTotal),                       EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 2,  "Active",                 str.tostring(evActive),                      EV_ACTIVE, EV_ACTIVE)
    f_evMetric(ev, 3,  "Hit",                    str.tostring(evHit),                         EV_HIT, EV_HIT)
    f_evMetric(ev, 4,  "Failed",                 str.tostring(evFail),                        EV_FAIL, EV_FAIL)
    f_evMetric(ev, 5,  "Expired",                str.tostring(evExp),                         EV_EXP, EV_EXP)
    f_evMetric(ev, 6,  "Hit Rate",               f_pctS(evHit, evHit + evFail),               EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 7,  "Overall Success",        f_pctS(evHit, evTotal),                      EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 8,  "Average Bars To Hit",    f_avgS(evSumHitBars, evHit),                 EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 9,  "Average Bars To Failure",f_avgS(evSumFailBars, evFail),               EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 10, "Average Lifetime",       f_avgS(evSumLifeBars, evHit + evFail + evExp), EV_LEFT, EV_RIGHT)

    // Score analysis
    f_evSection(ev, 11, "SCORE ANALYSIS")
    f_evAnalyseHdr(ev, 12)
    f_evAnalyseRow(ev, 13, "Score < 5",  array.get(scCount, 0), array.get(scHit, 0), array.get(scFail, 0), array.get(scExp, 0))
    f_evAnalyseRow(ev, 14, "5.0 - 5.99", array.get(scCount, 1), array.get(scHit, 1), array.get(scFail, 1), array.get(scExp, 1))
    f_evAnalyseRow(ev, 15, "6.0 - 6.99", array.get(scCount, 2), array.get(scHit, 2), array.get(scFail, 2), array.get(scExp, 2))
    f_evAnalyseRow(ev, 16, "Score >= 7", array.get(scCount, 3), array.get(scHit, 3), array.get(scFail, 3), array.get(scExp, 3))

    // Support analysis
    f_evSection(ev, 17, "SUPPORT ANALYSIS")
    f_evAnalyseHdr(ev, 18)
    f_evAnalyseRow(ev, 19, "Support 2",  array.get(spCount, 0), array.get(spHit, 0), array.get(spFail, 0), array.get(spExp, 0))
    f_evAnalyseRow(ev, 20, "Support 3",  array.get(spCount, 1), array.get(spHit, 1), array.get(spFail, 1), array.get(spExp, 1))
    f_evAnalyseRow(ev, 21, "Support 4",  array.get(spCount, 2), array.get(spHit, 2), array.get(spFail, 2), array.get(spExp, 2))
    f_evAnalyseRow(ev, 22, "Support 5+", array.get(spCount, 3), array.get(spHit, 3), array.get(spFail, 3), array.get(spExp, 3))

// =============================================================================
// PREDICTION ANALYTICS DASHBOARD (sol üst; yalnızca son barda; tek görünüm)
// =============================================================================
var table ana = na
if showAnalytics and barstate.islast
    if na(ana)
        ana := table.new(position.top_left, 11, 12, border_width = 1, frame_width = 1, frame_color = color.rgb(70, 70, 70))

    int   totRes  = evHit + evFail + evExp
    float base100 = (evHit + evFail) > 0 ? 100.0 * evHit / (evHit + evFail) : na
    string baseStr = na(base100) ? "—" : str.tostring(base100, "#.#") + "%"

    // Başlık + bilgi satırı
    table.cell(ana, 0, 0, "PREDICTION ANALYTICS · " + analyticsView, text_color = color.white, bgcolor = ANA_TITLE, text_size = size.normal, text_halign = text.align_left)
    for c = 1 to 10
        table.cell(ana, c, 0, "", bgcolor = ANA_TITLE)
    table.cell(ana, 0, 1, "Baseline " + baseStr + " · Resolved N " + str.tostring(totRes) + " · minN " + str.tostring(minReliableN), text_color = color.white, bgcolor = ANA_CELL, text_size = size.small, text_halign = text.align_left)
    for c = 1 to 10
        table.cell(ana, c, 1, "", bgcolor = ANA_CELL)

    if analyticsView == "Evaluation Summary"
        f_anMetric(ana, 2, "Total Predictions",  str.tostring(evTotal))
        f_anMetric(ana, 3, "Active",             str.tostring(array.size(activeList)))
        f_anMetric(ana, 4, "Hit",                str.tostring(evHit))
        f_anMetric(ana, 5, "Failed",             str.tostring(evFail))
        f_anMetric(ana, 6, "Expired",            str.tostring(evExp))
        f_anMetric(ana, 7, "Resolved Hit Rate",  f_pctS(evHit, evHit + evFail))
        f_anMetric(ana, 8, "Overall Success",    f_pctS(evHit, totRes))
    else
        f_anHeader(ana, 2)
        if analyticsView == "Score Thresholds"
            f_anRow(ana, 3, "Score >= 5.0", f_cumFrom(anSc_hit, 1), f_cumFrom(anSc_fail, 1), f_cumFrom(anSc_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "Score >= 5.5", f_cumFrom(anSc_hit, 2), f_cumFrom(anSc_fail, 2), f_cumFrom(anSc_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "Score >= 6.0", f_cumFrom(anSc_hit, 3), f_cumFrom(anSc_fail, 3), f_cumFrom(anSc_exp, 3), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "Score >= 6.5", f_cumFrom(anSc_hit, 4), f_cumFrom(anSc_fail, 4), f_cumFrom(anSc_exp, 4), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 7, "Score >= 7.0", f_cumFrom(anSc_hit, 5), f_cumFrom(anSc_fail, 5), f_cumFrom(anSc_exp, 5), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "Support Thresholds"
            f_anRow(ana, 3, "Support >= 2", f_cumFrom(anSp_hit, 0), f_cumFrom(anSp_fail, 0), f_cumFrom(anSp_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "Support >= 3", f_cumFrom(anSp_hit, 1), f_cumFrom(anSp_fail, 1), f_cumFrom(anSp_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "Support >= 4", f_cumFrom(anSp_hit, 2), f_cumFrom(anSp_fail, 2), f_cumFrom(anSp_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "Support >= 5", f_cumFrom(anSp_hit, 3), f_cumFrom(anSp_fail, 3), f_cumFrom(anSp_exp, 3), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "Direction"
            f_anRow(ana, 3, "Bullish", array.get(anDir_hit, 0), array.get(anDir_fail, 0), array.get(anDir_exp, 0), totRes, base100, minReliableN, array.get(anDir_hitBars, 0), array.get(anDir_failBars, 0))
            f_anRow(ana, 4, "Bearish", array.get(anDir_hit, 1), array.get(anDir_fail, 1), array.get(anDir_exp, 1), totRes, base100, minReliableN, array.get(anDir_hitBars, 1), array.get(anDir_failBars, 1))
        else if analyticsView == "Cluster Width"
            f_anRow(ana, 3, "W <= 0.25",   array.get(anCw_hit, 0), array.get(anCw_fail, 0), array.get(anCw_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "0.25 - 0.50", array.get(anCw_hit, 1), array.get(anCw_fail, 1), array.get(anCw_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "0.50 - 1.00", array.get(anCw_hit, 2), array.get(anCw_fail, 2), array.get(anCw_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "W > 1.00",    array.get(anCw_hit, 3), array.get(anCw_fail, 3), array.get(anCw_exp, 3), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "Target Distance"
            f_anRow(ana, 3, "<= 1 ATR",  array.get(anTd_hit, 0), array.get(anTd_fail, 0), array.get(anTd_exp, 0), totRes, base100, minReliableN, array.get(anTd_hitBars, 0), -1)
            f_anRow(ana, 4, "1 - 2 ATR", array.get(anTd_hit, 1), array.get(anTd_fail, 1), array.get(anTd_exp, 1), totRes, base100, minReliableN, array.get(anTd_hitBars, 1), -1)
            f_anRow(ana, 5, "2 - 4 ATR", array.get(anTd_hit, 2), array.get(anTd_fail, 2), array.get(anTd_exp, 2), totRes, base100, minReliableN, array.get(anTd_hitBars, 2), -1)
            f_anRow(ana, 6, "> 4 ATR",   array.get(anTd_hit, 3), array.get(anTd_fail, 3), array.get(anTd_exp, 3), totRes, base100, minReliableN, array.get(anTd_hitBars, 3), -1)
        else if analyticsView == "XA Scale"
            f_anRow(ana, 3, "< 3 ATR",    array.get(anXa_hit, 0), array.get(anXa_fail, 0), array.get(anXa_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "3 - 6 ATR",  array.get(anXa_hit, 1), array.get(anXa_fail, 1), array.get(anXa_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "6 - 10 ATR", array.get(anXa_hit, 2), array.get(anXa_fail, 2), array.get(anXa_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "> 10 ATR",   array.get(anXa_hit, 3), array.get(anXa_fail, 3), array.get(anXa_exp, 3), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "BC Ratio"
            f_anRow(ana, 3, "< 0.382",       array.get(anBc_hit, 0), array.get(anBc_fail, 0), array.get(anBc_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "0.382 - 0.50",  array.get(anBc_hit, 1), array.get(anBc_fail, 1), array.get(anBc_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "0.50 - 0.618",  array.get(anBc_hit, 2), array.get(anBc_fail, 2), array.get(anBc_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "0.618 - 0.786", array.get(anBc_hit, 3), array.get(anBc_fail, 3), array.get(anBc_exp, 3), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 7, "> 0.786",       array.get(anBc_hit, 4), array.get(anBc_fail, 4), array.get(anBc_exp, 4), totRes, base100, minReliableN, -1, -1)

// =============================================================================
// AÇIKLAMA
// -----------------------------------------------------------------------------
// ÜRETİM: her yeni confirmed pivot (yeni C) bar-close event'inde XABC doğrulanır,
//   XA/BC projeksiyonları hesaplanır, adaptif tolerans + minimum support ile
//   kümelenir; Primary D Target bulunursa bir SNAPSHOT kayıt (records) yazılır.
// KALICILIK: records asla silinmez/yeniden hesaplanmaz. Yeni prediction gelince
//   eski kayıt SİLİNMEZ; yalnızca display modu gerektirirse eski ÇİZİM budanır.
// GÖRÜNTÜLEME: Latest only (1) / All historical (obje limitli üst sınır) /
//   Last N predictions (histCount). Mod yalnızca ÇİZİMİ sınırlar; kayıtları,
//   üretimi veya ileride yapılacak accuracy ölçümünü ETKİLEMEZ.
// OBJE LİMİTİ: max_boxes_count/max_labels_count = 500. drawn kuyruğu maxDrawn'ı
//   aşınca en eski ÇİZİM nesneleri silinir (kayıt korunur).
// DUPLICATE: aynı X-A-B-C bar imzası tekrar üretilmez (atlananlar sayılır).
// REPAINT YOK: motor yalnızca barstate.isconfirmed'de ilerler; her kutu
//   oluştuğu (confirmed C) bardan itibaren, x1 = o anki bar_index ile çizilir;
//   geçmişe gelecek bilgisi taşınmaz; request.security/lookahead yok.
// =============================================================================
