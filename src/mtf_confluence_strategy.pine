//@version=6
// =============================================================================
// MTF Confluence System — ANA STRATEJİ DOSYASI (single-file architecture)
// -----------------------------------------------------------------------------
// Tüm modüller bu TEK strategy dosyasında fonksiyon olarak yaşar. Kod tekrarı
// yoktur; çekirdek başka dosyaya kopyalanmaz.
//
// Uygulanan modüller:
//   M1 · Pivot Engine (Confirmed ZigZag) — Main + Fast, iki bağımsız motor.
//   M2 · Market Structure — onaylı MAIN pivotlarından HH/HL/LH/LL + trend state.
//   M3 · XABCD Builder — ardışık 5 onaylı MAIN pivotundan X-A-B-C-D adayı (yapısal).
//   M2S· MTF Structure Summary — seçilebilir TF'lerde M1+M2 özeti (repaint-safe).
//
// Sıradaki modüller (henüz eklenmedi): M4 Harmonic, M5 MTF Confluence,
//   M6 HTF Veto, M7 Weighted Score, M8 Risk, M9 Signal/Backtest.
//
// KISITLAR:
//   - Yalnızca LONG (ileride). Şimdilik hiçbir entry/exit/alarm YOK.
//   - REPAINT YOK: tüm state yalnızca KAPANMIŞ barlarda (barstate.isconfirmed)
//     ilerler; pivotlar onay sonrası sabittir.
//   - Yasaklı gösterge / dış filtre YOK: yalnızca OHLC geometrisi + ATR.
//     EMA/RSI/MACD/hacim/momentum KULLANILMAZ.
// =============================================================================

strategy("MTF Confluence Strategy (M1+M2+M3+M2S)", overlay = true, pyramiding = 0, max_lines_count = 500, max_labels_count = 500)

// =============================================================================
// Tipler
// =============================================================================

// --- M1: Onaylanmış pivot kaydı. kind: +1 = HIGH (tepe), -1 = LOW (dip). ------
// bidx   : pivotun GERÇEKLEŞTİĞİ bar_index (geçmişte, sabit).
// confIdx: pivotun BİLİNDİĞİ/onaylandığı bar_index (bidx'ten büyük/eşit).
// theta  : onayı sağlayan, aday barında DONDURULMUŞ sapma eşiği (k*ATR).
// NOT: gelecekte strateji girişleri YALNIZCA confIdx barında veya SONRASINDA
// yapılabilir; asla bidx'te değil (aksi repaint olur).
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// --- M1: Motor durumu (state machine) ----------------------------------------
//   init  : ilk (ATR'li) bar görüldü mü?
//   booted: yön belirlendi mi? (bootstrap tamamlandı mı?)
//   dir   : +1 => TEPE arıyoruz, -1 => DİP arıyoruz.
//   cur*  : aranan yöndeki aday uç + curTheta (aday barında donmuş eşik)
//   opp*  : ters uç takipçisi (geri çekilme) + oppTheta
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// --- M2: Piyasa yapısı durumu — YALNIZCA onaylanmış MAIN pivotlarından --------
//   highClass: +1 = HH, -1 = LH, 0 = yok/EQH
//   lowClass : +1 = HL, -1 = LL, 0 = yok/EQL
//   trend    : +1 = UP, -1 = DOWN, 0 = RANGE
//   lastChangeConfIdx: trend'in en son DEĞİŞTİĞİ pivotun confIdx'i
type Structure
    bool  haveHigh
    bool  haveLow
    float lastHigh
    int   lastHighIdx
    float lastLow
    int   lastLowIdx
    int   highClass
    int   lowClass
    int   trend
    int   lastChangeConfIdx

// --- M3: XABCD adayı — ardışık 5 onaylı MAIN pivotundan (X,A,B,C,D) -----------
//   valid    : alternans + kronolojik sıra sağlanıyor mu? (geçerli 5-pivot dizisi)
//   isBullish: D bir DİP mi? (yükseliş tamamlanması D'de olur)
//   dir      : +1 = bullish (D dip), -1 = bearish (D tepe)
//   *Len     : leg fiyat büyüklüğü |Δprice|;  *Bars: leg bar açıklığı (Δbidx)
type Xabcd
    Pivot X
    Pivot A
    Pivot B
    Pivot C
    Pivot D
    bool  valid
    bool  isBullish
    int   dir
    float xaLen
    float abLen
    float bcLen
    float cdLen
    int   xaBars
    int   abBars
    int   bcBars
    int   cdBars

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Genel")

grpMain     = "MAIN motor (yapısal)"
mainK       = input.float(3.0, "MAIN sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = grpMain)
mainMinBars = input.int(8,     "MAIN minimum bar",         minval = 1, group = grpMain)

grpFast     = "FAST motor (taktik)"
fastK       = input.float(1.0, "FAST sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = grpFast)
fastMinBars = input.int(3,     "FAST minimum bar",         minval = 1, group = grpFast)

// --- Display: yalnızca GÖRSEL katmanı aç/kapar; hesaplama & state daima çalışır -
grpDisp          = "Display"
showMainZz       = input.bool(true,  "Show MAIN ZigZag",          group = grpDisp)
showFastZz       = input.bool(false, "Show FAST ZigZag / dots",   group = grpDisp)
showStructLabels = input.bool(true,  "Show Structure Labels",     group = grpDisp)
showXabcdLetters = input.bool(false, "Show XABCD Letters",        group = grpDisp)
showM12Table     = input.bool(false, "Show M1+M2 Detail Table",   group = grpDisp)
showM2sTable     = input.bool(true,  "Show M2S Summary Table",    group = grpDisp)
showM3Table      = input.bool(false, "Show M3 Detail Table",      group = grpDisp)
showConfMarkers  = input.bool(false, "Show Confirmation Markers", group = grpDisp)

// M2S · MTF Structure Summary — seçilebilir zaman dilimleri (varsayılan M1..D1).
grpMtf   = "M2S · MTF Structure Summary"
en1 = input.bool(true, "", inline = "mtf1", group = grpMtf)
tf1 = input.timeframe("1",   "TF 1", inline = "mtf1", group = grpMtf)
en2 = input.bool(true, "", inline = "mtf2", group = grpMtf)
tf2 = input.timeframe("5",   "TF 2", inline = "mtf2", group = grpMtf)
en3 = input.bool(true, "", inline = "mtf3", group = grpMtf)
tf3 = input.timeframe("15",  "TF 3", inline = "mtf3", group = grpMtf)
en4 = input.bool(true, "", inline = "mtf4", group = grpMtf)
tf4 = input.timeframe("60",  "TF 4", inline = "mtf4", group = grpMtf)
en5 = input.bool(true, "", inline = "mtf5", group = grpMtf)
tf5 = input.timeframe("240", "TF 5", inline = "mtf5", group = grpMtf)
en6 = input.bool(true, "", inline = "mtf6", group = grpMtf)
tf6 = input.timeframe("1D",  "TF 6", inline = "mtf6", group = grpMtf)

// =============================================================================
// M1 · Pivot Engine (KABUL EDİLMİŞ — davranış değişmedi)
// =============================================================================

// Yeni, sıfırlanmış bir motor üretir.
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

// Bir motoru tek bar ileri adımlar. Pivot ONAYLANDIYSA onu döndürür, yoksa na.
// State doğrudan `e` üzerinde mutasyona uğrar. Yalnızca KAPANMIŞ barlarda çağır.
//
// KONSERVATİF BAR-İÇİ KURAL: bir mumun içinde high/low sırası bilinmez. AYNI mumda
// hem yeni ekstrem hem ters sapma oluşursa, o ekstremi kullanan onay O BARDA
// VERİLMEZ (normal modda 'else' dalı; bootstrap'ta 'not newHigh'/'not newLow').
f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// M2 · Market Structure (yalnızca MAIN onaylı pivotlarından)
// =============================================================================

f_structure_new() =>
    Structure.new(haveHigh = false, haveLow = false,
         lastHigh = na, lastHighIdx = na, lastLow = na, lastLowIdx = na,
         highClass = 0, lowClass = 0, trend = 0, lastChangeConfIdx = na)

// Yeni bir onaylı MAIN pivotu yapıya işler ve o pivota bir etiket döndürür:
//   TEPE: "HH"/"LH"/"EQH"/"H1"      DİP: "HL"/"LL"/"EQL"/"L1"
// Trend her güncellemede highClass+lowClass bileşiminden türetilir. Trend
// DEĞİŞTİYSE, değişimi tetikleyen pivotun confIdx'i saklanır.
// (Bu fonksiyon yalnızca yeni MAIN pivot onaylandığında çağrılır -> trend
//  değişimi de yalnızca o anda oluşur.)
f_structure_update(Structure s, Pivot p) =>
    string tag = na

    if p.kind == 1
        if not s.haveHigh
            tag         := "H1"
            s.highClass := 0
        else if p.price > s.lastHigh
            tag         := "HH"
            s.highClass := 1
        else if p.price < s.lastHigh
            tag         := "LH"
            s.highClass := -1
        else
            tag         := "EQH"
            s.highClass := 0
        s.lastHigh    := p.price
        s.lastHighIdx := p.bidx
        s.haveHigh    := true
    else
        if not s.haveLow
            tag        := "L1"
            s.lowClass := 0
        else if p.price > s.lastLow
            tag        := "HL"
            s.lowClass := 1
        else if p.price < s.lastLow
            tag        := "LL"
            s.lowClass := -1
        else
            tag        := "EQL"
            s.lowClass := 0
        s.lastLow    := p.price
        s.lastLowIdx := p.bidx
        s.haveLow    := true

    // Trend: UP ancak HH+HL; DOWN ancak LH+LL; aksi RANGE.
    int  oldTrend = s.trend
    bool up       = s.highClass == 1  and s.lowClass == 1
    bool down     = s.highClass == -1 and s.lowClass == -1
    int  newTrend = up ? 1 : down ? -1 : 0
    if newTrend != oldTrend
        s.lastChangeConfIdx := p.confIdx
    s.trend := newTrend
    tag

// --- Görsel/tablo yardımcıları (algoritma dışı) ------------------------------
f_trend_str(int tr) =>
    tr == 1 ? "UP" : tr == -1 ? "DOWN" : "RANGE"

f_trend_color(int tr) =>
    tr == 1 ? color.new(color.green, 0) : tr == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)

f_tag_color(string tag) =>
    bool bull = tag == "HH" or tag == "HL"
    bool bear = tag == "LH" or tag == "LL"
    bull ? color.new(color.green, 45) : bear ? color.new(color.red, 45) : color.new(color.gray, 60)

f_engine_dir_str(Engine e) =>
    e.booted ? (e.dir == 1 ? "tepe arıyor" : "dip arıyor") : "bootstrap"

// =============================================================================
// M3 · XABCD Builder (yalnızca onaylanmış MAIN pivotlarından)
// -----------------------------------------------------------------------------
// Son 5 ardışık MAIN pivotunu X-A-B-C-D olarak alır (D = en yeni onaylı pivot).
// YALNIZCA yapısal bilgi üretir: pivot alternansı, kronolojik sıra, yön ve leg
// uzunlukları; ayrıca 5-pivot dizisinin geçerliliği. Harmonik desen adı, Fibonacci
// uygunluğu, entry/exit veya alarm YOKTUR (bunlar M4+ modüllerine aittir).
// =============================================================================
f_build_xabcd(array<Pivot> buf) =>
    Xabcd res = na
    int n = array.size(buf)
    if n >= 5
        Pivot X = array.get(buf, n - 5)
        Pivot A = array.get(buf, n - 4)
        Pivot B = array.get(buf, n - 3)
        Pivot C = array.get(buf, n - 2)
        Pivot D = array.get(buf, n - 1)
        // Alternans: ardışık pivot türleri farklı olmalı (H,L,H,L,H veya L,H,L,H,L).
        bool alt = X.kind != A.kind and A.kind != B.kind and B.kind != C.kind and C.kind != D.kind
        // Kronolojik sıra: bidx kesin artan olmalı.
        bool chrono = X.bidx < A.bidx and A.bidx < B.bidx and B.bidx < C.bidx and C.bidx < D.bidx
        bool ok   = alt and chrono
        bool bull = D.kind == -1     // D bir DİP ise bullish tamamlanma yönelimi
        res := Xabcd.new(X, A, B, C, D, ok, bull, bull ? 1 : -1,
             math.abs(A.price - X.price), math.abs(B.price - A.price),
             math.abs(C.price - B.price), math.abs(D.price - C.price),
             A.bidx - X.bidx, B.bidx - A.bidx, C.bidx - B.bidx, D.bidx - C.bidx)
    res

// =============================================================================
// M2S · MTF Structure Summary (çok-zaman-dilimli yapı özeti)
// -----------------------------------------------------------------------------
// Seçilebilir TF'lerde M1+M2'yi request.security ile çalıştırır ve tek özet
// tabloda toplar. REPAINT YOK ve REALTIME-GÜVENLİ:
//   - request.security tarafında  lookahead = barmerge.lookahead_off,
//   - motor YALNIZCA onaylanmış (kapanmış) HTF barında ilerler
//     (if barstate.isconfirmed) — forming (kapanmamış) HTF barı HİÇ işlenmez.
//     Bu, "[1] onaylı-bar" garantisidir: canlı barda motor çalışmaz, dönen değer
//     son KAPANMIŞ HTF barına aittir. (Önceki sürüm forming barı işliyordu; bu,
//     canlı barda runtime hatasına yol açıp tüm tabloların iptaline neden oluyordu.)
// Yalnızca özet/görsel üretir; entry/exit/alarm veya dış filtre YOK. M1/M2
// mantığı DEĞİŞMEDEN, aynı fonksiyonlarla her TF bağlamında çalışır.
// =============================================================================

// Yapı etiketini int'e kodla (request.security tuple'ında string taşımamak için).
f_tag_code(string tg) =>
    tg == "HH" ? 1 : tg == "HL" ? 2 : tg == "LH" ? 3 : tg == "LL" ? 4 : tg == "EQH" ? 5 : tg == "EQL" ? 6 : tg == "H1" ? 7 : tg == "L1" ? 8 : 0

f_tag_decode(int c) =>
    c == 1 ? "HH" : c == 2 ? "HL" : c == 3 ? "LH" : c == 4 ? "LL" : c == 5 ? "EQH" : c == 6 ? "EQL" : c == 7 ? "H1" : c == 8 ? "L1" : "-"

// request.security bağlamında (hedef TF) M1+M2'yi çalıştırır.
// DÖNÜŞ: [trend, sonEtiketKodu, sonPivotZamanı] — hepsi son KAPANMIŞ HTF barına
// ait. var state, security bağlamında TF başına ayrı yaşar.
f_tf_compute() =>
    var Engine    e           = f_engine_new()
    var Structure s           = f_structure_new()
    var int       lastTagCode = 0
    var int       lastPivotT  = na
    // Motor YALNIZCA kapanmış HTF barında ilerler -> forming bar işlenmez
    // (realtime runtime hatası engellenir; repaint yok).
    if barstate.isconfirmed
        float a  = ta.atr(atrLen)
        Pivot np = f_engine_step(e, mainK, mainMinBars, a)
        if not na(np)
            lastTagCode := f_tag_code(f_structure_update(s, np))
            lastPivotT  := np.ptime
    [s.trend, lastTagCode, lastPivotT]

// =============================================================================
// Örnekleme + ring buffer + akış
// =============================================================================
var Engine    mainEng = f_engine_new()
var Engine    fastEng = f_engine_new()
var Structure marketStruct = f_structure_new()

var array<Pivot> mainPivots = array.new<Pivot>()
var array<Pivot> fastPivots = array.new<Pivot>()

// M3 durumu: en son geçerli/aday XABCD + çizim tamponları.
var Xabcd        lastXabcd = na
var array<line>  xabLines  = array.new<line>()
var array<label> xabLabels = array.new<label>()

BUFFER_MAX = 32

f_push(array<Pivot> buf, Pivot p) =>
    array.push(buf, p)
    if array.size(buf) > BUFFER_MAX
        array.shift(buf)

atr = ta.atr(atrLen)

// REPAINT GÜVENLİĞİ: state yalnızca bar kapanınca ilerler.
Pivot  mainNew = na
Pivot  fastNew = na
string mainTag = na
Xabcd  xabNew  = na
if barstate.isconfirmed
    mainNew := f_engine_step(mainEng, mainK, mainMinBars, atr)
    fastNew := f_engine_step(fastEng, fastK, fastMinBars, atr)
    if not na(mainNew)
        f_push(mainPivots, mainNew)
        mainTag := f_structure_update(marketStruct, mainNew)   // M2: yalnızca MAIN
        xabNew  := f_build_xabcd(mainPivots)                    // M3: yalnızca MAIN, yeni D geldiğinde
        if not na(xabNew)
            lastXabcd := xabNew
    if not na(fastNew)
        f_push(fastPivots, fastNew)

// =============================================================================
// Görsel doğrulama
//   - MAIN zigzag + yapı etiketi (HH/HL/LH/LL) pivotun bidx barında.
//   - FAST zigzag (taktik, etiketsiz).
//   - Onay barında (confIdx) küçük daireler.
// =============================================================================
var Pivot mainLast = na
var Pivot fastLast = na

if not na(mainNew)
    if showMainZz and not na(mainLast)
        line.new(mainLast.bidx, mainLast.price, mainNew.bidx, mainNew.price,
             xloc = xloc.bar_index, color = color.new(color.gray, 45), width = 1, force_overlay = true)
    if showStructLabels
        label.new(mainNew.bidx, mainNew.price, mainTag,
             xloc = xloc.bar_index,
             yloc = mainNew.kind == 1 ? yloc.abovebar : yloc.belowbar,
             style = mainNew.kind == 1 ? label.style_label_down : label.style_label_up,
             color = f_tag_color(mainTag), textcolor = color.new(color.white, 10), size = size.tiny, force_overlay = true)
    mainLast := mainNew

if not na(fastNew)
    if showFastZz and not na(fastLast)
        line.new(fastLast.bidx, fastLast.price, fastNew.bidx, fastNew.price,
             xloc = xloc.bar_index, color = color.new(color.teal, 55),
             width = 1, style = line.style_dashed, force_overlay = true)
    fastLast := fastNew

// --- M3: XABCD adayının çizimi -----------------------------------------------
// Her yeni MAIN pivotunda (yeni D) önceki XABCD çizimi silinip yenisi çizilir;
// yalnızca geçerli (alternans + kronoloji) dizi çizilir. Mevcut zigzag ile
// karışmaması için noktalı mavi segmentler + X/A/B/C/D harf etiketleri kullanılır.
if not na(xabNew) and xabNew.valid and showXabcdLetters
    for ln in xabLines
        line.delete(ln)
    array.clear(xabLines)
    for lb in xabLabels
        label.delete(lb)
    array.clear(xabLabels)

    xcol = color.new(color.blue, 20)
    array.push(xabLines, line.new(xabNew.X.bidx, xabNew.X.price, xabNew.A.bidx, xabNew.A.price, xloc = xloc.bar_index, color = xcol, width = 1, style = line.style_dotted, force_overlay = true))
    array.push(xabLines, line.new(xabNew.A.bidx, xabNew.A.price, xabNew.B.bidx, xabNew.B.price, xloc = xloc.bar_index, color = xcol, width = 1, style = line.style_dotted, force_overlay = true))
    array.push(xabLines, line.new(xabNew.B.bidx, xabNew.B.price, xabNew.C.bidx, xabNew.C.price, xloc = xloc.bar_index, color = xcol, width = 1, style = line.style_dotted, force_overlay = true))
    array.push(xabLines, line.new(xabNew.C.bidx, xabNew.C.price, xabNew.D.bidx, xabNew.D.price, xloc = xloc.bar_index, color = xcol, width = 1, style = line.style_dotted, force_overlay = true))

    // Dikey offset: XABCD harflerini pivotun DIŞINA it (M2 yapı etiketiyle çakışmasın).
    lcol = color.new(color.blue, 10)
    off  = nz(atr, 0.0) * 1.2
    yX   = xabNew.X.price + (xabNew.X.kind == 1 ? off : -off)
    yA   = xabNew.A.price + (xabNew.A.kind == 1 ? off : -off)
    yB   = xabNew.B.price + (xabNew.B.kind == 1 ? off : -off)
    yC   = xabNew.C.price + (xabNew.C.kind == 1 ? off : -off)
    yD   = xabNew.D.price + (xabNew.D.kind == 1 ? off : -off)
    array.push(xabLabels, label.new(xabNew.X.bidx, yX, "X", xloc = xloc.bar_index, style = label.style_label_center, color = lcol, textcolor = color.white, size = size.tiny, force_overlay = true))
    array.push(xabLabels, label.new(xabNew.A.bidx, yA, "A", xloc = xloc.bar_index, style = label.style_label_center, color = lcol, textcolor = color.white, size = size.tiny, force_overlay = true))
    array.push(xabLabels, label.new(xabNew.B.bidx, yB, "B", xloc = xloc.bar_index, style = label.style_label_center, color = lcol, textcolor = color.white, size = size.tiny, force_overlay = true))
    array.push(xabLabels, label.new(xabNew.C.bidx, yC, "C", xloc = xloc.bar_index, style = label.style_label_center, color = lcol, textcolor = color.white, size = size.tiny, force_overlay = true))
    array.push(xabLabels, label.new(xabNew.D.bidx, yD, "D", xloc = xloc.bar_index, style = label.style_label_center, color = lcol, textcolor = color.white, size = size.tiny, force_overlay = true))

// Onay-barı işaretleri (strateji girişinin en erken yapılabileceği bar).
plotshape(showConfMarkers and not na(mainNew), title = "MAIN confirmed",
     style = shape.circle, location = location.belowbar,
     color = color.new(color.gray, 0), size = size.tiny, force_overlay = true)
plotshape(showConfMarkers and not na(fastNew), title = "FAST confirmed",
     style = shape.circle, location = location.abovebar,
     color = color.new(color.teal, 0), size = size.tiny, force_overlay = true)

// =============================================================================
// Birleşik denetim tablosu (M1 + M2)
//   Tablo NESNESİ global scope'ta KOŞULSUZ ve `var` ile bir kez oluşturulur;
//   böylece normal grafikte de her zaman görünür (barstate/Replay'e bağlı değil).
//   Yalnızca HÜCRE içerikleri `if barstate.islast` içinde güncellenir.
//   table.clear() kullanılmaz.
//   KONUM: top_LEFT — sağ üst artık M2S özet tablosuna ayrıldı (içerik/mantık aynı).
// =============================================================================
var table t = table.new(position.top_left, 2, 10, border_width = 1)

if barstate.islast and showM12Table
    booted  = mainEng.booted
    hiCls   = marketStruct.highClass == 1 ? "HH" : marketStruct.highClass == -1 ? "LH" : "EQH/-"
    loCls   = marketStruct.lowClass == 1 ? "HL" : marketStruct.lowClass == -1 ? "LL" : "EQL/-"
    hiStr   = marketStruct.haveHigh ? hiCls + " @ " + str.tostring(marketStruct.lastHigh, format.mintick) : "-"
    loStr   = marketStruct.haveLow  ? loCls + " @ " + str.tostring(marketStruct.lastLow, format.mintick) : "-"
    chgStr  = na(marketStruct.lastChangeConfIdx) ? "-" : str.tostring(marketStruct.lastChangeConfIdx)
    cntStr  = "M:" + str.tostring(array.size(mainPivots)) + " / F:" + str.tostring(array.size(fastPivots))
    dirStr  = f_engine_dir_str(mainEng) + " / " + f_engine_dir_str(fastEng)
    trTxt   = booted ? f_trend_str(marketStruct.trend) : "BOOTSTRAP"
    trBg    = booted ? f_trend_color(marketStruct.trend) : color.new(color.gray, 0)

    // MAIN son pivot ayrıntısı (M1 denetimi)
    hasM    = not na(mainLast)
    pivStr  = hasM ? (mainLast.kind == 1 ? "TEPE" : "DİP") + " bidx " + str.tostring(mainLast.bidx) + " -> conf " + str.tostring(mainLast.confIdx) + " (gec " + str.tostring(mainLast.confIdx - mainLast.bidx) + ")" : "-"
    thStr   = hasM ? str.tostring(mainLast.theta, format.mintick) : "-"

    table.cell(t, 0, 0, "MTF · M1+M2", bgcolor = color.gray, text_color = color.white)
    table.cell(t, 1, 0, "", bgcolor = color.gray)

    table.cell(t, 0, 1, "Trend state")
    table.cell(t, 1, 1, trTxt, bgcolor = trBg, text_color = color.white)

    table.cell(t, 0, 2, "Son yapı değişimi (confIdx)")
    table.cell(t, 1, 2, chgStr)

    table.cell(t, 0, 3, "Son TEPE")
    table.cell(t, 1, 3, hiStr)

    table.cell(t, 0, 4, "Son DİP")
    table.cell(t, 1, 4, loStr)

    table.cell(t, 0, 5, "highClass / lowClass")
    table.cell(t, 1, 5, str.tostring(marketStruct.highClass) + " / " + str.tostring(marketStruct.lowClass))

    table.cell(t, 0, 6, "Pivot sayısı (M/F)")
    table.cell(t, 1, 6, cntStr)

    table.cell(t, 0, 7, "Motor yön (M/F)")
    table.cell(t, 1, 7, dirStr)

    table.cell(t, 0, 8, "MAIN son pivot")
    table.cell(t, 1, 8, pivStr)

    table.cell(t, 0, 9, "MAIN theta (sabit)")
    table.cell(t, 1, 9, thStr)

// =============================================================================
// M3 denetim tablosu — AYRI tablo (mevcut M1+M2 tablosu DEĞİŞTİRİLMEDİ)
//   Aynı repaint-safe desen: nesne global scope'ta bir kez, hücreler son barda.
// =============================================================================
var table t3 = table.new(position.bottom_right, 2, 8, border_width = 1)

if barstate.islast and showM3Table
    hasX   = not na(lastXabcd)
    vldStr = hasX ? (lastXabcd.valid ? "EVET" : "HAYIR") : "-"
    dirX   = hasX ? (lastXabcd.isBullish ? "BULLISH (D=dip)" : "BEARISH (D=tepe)") : "-"
    kndStr = hasX ? (lastXabcd.X.kind == 1 ? "H" : "L") + (lastXabcd.A.kind == 1 ? "H" : "L") + (lastXabcd.B.kind == 1 ? "H" : "L") + (lastXabcd.C.kind == 1 ? "H" : "L") + (lastXabcd.D.kind == 1 ? "H" : "L") : "-"
    seqStr = hasX ? str.tostring(lastXabcd.X.bidx) + "," + str.tostring(lastXabcd.A.bidx) + "," + str.tostring(lastXabcd.B.bidx) + "," + str.tostring(lastXabcd.C.bidx) + "," + str.tostring(lastXabcd.D.bidx) : "-"
    lenStr = hasX ? str.tostring(lastXabcd.xaLen, format.mintick) + "/" + str.tostring(lastXabcd.abLen, format.mintick) + "/" + str.tostring(lastXabcd.bcLen, format.mintick) + "/" + str.tostring(lastXabcd.cdLen, format.mintick) : "-"
    barStr = hasX ? str.tostring(lastXabcd.xaBars) + "/" + str.tostring(lastXabcd.abBars) + "/" + str.tostring(lastXabcd.bcBars) + "/" + str.tostring(lastXabcd.cdBars) : "-"
    rdyStr = array.size(mainPivots) >= 5 ? "EVET (" + str.tostring(array.size(mainPivots)) + ")" : "HAYIR (" + str.tostring(array.size(mainPivots)) + ")"

    table.cell(t3, 0, 0, "M3 · XABCD", bgcolor = color.new(color.blue, 0), text_color = color.white)
    table.cell(t3, 1, 0, "", bgcolor = color.new(color.blue, 0))

    table.cell(t3, 0, 1, "5-pivot hazır")
    table.cell(t3, 1, 1, rdyStr)

    table.cell(t3, 0, 2, "Geçerli dizi")
    table.cell(t3, 1, 2, vldStr)

    table.cell(t3, 0, 3, "Yön")
    table.cell(t3, 1, 3, dirX)

    table.cell(t3, 0, 4, "Pivot türleri (X..D)")
    table.cell(t3, 1, 4, kndStr)

    table.cell(t3, 0, 5, "Pivot barları (bidx)")
    table.cell(t3, 1, 5, seqStr)

    table.cell(t3, 0, 6, "Leg uzunluk XA/AB/BC/CD")
    table.cell(t3, 1, 6, lenStr)

    table.cell(t3, 0, 7, "Leg bar XA/AB/BC/CD")
    table.cell(t3, 1, 7, barStr)

// =============================================================================
// M2S · MTF çağrıları — her TF için M1+M2 sonucu (repaint-safe + realtime-safe)
// -----------------------------------------------------------------------------
// KÖK NEDEN DÜZELTMESİ: request.security ile grafik TF'inden DÜŞÜK bir TF istemek,
// yüksek-TF grafiklerde (30m/1h/4h/1D) grafik barı başına çok sayıda intrabar
// üzerinden stateful motoru çalıştırır -> hesap limiti aşılır -> RUNTIME HATASI ->
// o barın TÜM çıktısı (tüm tablolar) iptal olur. Çözüm: grafik TF'inden DÜŞÜK olan
// TF'ler için security ÇAĞRILMAZ; o satır "LTF N/A" gösterilir (talep #7).
// request.security'nin repaint mekaniği (lookahead_off + onaylı-bar) AYNEN korunur;
// yalnızca düşük-TF çağrıları atlanır.
// =============================================================================
chSec  = timeframe.in_seconds()
tf1Low = timeframe.in_seconds(tf1) < chSec
tf2Low = timeframe.in_seconds(tf2) < chSec
tf3Low = timeframe.in_seconds(tf3) < chSec
tf4Low = timeframe.in_seconds(tf4) < chSec
tf5Low = timeframe.in_seconds(tf5) < chSec
tf6Low = timeframe.in_seconds(tf6) < chSec

// Düşük-TF'i grafik TF'ine SABİTLE: request hep >= grafik TF olur -> intrabar
// patlaması ve timeout yok. Bu satırların sonucu tabloda "LTF N/A" gösterilir,
// KULLANILMAZ. request.security global scope'ta, koşulsuz kalır (6 çağrı << 40).
et1 = tf1Low ? timeframe.period : tf1
et2 = tf2Low ? timeframe.period : tf2
et3 = tf3Low ? timeframe.period : tf3
et4 = tf4Low ? timeframe.period : tf4
et5 = tf5Low ? timeframe.period : tf5
et6 = tf6Low ? timeframe.period : tf6

[mTr1, mTg1, mPt1] = request.security(syminfo.tickerid, et1, f_tf_compute(), lookahead = barmerge.lookahead_off)
[mTr2, mTg2, mPt2] = request.security(syminfo.tickerid, et2, f_tf_compute(), lookahead = barmerge.lookahead_off)
[mTr3, mTg3, mPt3] = request.security(syminfo.tickerid, et3, f_tf_compute(), lookahead = barmerge.lookahead_off)
[mTr4, mTg4, mPt4] = request.security(syminfo.tickerid, et4, f_tf_compute(), lookahead = barmerge.lookahead_off)
[mTr5, mTg5, mPt5] = request.security(syminfo.tickerid, et5, f_tf_compute(), lookahead = barmerge.lookahead_off)
[mTr6, mTg6, mPt6] = request.security(syminfo.tickerid, et6, f_tf_compute(), lookahead = barmerge.lookahead_off)

// =============================================================================
// M2S · Kompakt özet tablosu (SAĞ ÜST) — sütunlar: TF | Trend | Structure
//   Ayrıntılı debug verileri (zaman, confIdx, theta, sayaç, motor yönü) BURADA
//   GÖSTERİLMEZ; onlar yalnızca M1+M2 / M3 detay tablolarında.
//   Repaint-safe desen: nesne global scope'ta bir kez, hücreler son barda.
// =============================================================================
var table tm = table.new(position.top_right, 3, 7, border_width = 1)

if barstate.islast and showM2sTable
    table.cell(tm, 0, 0, "TF",        bgcolor = color.new(color.blue, 0), text_color = color.white)
    table.cell(tm, 1, 0, "Trend",     bgcolor = color.new(color.blue, 0), text_color = color.white)
    table.cell(tm, 2, 0, "Structure", bgcolor = color.new(color.blue, 0), text_color = color.white)

    tfs  = array.from(tf1, tf2, tf3, tf4, tf5, tf6)
    ens  = array.from(en1, en2, en3, en4, en5, en6)
    lows = array.from(tf1Low, tf2Low, tf3Low, tf4Low, tf5Low, tf6Low)
    trs  = array.from(mTr1, mTr2, mTr3, mTr4, mTr5, mTr6)
    tgs  = array.from(mTg1, mTg2, mTg3, mTg4, mTg5, mTg6)

    for i = 0 to 5
        r     = i + 1
        tfLbl = array.get(tfs, i)
        if not array.get(ens, i)
            table.cell(tm, 0, r, tfLbl,   text_color = color.gray)
            table.cell(tm, 1, r, "off",   text_color = color.gray)
            table.cell(tm, 2, r, "-",     text_color = color.gray)
        else if array.get(lows, i)
            table.cell(tm, 0, r, tfLbl,     text_color = color.gray)
            table.cell(tm, 1, r, "LTF N/A", text_color = color.gray)
            table.cell(tm, 2, r, "-",       text_color = color.gray)
        else
            trv = array.get(trs, i)
            tgv = array.get(tgs, i)
            trTxt = na(trv) ? "N/A" : f_trend_str(trv)
            trBg  = na(trv) ? color.new(color.gray, 0) : f_trend_color(trv)
            table.cell(tm, 0, r, tfLbl)
            table.cell(tm, 1, r, trTxt, bgcolor = trBg, text_color = color.white)
            table.cell(tm, 2, r, na(tgv) ? "N/A" : f_tag_decode(tgv))
