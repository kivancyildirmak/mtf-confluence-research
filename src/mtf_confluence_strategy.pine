//@version=6
// =============================================================================
// HARMONIC PREDICTION ENGINE — Cluster/Confluence Engine ile "Most Probable D Target"
// -----------------------------------------------------------------------------
// Mimari korunur: repaint-safe pivot motoru, confirmed pivot mantığı, Historical
// Predictions, XABC doğrulaması ve projection hesapları AYNEN. Ham Fibonacci
// projection'ları KULLANICIYA ÇİZİLMEZ. Bunun yerine tüm XA/BC seviyeleri içeride
// hesaplanır, fiyat yakınlığına göre KÜMELENİR, ağırlıklı skorlanır ve en olası D
// bölgesi TEK KUTU (Primary; opsiyonel Secondary) olarak gösterilir.
//
// ÖNEMLİ: Bu hedef bir TRADE SİNYALİ DEĞİLDİR; yalnızca D'nin oluşmasının en olası
//   fiyat bölgesidir. Fiyat bölgeyi geçebilir/trend sürebilir — bu başarısızlık
//   değildir. Entry/exit/stop/TP/strategy bu modülün DIŞINDADIR.
//
// GRAFİKTE YALNIZCA: X/A/B/C harfleri + Primary (ve istenirse Secondary) D Target
//   kutusu. Ham çizgi, tablo, trend, HH/HL, zigzag, debug, pattern adı YOK.
//   request.security / lookahead YOK.
// =============================================================================

indicator("Harmonic Prediction Engine", overlay = true, max_labels_count = 200, max_boxes_count = 100)

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Pivot Engine")
pivK        = input.float(3.0, "Pivot sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = "Pivot Engine")
pivMinBars  = input.int(8,     "Pivot minimum bar",         minval = 1, group = "Pivot Engine")

grpPred     = "Prediction / Cluster"
projLen     = input.int(50, "Kutu uzunluğu (bar)",        minval = 5, group = grpPred)
histMode    = input.string("Latest only", "Historical predictions", options = ["Latest only", "Keep last 5", "Keep last 10"], group = grpPred)
clusterTol  = input.float(0.5, "Küme toleransı (× ATR)",  minval = 0.05, step = 0.05, group = grpPred)
showSecond  = input.bool(false, "Secondary D Target göster", group = grpPred)
showSources = input.bool(false, "Kutuda kaynakları göster (XA/BC ratio)", group = grpPred)
colPrimary  = input.color(color.new(color.lime,   0), "Primary kutu rengi",   group = grpPred)
colSecond   = input.color(color.new(color.orange, 0), "Secondary kutu rengi", group = grpPred)

grpFilt     = "XABC Geçerlilik Filtreleri"
abXaMin     = input.float(0.25, "AB/XA min", step = 0.01, group = grpFilt)
abXaMax     = input.float(0.90, "AB/XA max", step = 0.01, group = grpFilt)
bcAbMin     = input.float(0.30, "BC/AB min", step = 0.01, group = grpFilt)
bcAbMax     = input.float(2.00, "BC/AB max", step = 0.01, group = grpFilt)

keepCount = histMode == "Keep last 5" ? 5 : histMode == "Keep last 10" ? 10 : 1

// =============================================================================
// Veri yapıları (KORUNAN ALTYAPI)
// =============================================================================
// Onaylanmış pivot. kind: +1 = HIGH (tepe), -1 = LOW (dip).
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Pivot motoru durumu (state machine).
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// Tek bir ham projeksiyon seviyesi. src: 0 = XA, 1 = BC.
type Proj
    float price
    int   src
    float ratio

// Bir prediction grubunun çizim nesneleri (grup bazlı silme için).
type PredGroup
    array<label> labels
    array<box>   boxes

// =============================================================================
// Repaint-safe pivot motoru (KORUNAN ALTYAPI — davranış değişmedi)
// -----------------------------------------------------------------------------
// "Dual-Tracker Confirmed Deviation ZigZag": bir uç, fiyat ondan (dondurulmuş)
// theta = k*ATR kadar TERS çekildiğinde VE en az minBars kapanmış bar geçince
// KESİNLEŞİR. Konservatif bar-içi kural: aynı mumda hem yeni ekstrem hem ters
// sapma oluşursa o barda onay verilmez. Yalnızca KAPANMIŞ barlarda çağrılır.
// =============================================================================
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// Prediction / Cluster yardımcıları
// =============================================================================

// XABC geçerlilik kontrolü (oranlar GRAFİKTE gösterilmez; yalnızca filtre).
f_xabc_valid(Pivot X, Pivot A, Pivot B, Pivot C) =>
    bool chrono = X.bidx < A.bidx and A.bidx < B.bidx and B.bidx < C.bidx
    bool alt    = X.kind != A.kind and A.kind != B.kind and B.kind != C.kind
    bool form   = (X.kind == -1 and A.kind == 1 and B.kind == -1 and C.kind == 1) or (X.kind == 1 and A.kind == -1 and B.kind == 1 and C.kind == -1)
    float xa = math.abs(A.price - X.price)
    float ab = math.abs(B.price - A.price)
    float bc = math.abs(C.price - B.price)
    bool legs = xa > 0 and ab > 0 and bc > 0
    bool ratios = false
    if legs
        float abXa = ab / xa
        float bcAb = bc / ab
        ratios := abXa >= abXaMin and abXa <= abXaMax and bcAb >= bcAbMin and bcAb <= bcAbMax
    chrono and alt and form and legs and ratios

// En YÜKSEK SKORLU kümeyi bulur (used=true olanlar hariç). Skor = ağırlıklı:
//   + farklı ratio sayısı (aynı ratio tekrarına ekstra yok)
//   + XA ve BC birlikte varsa mix bonusu (+2)  (yalnız-BC / yalnız-XA daha düşük)
//   + sıkılık bonusu: 2*(1 - spread/tol)  (üyeler ne kadar yakınsa o kadar yüksek)
// DÖNÜŞ: [merkezIndex, skor, altFiyat, üstFiyat].
f_best_cluster(array<Proj> projs, array<bool> used, float tol) =>
    int   nD = array.size(projs)
    int   bestIdx = -1
    float bestScore = -1.0
    float bestLo = na
    float bestHi = na
    for i = 0 to nD - 1
        if not array.get(used, i)
            float center = array.get(projs, i).price
            float lo = na
            float hi = na
            bool  hasXA = false
            bool  hasBC = false
            int   distinct = 0
            for j = 0 to nD - 1
                if not array.get(used, j)
                    Proj pj = array.get(projs, j)
                    if math.abs(pj.price - center) <= tol
                        lo := na(lo) ? pj.price : math.min(lo, pj.price)
                        hi := na(hi) ? pj.price : math.max(hi, pj.price)
                        if pj.src == 0
                            hasXA := true
                        else
                            hasBC := true
                        bool firstOfRatio = true
                        for k = 0 to j - 1
                            if not array.get(used, k)
                                Proj pk = array.get(projs, k)
                                if math.abs(pk.price - center) <= tol and pk.ratio == pj.ratio
                                    firstOfRatio := false
                                    break
                        if firstOfRatio
                            distinct += 1
            float spread = na(hi) ? 0.0 : hi - lo
            float tight  = tol > 0 ? math.max(0.0, 1.0 - spread / tol) : 0.0
            float score  = distinct + (hasXA and hasBC ? 2.0 : 0.0) + 2.0 * tight
            if score > bestScore
                bestIdx   := i
                bestScore := score
                bestLo    := lo
                bestHi    := hi
    [bestIdx, bestScore, bestLo, bestHi]

// Merkez etrafındaki (tol içi, used olmayan) üyeleri işaretler ve kaynak metnini
// ("XA 0.886, BC 2.240") döndürür. Skorlama sonrası kutu metni + used için tek geçiş.
f_cluster_src_and_mark(array<Proj> projs, array<bool> used, float tol, int centerIdx) =>
    float center = array.get(projs, centerIdx).price
    string s = ""
    for j = 0 to array.size(projs) - 1
        if not array.get(used, j)
            Proj pj = array.get(projs, j)
            if math.abs(pj.price - center) <= tol
                s := s + (s == "" ? "" : ", ") + (pj.src == 0 ? "XA " : "BC ") + str.tostring(pj.ratio, "#.###")
                array.set(used, j, true)
    s

// Bir pivotu harf etiketiyle işaretler ve label'ı döndürür.
f_mark(int bidx, float price, string txt) =>
    label.new(bidx, price, txt, xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 25), textcolor = color.white, size = size.small,
         force_overlay = true)

// D-target kümesini kutu olarak çizer (C barından sağa) ve gruba ekler.
f_target_box(PredGroup g, int x1, int x2, float lo, float hi, float score, string title, color col, float atrv, string srcText) =>
    float pad = (hi - lo) < atrv * 0.05 ? atrv * 0.20 : 0.0
    string txt = title + "\n" + str.tostring(lo, format.mintick) + " – " + str.tostring(hi, format.mintick) + "\nScore " + str.tostring(score, "#.#")
    if showSources and str.length(srcText) > 0
        txt := txt + "\n" + srcText
    box b = box.new(x1, hi + pad, x2, lo - pad, border_color = col, bgcolor = color.new(col, 82),
         text = txt, text_color = col, text_size = size.small,
         text_halign = text.align_left, text_valign = text.align_center, force_overlay = true)
    array.push(g.boxes, b)

// Bir prediction grubunun tüm nesnelerini güvenle siler.
f_group_delete(PredGroup g) =>
    if array.size(g.labels) > 0
        for lb in g.labels
            label.delete(lb)
        array.clear(g.labels)
    if array.size(g.boxes) > 0
        for bx in g.boxes
            box.delete(bx)
        array.clear(g.boxes)

// =============================================================================
// Motor örneği + confirmed pivot ring buffer (KORUNAN ALTYAPI, çizilmez)
// =============================================================================
var Engine        pivEng = f_engine_new()
var array<Pivot>  pivots = array.new<Pivot>()
BUFFER_MAX = 16

atr = ta.atr(atrLen)

// REPAINT GÜVENLİĞİ: motor yalnızca KAPANMIŞ barda ilerler.
Pivot newPiv = na
if barstate.isconfirmed
    newPiv := f_engine_step(pivEng, pivK, pivMinBars, atr)
    if not na(newPiv)
        array.push(pivots, newPiv)
        if array.size(pivots) > BUFFER_MAX
            array.shift(pivots)

// =============================================================================
// PREDICTION + CLUSTER ENGINE
// -----------------------------------------------------------------------------
// XA projection: D = A - r*(A-X)   |   BC projection: D = C - r*(C-B)
// Yön filtresi: L-H-L-H (X dip) yalnızca D<C ; H-L-H-L (X tepe) yalnızca D>C.
// Geçerli D'ler (price, src, ratio) havuza toplanır; HAM ÇİZİLMEZ. Fiyat
// yakınlığına göre kümelenir, ağırlıklı skorlanır; en yüksek skor Primary,
// ikinci Secondary (opsiyonel). Kutu = küme aralığı + skor.
// =============================================================================
var array<float> xaRatios = array.from(0.786, 0.886, 1.000, 1.130, 1.272, 1.618)
var array<float> bcRatios = array.from(1.272, 1.414, 1.618, 2.000, 2.240, 2.618, 3.140, 3.618)

// Aktif prediction grupları (en yeni sonda). Grup bazlı saklanır/silinir.
var array<PredGroup> groups = array.new<PredGroup>()

// Yeni confirmed pivot (yeni C) geldiğinde: doğrula, hesapla, kümelendir, çiz (bir kez).
if not na(newPiv) and array.size(pivots) >= 4
    int n = array.size(pivots)
    Pivot X = array.get(pivots, n - 4)
    Pivot A = array.get(pivots, n - 3)
    Pivot B = array.get(pivots, n - 2)
    Pivot C = array.get(pivots, n - 1)

    if f_xabc_valid(X, A, B, C)
        bool wantDown = X.kind == -1   // L-H-L-H -> D aşağı ; H-L-H-L -> D yukarı

        // 1) Geçerli D seviyelerini (price, src, ratio) havuza topla (HAM ÇİZME).
        array<Proj> projs = array.new<Proj>()
        float xaDelta = A.price - X.price
        float bcDelta = C.price - B.price
        for i = 0 to array.size(xaRatios) - 1
            float r = array.get(xaRatios, i)
            float d = A.price - r * xaDelta
            if (wantDown ? d < C.price : d > C.price)
                array.push(projs, Proj.new(d, 0, r))
        for i = 0 to array.size(bcRatios) - 1
            float r = array.get(bcRatios, i)
            float d = C.price - r * bcDelta
            if (wantDown ? d < C.price : d > C.price)
                array.push(projs, Proj.new(d, 1, r))

        if array.size(projs) > 0
            float tol = clusterTol * atr
            array<bool> used = array.new<bool>(array.size(projs), false)

            // 2) Primary = en yüksek skorlu küme.
            [pIdx, pScore, pLo, pHi] = f_best_cluster(projs, used, tol)
            if pIdx >= 0
                PredGroup g = PredGroup.new(array.new<label>(), array.new<box>())
                int x1 = C.bidx
                int x2 = C.bidx + projLen

                array.push(g.labels, f_mark(X.bidx, X.price, "X"))
                array.push(g.labels, f_mark(A.bidx, A.price, "A"))
                array.push(g.labels, f_mark(B.bidx, B.price, "B"))
                array.push(g.labels, f_mark(C.bidx, C.price, "C"))

                string pSrc = f_cluster_src_and_mark(projs, used, tol, pIdx)
                f_target_box(g, x1, x2, pLo, pHi, pScore, "Primary D Target", colPrimary, atr, pSrc)

                // 3) Secondary = kalanların en yüksek skorlusu (opsiyonel).
                if showSecond
                    [sIdx, sScore, sLo, sHi] = f_best_cluster(projs, used, tol)
                    if sIdx >= 0 and sScore > 0
                        string sSrc = f_cluster_src_and_mark(projs, used, tol, sIdx)
                        f_target_box(g, x1, x2, sLo, sHi, sScore, "Secondary D Target", colSecond, atr, sSrc)

                // 4) Grubu ekle; historical moda göre eski grupları sil.
                array.push(groups, g)
                while array.size(groups) > keepCount
                    PredGroup old = array.shift(groups)
                    f_group_delete(old)

// =============================================================================
// AÇIKLAMA
// -----------------------------------------------------------------------------
// XABC doğrulaması: kronoloji + alternasyon + tam L-H-L-H/H-L-H-L + leg>0 + AB/XA
//   & BC/AB oran sınırları. Geçersizse hiçbir hedef çizilmez.
// Üretim anı: yalnızca yeni confirmed pivot (yeni C) bar-close event'inde, bir kez.
// Formüller: D_XA = A - r*(A-X) ; D_BC = C - r*(C-B). Yön filtresinden geçer.
// Cluster skor (f_best_cluster): farklı ratio sayısı + (XA&BC mix bonusu +2) +
//   2*(1 - spread/tol) sıkılık. Aynı ratio tekrarı ekstra puan almaz; yalnız-BC/
//   yalnız-XA küme mix bonusu alamaz. En yüksek skor Primary, ikinci Secondary.
// Neden repaint yok: motor yalnızca barstate.isconfirmed içinde ilerler; C onaylanınca
//   X/A/B/C ve küme sınırları/skoru sabit; request.security/lookahead yok; historical
//   gruplar bir daha hesaplanmaz, yalnızca (pruning'de) silinir.
// Bu hedef bir TRADE sinyali DEĞİLDİR; yalnızca D'nin en olası tamamlanma bölgesidir.
// =============================================================================
