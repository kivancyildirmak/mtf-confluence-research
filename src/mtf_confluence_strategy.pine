//@version=6
// =============================================================================
// HARMONIC PREDICTION ENGINE — D noktası oluşmadan olası D seviyelerini projekte eder
// -----------------------------------------------------------------------------
// Bu sürüm ARTIK bir harmonic pattern GÖSTERİCİSİ değildir. Tek amacı:
//   Son 4 confirmed pivot (X, A, B, C) oluştuğunda, HENÜZ D OLUŞMADAN, olası D
//   fiyatlarını Fibonacci oranlarıyla GELECEĞE projekte etmek.
//
// GRAFİKTE YALNIZCA: X, A, B, C harfleri + geleceğe uzanan D projeksiyon çizgileri.
//   Tablo YOK · debug YOK · trend YOK · HH/HL/LH/LL YOK · zigzag YOK · pattern adı YOK.
//
// KORUNAN ALTYAPI (yalnızca prediction'ı besler; ÇİZİLMEZ):
//   - Repaint-safe "Dual-Tracker Confirmed Deviation ZigZag" pivot motoru.
//   - Confirmed pivot mantığı + Pivot veri yapısı + ring buffer.
//   (M2 yapı / M3 XABCD / M2S MTF katmanları bu sürümde ÇAĞRILMAZ; git geçmişinde
//    korunur. Prediction chart-TF pivotlarını kullanır; MTF filtreleme ileride.)
//
// REPAINT YOK: pivotlar yalnızca KAPANMIŞ barlarda onaylanır; prediction yalnızca
//   yeni confirmed pivot (C) anında BİR KEZ hesaplanır ve sonra DEĞİŞMEZ. Lookahead
//   kullanılmaz. Eklenmez: harmonic isimleri, PRZ, confidence, strategy, entry/exit,
//   alarm, backtest.
// =============================================================================

indicator("Harmonic Prediction Engine", overlay = true, max_lines_count = 100, max_labels_count = 100)

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Pivot Engine")
pivK        = input.float(3.0, "Pivot sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = "Pivot Engine")
pivMinBars  = input.int(8,     "Pivot minimum bar",         minval = 1, group = "Pivot Engine")

projLen     = input.int(60, "Projeksiyon uzunluğu (bar)", minval = 5, group = "Prediction")
colXA       = input.color(color.new(color.aqua,   0), "XA retracement rengi", group = "Prediction")
colBC       = input.color(color.new(color.orange, 0), "BC extension rengi",   group = "Prediction")

// =============================================================================
// Veri yapıları (KORUNAN ALTYAPI)
// =============================================================================
// Onaylanmış pivot. kind: +1 = HIGH (tepe), -1 = LOW (dip).
// bidx: pivotun gerçekleştiği bar_index (sabit). confIdx: onaylandığı bar_index.
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Pivot motoru durumu (state machine). Bkz. f_engine_step yorumu.
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// =============================================================================
// Repaint-safe pivot motoru (KORUNAN ALTYAPI — davranış değişmedi)
// -----------------------------------------------------------------------------
// "Dual-Tracker Confirmed Deviation ZigZag": bir uç, fiyat ondan (dondurulmuş)
// theta = k*ATR kadar TERS çekildiğinde VE en az minBars kapanmış bar geçince
// KESİNLEŞİR. Konservatif bar-içi kural: aynı mumda hem yeni ekstrem hem ters
// sapma oluşursa o barda onay verilmez. Yalnızca KAPANMIŞ barlarda çağrılır.
// =============================================================================
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// Motor örneği + confirmed pivot ring buffer (KORUNAN ALTYAPI, çizilmez)
// =============================================================================
var Engine        pivEng = f_engine_new()
var array<Pivot>  pivots = array.new<Pivot>()
BUFFER_MAX = 16

atr = ta.atr(atrLen)

// REPAINT GÜVENLİĞİ: motor yalnızca KAPANMIŞ barda ilerler.
Pivot newPiv = na
if barstate.isconfirmed
    newPiv := f_engine_step(pivEng, pivK, pivMinBars, atr)
    if not na(newPiv)
        array.push(pivots, newPiv)
        if array.size(pivots) > BUFFER_MAX
            array.shift(pivots)

// =============================================================================
// PREDICTION ENGINE — olası D seviyelerini projekte et
// -----------------------------------------------------------------------------
// Fibonacci oranları:
//   XA retracement: A - r*(A-X)   |   BC extension: C - r*(C-B)
// (Her iki formül de D'yi doğru yönde üretir; pivotlar zaten alternatiftir.)
// Prediction yalnızca YENİ confirmed pivot (yeni C) anında BİR KEZ hesaplanır;
// eski çizimler silinir, sadece en son aktif prediction gösterilir. Repaint yok.
// =============================================================================
var array<float> xaRatios = array.from(0.786, 0.886, 1.000, 1.130, 1.272, 1.618)
var array<float> bcRatios = array.from(1.272, 1.414, 1.618, 2.000, 2.240, 2.618, 3.140, 3.618)

var array<line>  predLines  = array.new<line>()
var array<label> predLabels = array.new<label>()

f_pred_clear() =>
    if array.size(predLines) > 0
        for ln in predLines
            line.delete(ln)
        array.clear(predLines)
    if array.size(predLabels) > 0
        for lb in predLabels
            label.delete(lb)
        array.clear(predLabels)

// Bir pivot noktasını harf etiketiyle işaretle.
f_mark(int bidx, float price, string txt) =>
    label.new(bidx, price, txt, xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 25), textcolor = color.white, size = size.small,
         force_overlay = true)

// Bir D seviyesi için projeksiyon çizgisi + oran etiketi (C barından sağa uzanır).
f_proj(int x1, int x2, float d, float r, color col, string suffix) =>
    array.push(predLines, line.new(x1, d, x2, d, xloc = xloc.bar_index, color = col, width = 1, force_overlay = true))
    array.push(predLabels, label.new(x2, d, str.tostring(r, "#.###") + " " + suffix, xloc = xloc.bar_index,
         style = label.style_label_left, color = color.new(col, 80), textcolor = col, size = size.tiny,
         force_overlay = true))

// Yeni confirmed pivot (C) geldiğinde ve elde en az 4 pivot varsa: hesapla + çiz.
if not na(newPiv) and array.size(pivots) >= 4
    int n = array.size(pivots)
    Pivot X = array.get(pivots, n - 4)
    Pivot A = array.get(pivots, n - 3)
    Pivot B = array.get(pivots, n - 2)
    Pivot C = array.get(pivots, n - 1)

    f_pred_clear()

    // X A B C harfleri (yalnızca bunlar + projeksiyonlar çizilir)
    array.push(predLabels, f_mark(X.bidx, X.price, "X"))
    array.push(predLabels, f_mark(A.bidx, A.price, "A"))
    array.push(predLabels, f_mark(B.bidx, B.price, "B"))
    array.push(predLabels, f_mark(C.bidx, C.price, "C"))

    float xaDelta = A.price - X.price
    float bcDelta = C.price - B.price
    int   x1 = C.bidx
    int   x2 = C.bidx + projLen

    // XA retracement tabanlı olası D seviyeleri
    for i = 0 to array.size(xaRatios) - 1
        float r = array.get(xaRatios, i)
        float d = A.price - r * xaDelta
        f_proj(x1, x2, d, r, colXA, "XA")

    // BC extension tabanlı olası D seviyeleri
    for i = 0 to array.size(bcRatios) - 1
        float r = array.get(bcRatios, i)
        float d = C.price - r * bcDelta
        f_proj(x1, x2, d, r, colBC, "BC")
