// -----------------------------------------------------------------------------
// RESEARCH ENGINE — iki-feature kombinasyon sayaçları (sınırlı, incremental).
// Kondisyon kind kodları: 0 Score(scBin>=lvl), 1 Support(spBin>=lvl),
//   2 TargetDist(tdBin<=lvl), 3 ClusterWidth(cwBin<=lvl), 4 Direction(dBin==lvl).
// Metadata bir kez (barstate.isfirst) kurulur; sayaçlar çözümde O(1) artırılır.
// -----------------------------------------------------------------------------
var array<int>    cbKindA = array.new<int>()
var array<int>    cbLvlA  = array.new<int>()
var array<int>    cbKindB = array.new<int>()
var array<int>    cbLvlB  = array.new<int>()
var array<string> cbFam   = array.new<string>()
var array<int>    cbHit   = array.new<int>()
var array<int>    cbFail  = array.new<int>()
var array<int>    cbExp   = array.new<int>()

// Kombinasyonlarda kullanılan eşik seviyeleri (bin indeksleri cinsinden).
var array<int> lvScore = array.from(2, 3, 4, 5)   // Score >= 5.5/6.0/6.5/7.0
var array<int> lvSup   = array.from(1, 2, 3)      // Support >= 3/4/5
var array<int> lvTd    = array.from(0, 1, 2)      // Dist <= 1/2/4 ATR
var array<int> lvCw    = array.from(0, 1, 2)      // Width <= 0.25/0.50/1.00
var array<int> lvDir   = array.from(0, 1)         // Bullish / Bearish

// =============================================================================
// RESEARCH ENGINE yardımcıları (pasif; yalnızca mevcut sayaçları okur)
// =============================================================================
// Kondisyon üyeliği (prediction bin'lerinden). kind: 0 Score,1 Support,2 TD,3 CW,4 Dir.
f_condMet(int kind, int lvl, int scB, int spB, int tdB, int cwB, int dB) =>
    kind == 0 ? scB >= lvl : kind == 1 ? spB >= lvl : kind == 2 ? tdB <= lvl : kind == 3 ? cwB <= lvl : dB == lvl

// Kondisyon etiketi (dashboard için).
f_condLabel(int kind, int lvl) =>
    kind == 0 ? "Sc>=" + (lvl == 2 ? "5.5" : lvl == 3 ? "6.0" : lvl == 4 ? "6.5" : "7.0") : kind == 1 ? "Sup>=" + str.tostring(lvl + 2) : kind == 2 ? "Dist<=" + (lvl == 0 ? "1" : lvl == 1 ? "2" : "4") + "A" : kind == 3 ? "Wid<=" + (lvl == 0 ? "0.25" : lvl == 1 ? "0.50" : "1.00") : (lvl == 0 ? "Bull" : "Bear")

// 0..last kümülatif toplam (<= eşikleri için).
f_cumUpTo(array<int> a, int last) =>
    int s = 0
    for i = 0 to last
        s += array.get(a, i)
    s

// Bir tekil kondisyonun (kind,lvl) resolved sayacı [h,f,e].
f_condCounts(int kind, int lvl) =>
    int h = 0
    int f = 0
    int e = 0
    if kind == 0
        h := f_cumFrom(anSc_hit, lvl)
        f := f_cumFrom(anSc_fail, lvl)
        e := f_cumFrom(anSc_exp, lvl)
    else if kind == 1
        h := f_cumFrom(anSp_hit, lvl)
        f := f_cumFrom(anSp_fail, lvl)
        e := f_cumFrom(anSp_exp, lvl)
    else if kind == 2
        h := f_cumUpTo(anTd_hit, lvl)
        f := f_cumUpTo(anTd_fail, lvl)
        e := f_cumUpTo(anTd_exp, lvl)
    else if kind == 3
        h := f_cumUpTo(anCw_hit, lvl)
        f := f_cumUpTo(anCw_fail, lvl)
        e := f_cumUpTo(anCw_exp, lvl)
    else
        h := array.get(anDir_hit, lvl)
        f := array.get(anDir_fail, lvl)
        e := array.get(anDir_exp, lvl)
    [h, f, e]

// Bir aile için tüm (lvA × lvB) kombinasyonlarını metadata dizilerine ekler (bir kez).
f_addFamily(int kindA, array<int> lvA, int kindB, array<int> lvB, string fam, array<int> kA, array<int> lA, array<int> kB, array<int> lB, array<string> fm, array<int> hh, array<int> ff, array<int> ee) =>
    for ia = 0 to array.size(lvA) - 1
        for ib = 0 to array.size(lvB) - 1
            array.push(kA, kindA)
            array.push(lA, array.get(lvA, ia))
            array.push(kB, kindB)
            array.push(lB, array.get(lvB, ib))
            array.push(fm, fam)
            array.push(hh, 0)
            array.push(ff, 0)
            array.push(ee, 0)

// Türev metrikler (h,f,e + baseline + toplamlar). Lift = yüzde puan; oranlar ayrı.
f_hitRateV(int h, int f) => (h + f) > 0 ? 100.0 * h / (h + f) : na
f_liftV(int h, int f, float base100) => (h + f) > 0 ? (100.0 * h / (h + f) - base100) : na
f_relLiftV(int h, int f, float base100) => (base100 > 0 and (h + f) > 0) ? (100.0 * h / (h + f)) / base100 - 1.0 : na
f_covV(int h, int f, int e, int totRes) => totRes > 0 ? 100.0 * (h + f + e) / totRes : 0.0

// Research Score (yalnızca sıralama; confidence DEĞİL). Normalize edilmiş.
f_rScoreV(int h, int f, int e, float base100, int minStrong, int totRes) =>
    int   n         = h + f + e
    float lift      = f_liftV(h, f, base100)
    float posLift   = na(lift) ? 0.0 : math.max(lift, 0.0)
    float evidence  = math.min(1.0, minStrong > 0 ? n / minStrong : 0.0)
    float covFrac   = totRes > 0 ? n / totRes : 0.0
    float covFactor = math.min(1.0, covFrac / 0.5)
    posLift * evidence * (0.5 + 0.5 * covFactor)

// Sınıflandırma kodu (öncelik: LOW N > LOW COV > STRONG > PROMISING > NEGATIVE > NEUTRAL).
// 4 LOWN, 5 LOWCOV, 2 STRONG, 1 PROMISING, 3 NEGATIVE, 0 NEUTRAL.
f_classV(int h, int f, int e, float base100, int minRel, int minStrong, float covFloor, int totRes) =>
    int   n    = h + f + e
    float lift = f_liftV(h, f, base100)
    float cov  = f_covV(h, f, e, totRes)
    n < minRel ? 4 : cov < covFloor ? 5 : (not na(lift) and lift >= 8.0 and n >= minStrong) ? 2 : (not na(lift) and lift >= 5.0 and n >= minRel) ? 1 : (not na(lift) and lift <= -5.0 and n >= minRel) ? 3 : 0

f_clsLabel(int c) => c == 2 ? "STRONG" : c == 1 ? "PROMISING" : c == 3 ? "NEGATIVE" : c == 4 ? "LOW N" : c == 5 ? "LOW COV" : "NEUTRAL"
f_clsColor(int c) => c == 2 ? color.rgb(0, 90, 0) : c == 1 ? color.rgb(20, 70, 20) : c == 3 ? color.rgb(120, 0, 0) : c == 4 ? color.rgb(120, 70, 0) : c == 5 ? color.rgb(100, 60, 0) : color.rgb(60, 60, 60)
f_liftColor(float lift) => na(lift) ? color.rgb(25, 25, 25) : lift > 1.0 ? color.rgb(0, 90, 0) : lift < -1.0 ? color.rgb(120, 0, 0) : color.rgb(60, 60, 60)
f_liftStr(float lift) => na(lift) ? "—" : (lift >= 0 ? "+" : "") + str.tostring(lift, "#.#") + " pp"
f_pctF(float v) => na(v) ? "—" : str.tostring(v, "#.#") + "%"

// Komşu eşik kararlılığı (STABLE / MIXED / ISOLATED / —).
f_stab3(float lp, float lc, float ln) =>
    string res = "—"
    if not na(lc)
        int nb = 0
        int same = 0
        if not na(lp)
            nb += 1
            same += (lp > 0) == (lc > 0) ? 1 : 0
        if not na(ln)
            nb += 1
            same += (ln > 0) == (lc > 0) ? 1 : 0
        res := nb == 0 ? "—" : same == nb ? "STABLE" : (lc > 0 and same == 0) ? "ISOLATED" : "MIXED"
    res

// Research tablo renkleri.
var color RES_HDR  = color.rgb(20, 20, 20)
var color RES_SECT = color.rgb(45, 45, 45)
var color RES_CELL = color.rgb(25, 25, 25)

// 9 sütunlu başlık satırı.
f_resHdr9(table t, int r, string h0, string h1, string h2, string h3, string h4, string h5, string h6, string h7, string h8) =>
    table.cell(t, 0, r, h0, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, h1, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 2, r, h2, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 3, r, h3, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, h4, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, h5, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6, r, h6, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7, r, h7, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8, r, h8, text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)

// 9 sütunlu aday satırı: a b c | N Hit% Lift Cov RScore Class.
f_resRow9(table t, int r, string a, string b, string c, int h, int f, int e, float base100, int totRes, int minRel, int minStrong, float covFloor) =>
    int   n    = h + f + e
    float hr   = f_hitRateV(h, f)
    float lift = f_liftV(h, f, base100)
    float cov  = f_covV(h, f, e, totRes)
    float rs   = f_rScoreV(h, f, e, base100, minStrong, totRes)
    int   cls  = f_classV(h, f, e, base100, minRel, minStrong, covFloor, totRes)
    table.cell(t, 0, r, a, text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 1, r, b, text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 2, r, c, text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 3, r, str.tostring(n),            text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, f_pctF(hr),                 text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, f_liftStr(lift),            text_color = color.white, bgcolor = f_liftColor(lift), text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6, r, f_pctF(cov),                text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7, r, na(rs) ? "—" : str.tostring(rs, "#.##"), text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8, r, f_clsLabel(cls),            text_color = color.white, bgcolor = f_clsColor(cls), text_size = size.small, text_halign = text.align_right)

// Özet metrik satırı (label | value; kalan sütunlar doldurulur).
f_resMetric(table t, int r, string lbl, string val) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
    for c = 2 to 8
        table.cell(t, c, r, "", bgcolor = RES_CELL)

// Tekil adayları Research Score'a göre sırala (pozitif lift, aile başına perFam sınırı).
f_rankSingles(array<Cand> cs, int k, int perFam, float base100, int totRes, int minRel, int minStrong, float covFloor) =>
    array<int> chosen = array.new<int>()
    array<int> famCnt = array.new<int>(8, 0)
    bool go = true
    while array.size(chosen) < k and go
        int   bestI = -1
        float bestS = -1.0
        for i = 0 to array.size(cs) - 1
            if not array.includes(chosen, i)
                Cand c = array.get(cs, i)
                float lift = f_liftV(c.hit, c.fail, base100)
                if not na(lift) and lift > 0 and array.get(famCnt, c.fam) < perFam
                    float rs = f_rScoreV(c.hit, c.fail, c.exp, base100, minStrong, totRes)
                    if rs > bestS
                        bestS := rs
                        bestI := i
        if bestI < 0
            go := false
        else
            array.push(chosen, bestI)
            Cand cb = array.get(cs, bestI)
            array.set(famCnt, cb.fam, array.get(famCnt, cb.fam) + 1)
    chosen

// Kombinasyonları guardrail + aile sınırı ile sırala.
f_rankCombos(array<Cand> cs, int k, int perFam, float base100, int totRes, int minRel, int minStrong, float covFloor) =>
    array<int> chosen = array.new<int>()
    bool go = true
    while array.size(chosen) < k and go
        int   bestI = -1
        float bestS = -1.0
        for i = 0 to array.size(cs) - 1
            if not array.includes(chosen, i)
                Cand c = array.get(cs, i)
                int   n    = c.hit + c.fail + c.exp
                float lift = f_liftV(c.hit, c.fail, base100)
                float cov  = f_covV(c.hit, c.fail, c.exp, totRes)
                if n >= minRel and cov >= covFloor and not na(lift) and lift >= 5.0
                    string fam = array.get(cbFam, c.ord)
                    int cnt = 0
                    for j = 0 to array.size(chosen) - 1
                        if array.get(cbFam, array.get(cs, array.get(chosen, j)).ord) == fam
                            cnt += 1
                    if cnt < perFam
                        float rs = f_rScoreV(c.hit, c.fail, c.exp, base100, minStrong, totRes)
                        if rs > bestS
                            bestS := rs
                            bestI := i
        if bestI < 0
            go := false
        else
            array.push(chosen, bestI)
    chosen

// Negatif adayları (güvenilir örneklem, lift<0) en düşük lift'e göre sırala.
f_rankNeg(array<Cand> cs, int k, float base100, int totRes, int minRel, float covFloor) =>
    array<int> chosen = array.new<int>()
    bool go = true
    while array.size(chosen) < k and go
        int   worstI = -1
        float worstL = 1000000.0
        for i = 0 to array.size(cs) - 1
            if not array.includes(chosen, i)
                Cand c = array.get(cs, i)
                int   n    = c.hit + c.fail + c.exp
                float lift = f_liftV(c.hit, c.fail, base100)
                float cov  = f_covV(c.hit, c.fail, c.exp, totRes)
                if n >= minRel and cov >= covFloor and not na(lift) and lift < 0.0 and lift < worstL
                    worstL := lift
                    worstI := i
        if worstI < 0
            go := false
        else
            array.push(chosen, worstI)
    chosen

// Bir threshold ailesinin komşu-eşik kararlılığını satır satır yazar; sonraki satırı döndürür.
f_resStab(table t, int startR, int famCode, string famName, array<Cand> cs, float base100) =>
    array<int> idx = array.new<int>()
    for i = 0 to array.size(cs) - 1
        if array.get(cs, i).fam == famCode
            array.push(idx, i)
    int r = startR
    for m = 0 to array.size(idx) - 1
        Cand  c  = array.get(cs, array.get(idx, m))
        float lc = f_liftV(c.hit, c.fail, base100)
        float lp = m > 0 ? f_liftV(array.get(cs, array.get(idx, m - 1)).hit, array.get(cs, array.get(idx, m - 1)).fail, base100) : na
        float ln = m < array.size(idx) - 1 ? f_liftV(array.get(cs, array.get(idx, m + 1)).hit, array.get(cs, array.get(idx, m + 1)).fail, base100) : na
        string stab = f_stab3(lp, lc, ln)
        int n = c.hit + c.fail + c.exp
        table.cell(t, 0, r, famName,          text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
        table.cell(t, 1, r, c.label,          text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
        table.cell(t, 2, r, str.tostring(n),  text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
        table.cell(t, 3, r, "", bgcolor = RES_CELL)
        table.cell(t, 4, r, "", bgcolor = RES_CELL)
        table.cell(t, 5, r, f_liftStr(lc),    text_color = color.white, bgcolor = f_liftColor(lc), text_size = size.small, text_halign = text.align_right)
        table.cell(t, 6, r, "", bgcolor = RES_CELL)
        table.cell(t, 7, r, "", bgcolor = RES_CELL)
        table.cell(t, 8, r, stab,             text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
        r += 1
    r

// Confidence: özet/reliability metrik satırı (label | value; 8 sütun).
f_cfMetric(table t, int r, string lbl, string val) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    for c = 2 to 7
        table.cell(t, c, r, "", bgcolor = RES_CELL)

// Confidence: kalibrasyon başlık satırı (8 sütun).
f_cfHdr(table t, int r) =>
    table.cell(t, 0, r, "Range",   text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, "N",       text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, "Hit",     text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3, r, "Fail",    text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, "Exp",     text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, "ResHit%", text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6, r, "Ovr%",    text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7, r, "Life",    text_color = color.white, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_right)

// Confidence: kalibrasyon veri satırı.
f_cfCalRow(table t, int r, string lbl, int h, int f, int e, int sumLife) =>
    int n = h + f + e
    table.cell(t, 0, r, lbl,             text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, str.tostring(n), text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, str.tostring(h), text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3, r, str.tostring(f), text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, str.tostring(e), text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, f_pctS(h, h + f), text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6, r, f_pctS(h, n),     text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7, r, n > 0 ? str.tostring(sumLife / n, "#.#") : "—", text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_right)

// -----------------------------------------------------------------------------
// Görüntüleme penceresi: kaç prediction ÇİZİLİ tutulacak (kayıt sayısını etkilemez).
// Obje limitine (500) göre güvenli üst sınır hesaplanır.
// -----------------------------------------------------------------------------
int boxesPer  = 1 + (showSecond ? 1 : 0)
int labelsPer = showXABC ? 4 : 0
int capBox    = int(490 / boxesPer)
int capLbl    = labelsPer > 0 ? int(490 / labelsPer) : 1000000
int allCap    = math.min(capBox, capLbl)
int maxDrawn  = histDisplay == "Latest only" ? 1 : histDisplay == "Last N predictions" ? math.min(histCount, allCap) : allCap

// RESEARCH: kombinasyon metadata'sını bir kez kur (7 aile; toplam 68 kombinasyon).
if barstate.isfirst and array.size(cbFam) == 0
    f_addFamily(0, lvScore, 1, lvSup, "Sc+Sup",  cbKindA, cbLvlA, cbKindB, cbLvlB, cbFam, cbHit, cbFail, cbExp)
    f_addFamily(0, lvScore, 2, lvTd,  "Sc+Dist", cbKindA, cbLvlA, cbKindB, cbLvlB, cbFam, cbHit, cbFail, cbExp)
    f_addFamily(0, lvScore, 3, lvCw,  "Sc+Wid",  cbKindA, cbLvlA, cbKindB, cbLvlB, cbFam, cbHit, cbFail, cbExp)
    f_addFamily(1, lvSup,   2, lvTd,  "Sup+Dist",cbKindA, cbLvlA, cbKindB, cbLvlB, cbFam, cbHit, cbFail, cbExp)
    f_addFamily(1, lvSup,   3, lvCw,  "Sup+Wid", cbKindA, cbLvlA, cbKindB, cbLvlB, cbFam, cbHit, cbFail, cbExp)
    f_addFamily(4, lvDir,   0, lvScore,"Dir+Sc", cbKindA, cbLvlA, cbKindB, cbLvlB, cbFam, cbHit, cbFail, cbExp)
    f_addFamily(4, lvDir,   2, lvTd,  "Dir+Dist",cbKindA, cbLvlA, cbKindB, cbLvlB, cbFam, cbHit, cbFail, cbExp)

// =============================================================================
// ANA AKIŞ — yalnızca KAPANMIŞ (confirmed) barlarda; ileri doğru, bar bar.
// =============================================================================
if barstate.isconfirmed
    // 0) Pivot motorunu ilerlet (repaint-safe).
    Pivot newPiv = f_engine_step(pivEng, pivK, pivMinBars, atr)
    if not na(newPiv)
        array.push(pivots, newPiv)
        if array.size(pivots) > BUFFER_MAX
            array.shift(pivots)

    // -------------------------------------------------------------------------
    // 0b) EVALUATION ENGINE — yalnızca ACTIVE prediction'ları bu barın high/low'u
    //     ile ileri doğru değerlendir. Oluşum barının kendi high/low'u kullanılmaz
    //     (creationBar < bar_index). Çözülen kayıt bir kez işlenir, listeden çıkar.
    // -------------------------------------------------------------------------
    int ai = 0
    while ai < array.size(activeList)
        PredRec p = array.get(activeList, ai)
        bool resolved = false
        if p.creationBar < bar_index
            bool bull     = p.direction == 1
            bool hitCond  = bull ? (high >= p.targetLow) : (low <= p.targetHigh)
            bool hasInval = not na(p.invalidationPrice)
            bool failCond = hasInval ? (bull ? (low <= p.invalidationPrice) : (high >= p.invalidationPrice)) : false

            int   rs     = 0
            float rprice = na
            if hitCond and failCond
                // Aynı mumda hem hedef hem invalidation: sıra bilinemez.
                if ambigMode == "Optimistic"
                    rs     := 1
                    rprice := bull ? p.targetLow : p.targetHigh
                else if ambigMode == "Ignore"
                    rs     := 0   // çözme; sonraki barda takip devam
                else
                    rs     := 2   // Conservative
                    rprice := p.invalidationPrice
            else if hitCond
                rs     := 1
                rprice := bull ? p.targetLow : p.targetHigh
            else if failCond
                rs     := 2
                rprice := p.invalidationPrice
            else if (bar_index - p.creationBar) >= maxActiveBars
                rs     := 3
                rprice := close

            if rs != 0
                // Snapshot'a çözüm yaz (bir daha değişmez).
                p.status      := rs
                p.resolvedBar := bar_index
                p.resultPrice := rprice
                p.barsAlive   := bar_index - p.creationBar

                int sb  = f_scoreBucket(p.score)
                int spb = f_supBucket(p.support)
                if rs == 1
                    evHit         += 1
                    evSumHitBars  += p.barsAlive
                    array.set(scHit, sb,  array.get(scHit, sb)  + 1)
                    array.set(spHit, spb, array.get(spHit, spb) + 1)
                else if rs == 2
                    evFail        += 1
                    evSumFailBars += p.barsAlive
                    array.set(scFail, sb,  array.get(scFail, sb)  + 1)
                    array.set(spFail, spb, array.get(spFail, spb) + 1)
                else
                    evExp         += 1
                    array.set(scExp, sb,  array.get(scExp, sb)  + 1)
                    array.set(spExp, spb, array.get(spExp, spb) + 1)
                evSumLifeBars += p.barsAlive

                // ---- ANALYTICS incremental güncelleme (pasif; yalnızca çözülen kayıt) ----
                f_bump3(anSc_hit, anSc_fail, anSc_exp, f_scBin(p.score), rs)
                f_bump3(anSp_hit, anSp_fail, anSp_exp, f_spBin(p.support), rs)
                int dbin = p.direction == 1 ? 0 : 1
                f_bump3(anDir_hit, anDir_fail, anDir_exp, dbin, rs)
                if rs == 1
                    array.set(anDir_hitBars, dbin, array.get(anDir_hitBars, dbin) + p.barsAlive)
                else if rs == 2
                    array.set(anDir_failBars, dbin, array.get(anDir_failBars, dbin) + p.barsAlive)
                f_bump3(anCw_hit, anCw_fail, anCw_exp, f_cwBin(p.normalizedClusterWidth), rs)
                int tbin = f_tdBin(p.targetDistanceATR)
                f_bump3(anTd_hit, anTd_fail, anTd_exp, tbin, rs)
                if rs == 1
                    array.set(anTd_hitBars, tbin, array.get(anTd_hitBars, tbin) + p.barsAlive)
                f_bump3(anXa_hit, anXa_fail, anXa_exp, f_xaBin(p.xaAtrMultiple), rs)
                f_bump3(anBc_hit, anBc_fail, anBc_exp, f_bcBin(p.bcAbRatio), rs)

                // ---- RESEARCH: iki-feature kombinasyon sayaçlarını incremental güncelle ----
                int scB = f_scBin(p.score)
                int spB = f_spBin(p.support)
                int tdB = f_tdBin(p.targetDistanceATR)
                int cwB = f_cwBin(p.normalizedClusterWidth)
                int dB  = p.direction == 1 ? 0 : 1
                for ci = 0 to array.size(cbFam) - 1
                    if f_condMet(array.get(cbKindA, ci), array.get(cbLvlA, ci), scB, spB, tdB, cwB, dB) and f_condMet(array.get(cbKindB, ci), array.get(cbLvlB, ci), scB, spB, tdB, cwB, dB)
                        f_bump3(cbHit, cbFail, cbExp, ci, rs)

                // ---- CONFIDENCE: çözülen kaydın (dondurulmuş) confidence'ını istatistiğe kat ----
                float pc = na(p.confidence) ? 50.0 : p.confidence
                cfSumAll += pc
                if rs == 1
                    cfSumHit += pc
                else if rs == 2
                    cfSumFail += pc
                else
                    cfSumExp += pc
                int cbn = f_confBin(pc)
                if rs == 1
                    array.set(cfHit, cbn, array.get(cfHit, cbn) + 1)
                else if rs == 2
                    array.set(cfFail, cbn, array.get(cfFail, cbn) + 1)
                else
                    array.set(cfExp, cbn, array.get(cfExp, cbn) + 1)
                array.set(cfLife, cbn, array.get(cfLife, cbn) + p.barsAlive)
                float succ = rs == 1 ? 1.0 : 0.0
                cfN   += 1
                cfSx  += pc
                cfSy  += succ
                cfSxy += pc * succ
                cfSxx += pc * pc
                cfSyy += succ * succ
                array.set(cfScSum, scB, array.get(cfScSum, scB) + pc)
                array.set(cfSpSum, spB, array.get(cfSpSum, spB) + pc)

                array.remove(activeList, ai)
                resolved := true
        if not resolved
            ai += 1

    // 1) Yeni confirmed pivot (yeni C): doğrula, projeksiyon, kümelendir, kaydet+çiz.
    if not na(newPiv) and array.size(pivots) >= 4
        int n = array.size(pivots)
        Pivot X = array.get(pivots, n - 4)
        Pivot A = array.get(pivots, n - 3)
        Pivot B = array.get(pivots, n - 2)
        Pivot C = array.get(pivots, n - 1)

        if f_xabc_valid(X, A, B, C)
            cntXabc += 1
            bool wantDown = X.kind == -1   // L-H-L-H -> D aşağı ; H-L-H-L -> D yukarı

            // 1a) Geçerli D seviyelerini (price, src, ratio) havuza topla (HAM ÇİZME).
            array<Proj> projs = array.new<Proj>()
            float xaDelta = A.price - X.price
            float bcDelta = C.price - B.price
            for i = 0 to array.size(xaRatios) - 1
                float r = array.get(xaRatios, i)
                float d = A.price - r * xaDelta
                if (wantDown ? d < C.price : d > C.price)
                    array.push(projs, Proj.new(d, 0, r))
            for i = 0 to array.size(bcRatios) - 1
                float r = array.get(bcRatios, i)
                float d = C.price - r * bcDelta
                if (wantDown ? d < C.price : d > C.price)
                    array.push(projs, Proj.new(d, 1, r))

            if array.size(projs) > 0
                // Adaptif tolerans: pattern boyutuna (XA) orantılı, ATR ve tick tabanı ile.
                // C onaylanınca bir kez hesaplanır (snapshot) — sonradan yeniden hesaplanmaz.
                float patternTolerance = math.abs(A.price - X.price) * (patternTolPct / 100.0)
                float atrFloor  = atr * atrFloorMult
                float tickFloor = syminfo.mintick * minTolTicks
                float tol = math.max(patternTolerance, math.max(atrFloor, tickFloor))
                array<bool> used = array.new<bool>(array.size(projs), false)

                // Primary = en yüksek skorlu küme (en az minSupport üye şart).
                [pIdx, pScore, pLo, pHi, pSupport] = f_best_cluster(projs, used, tol, minSupport)
                if pIdx >= 0
                    cntClusters += 1

                    // 1b) Duplicate engelle: aynı X-A-B-C bar imzası tekrar üretilmesin.
                    bool dup = not na(lastC) and X.bidx == lastX and A.bidx == lastA and B.bidx == lastB and C.bidx == lastC
                    if dup
                        cntDup += 1
                    else
                        lastX := X.bidx
                        lastA := A.bidx
                        lastB := B.bidx
                        lastC := C.bidx

                        float pCenter = array.get(projs, pIdx).price
                        int   dir     = wantDown ? -1 : 1

                        // 1c) Evaluation snapshot: invalidation seviyesi + ATR (oluşum anında sabitlenir).
                        float cATR = atr
                        float invalP = na
                        if failMode == "C ± ATR"
                            invalP := dir == 1 ? C.price - cATR * evalAtrMult : C.price + cATR * evalAtrMult
                        else if failMode == "X Pivot"
                            invalP := X.price
                        // "None" -> invalP = na (yalnız HIT/EXPIRED)

                        // 1d) Analytics snapshot — oluşum anında dondurulan pasif özellikler.
                        float anSpread   = pHi - pLo
                        float anNormW    = anSpread / math.max(tol, syminfo.mintick)
                        float anXaLen    = math.abs(X.price - A.price)
                        float anBcLen    = math.abs(B.price - C.price)
                        float anAbLen    = math.abs(B.price - A.price)
                        float anXaAtr    = cATR > 0 ? anXaLen / cATR : na
                        float anBcAtr    = cATR > 0 ? anBcLen / cATR : na
                        float anAbXa     = anXaLen > 0 ? anAbLen / anXaLen : na
                        float anBcAb     = anAbLen > 0 ? anBcLen / anAbLen : na
                        float anTDist    = math.abs(pCenter - close)
                        float anTDistAtr = cATR > 0 ? anTDist / cATR : na
                        float anTDistXa  = anXaLen > 0 ? anTDist / anXaLen : na

                        // 1e) CONFIDENCE v2 — YALNIZCA GEÇMİŞ istatistikten (as-of-now; lookahead yok).
                        //     Her feature bucket'ı log-odds kanıt kayması verir; bunların EVIDENCE
                        //     ağırlıklı ORTALAMASI alınır (güçlü örneklem baskın, zayıf yok sayılır),
                        //     gain ile keskinleştirilir ve sigmoid ile 0-100'e taşınır (kalibre olasılık
                        //     tahmini). Score DEĞİŞMEZ; Confidence tamamen ayrı istatistikseldir.
                        float p0f = (evHit + evFail) > 0 ? evHit / (evHit + evFail) : na
                        float l0  = (not na(p0f) and p0f > 0.0 and p0f < 1.0) ? math.log(p0f / (1.0 - p0f)) : na
                        int   cDir = dir == 1 ? 0 : 1
                        int   cScB = f_scBin(pScore)
                        int   cSpB = f_spBin(pSupport)
                        int   cCwB = f_cwBin(anNormW)
                        int   cTdB = f_tdBin(anTDistAtr)
                        int   cXaB = f_xaBin(anXaAtr)
                        int   cBcB = f_bcBin(anBcAb)
                        float cNum = 0.0
                        float cDen = 0.0
                        [n1, d1] = f_confAcc(array.get(anSc_hit, cScB), array.get(anSc_fail, cScB), p0f, minReliableN, 1.2, 6.0)
                        [n2, d2] = f_confAcc(array.get(anSp_hit, cSpB), array.get(anSp_fail, cSpB), p0f, minReliableN, 1.2, 5.0)
                        [n3, d3] = f_confAcc(array.get(anDir_hit, cDir), array.get(anDir_fail, cDir), p0f, minReliableN, 1.2, 3.0)
                        [n4, d4] = f_confAcc(array.get(anCw_hit, cCwB), array.get(anCw_fail, cCwB), p0f, minReliableN, 1.2, 4.0)
                        [n5, d5] = f_confAcc(array.get(anTd_hit, cTdB), array.get(anTd_fail, cTdB), p0f, minReliableN, 1.2, 5.0)
                        [n6, d6] = f_confAcc(array.get(anXa_hit, cXaB), array.get(anXa_fail, cXaB), p0f, minReliableN, 1.2, 3.0)
                        [n7, d7] = f_confAcc(array.get(anBc_hit, cBcB), array.get(anBc_fail, cBcB), p0f, minReliableN, 1.2, 2.0)
                        cNum := n1 + n2 + n3 + n4 + n5 + n6 + n7
                        cDen := d1 + d2 + d3 + d4 + d5 + d6 + d7
                        float avgShift = cDen > 0 ? cNum / cDen : 0.0
                        float confidence = na(l0) ? 50.0 : math.round(100.0 / (1.0 + math.exp(-(l0 + confGain * avgShift))))
                        confidence := math.max(0.0, math.min(100.0, confidence))

                        // 1f) Çizim: kutu, oluştuğu (confirmed C) bardan sağa (Score + Confidence).
                        PredGroup g = PredGroup.new(array.new<label>(), array.new<box>())
                        int x1 = bar_index
                        int x2 = bar_index + projLen
                        string pSrc = f_cluster_src_and_mark(projs, used, tol, pIdx)
                        array.push(g.boxes, f_target_box(x1, x2, pLo, pHi, pScore, "D Target", colPrimary, atr, pSrc, confidence))
                        if showXABC
                            array.push(g.labels, f_mark(X.bidx, X.price, "X"))
                            array.push(g.labels, f_mark(A.bidx, A.price, "A"))
                            array.push(g.labels, f_mark(B.bidx, B.price, "B"))
                            array.push(g.labels, f_mark(C.bidx, C.price, "C"))
                        if showSecond
                            [sIdx, sScore, sLo, sHi, sSupport] = f_best_cluster(projs, used, tol, minSupport)
                            if sIdx >= 0 and sScore > 0
                                string sSrc = f_cluster_src_and_mark(projs, used, tol, sIdx)
                                array.push(g.boxes, f_target_box(x1, x2, sLo, sHi, sScore, "Secondary", colSecond, atr, sSrc, na))

                        // 1g) Snapshot kaydı — asla silinmez/yeniden hesaplanmaz. status = ACTIVE.
                        PredRec rec = PredRec.new(id = predSeq + 1, creationBar = bar_index, pivotCBar = C.bidx,
                             direction = dir, targetLow = pLo, targetHigh = pHi, centerPrice = pCenter,
                             score = pScore, support = pSupport, viz = g,
                             status = 0, resolvedBar = na, resultPrice = na, barsAlive = na,
                             invalidationPrice = invalP, creationATR = cATR,
                             clusterSpread = anSpread, clusterTolerance = tol, normalizedClusterWidth = anNormW,
                             xaLength = anXaLen, bcLength = anBcLen, xaAtrMultiple = anXaAtr, bcAtrMultiple = anBcAtr,
                             abXaRatio = anAbXa, bcAbRatio = anBcAb, targetDistance = anTDist,
                             targetDistanceATR = anTDistAtr, targetDistanceXA = anTDistXa, confidence = confidence)
                        predSeq += 1
                        array.push(records, rec)
                        cntCreated += 1

                        // 1h) Evaluation kaydı: ACTIVE olarak izlemeye al + oluşum sayaçları.
                        array.push(activeList, rec)
                        evTotal += 1
                        int csb  = f_scoreBucket(pScore)
                        int cspb = f_supBucket(pSupport)
                        array.set(scCount, csb,  array.get(scCount, csb)  + 1)
                        array.set(spCount, cspb, array.get(spCount, cspb) + 1)

                        // 1e) Görüntüleme penceresini uygula: yalnızca ÇİZİMLERİ buda.
                        //     En eski çizim silinir; ilgili KAYIT records içinde kalır.
                        array.push(drawn, rec)
                        while array.size(drawn) > maxDrawn
                            PredRec old = array.shift(drawn)
                            f_group_delete(old.viz)

// =============================================================================
// DEBUG TABLO (yalnızca son barda güncellenir)
// =============================================================================
var table dbg = na
if showDebug and barstate.islast
    if na(dbg)
        dbg := table.new(position.bottom_right, 2, 6, border_width = 1, frame_width = 1, frame_color = color.gray)
    color hdr = color.new(color.blue, 20)
    color bg1 = color.new(color.gray, 90)
    color bg2 = color.new(color.gray, 80)
    table.cell(dbg, 0, 0, "Prediction Debug", text_color = color.white, bgcolor = hdr, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 0, "", bgcolor = hdr)
    f_drow(dbg, 1, "Total confirmed XABC",        str.tostring(cntXabc),           bg1)
    f_drow(dbg, 2, "Total valid clusters",        str.tostring(cntClusters),       bg2)
    f_drow(dbg, 3, "Total predictions created",   str.tostring(cntCreated),        bg1)
    f_drow(dbg, 4, "Predictions currently drawn", str.tostring(array.size(drawn)), bg2)
    f_drow(dbg, 5, "Duplicate predictions skipped", str.tostring(cntDup),          bg1)

// =============================================================================
// EVALUATION DASHBOARD (sağ üst; yalnızca son barda)
// =============================================================================
var table ev = na
if showEval and barstate.islast
    if na(ev)
        ev := table.new(position.top_right, 6, 23, border_width = 1, frame_width = 1, frame_color = color.rgb(70, 70, 70))

    int evActive = array.size(activeList)

    // Başlık
    table.cell(ev, 0, 0, "PREDICTION EVALUATION", text_color = color.white, bgcolor = EV_TITLE, text_size = size.normal, text_halign = text.align_left)
    table.cell(ev, 1, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 2, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 3, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 4, 0, "", bgcolor = EV_TITLE)
    table.cell(ev, 5, 0, "", bgcolor = EV_TITLE)

    // Özet metrikler
    f_evMetric(ev, 1,  "Total Predictions",      str.tostring(evTotal),                       EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 2,  "Active",                 str.tostring(evActive),                      EV_ACTIVE, EV_ACTIVE)
    f_evMetric(ev, 3,  "Hit",                    str.tostring(evHit),                         EV_HIT, EV_HIT)
    f_evMetric(ev, 4,  "Failed",                 str.tostring(evFail),                        EV_FAIL, EV_FAIL)
    f_evMetric(ev, 5,  "Expired",                str.tostring(evExp),                         EV_EXP, EV_EXP)
    f_evMetric(ev, 6,  "Hit Rate",               f_pctS(evHit, evHit + evFail),               EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 7,  "Overall Success",        f_pctS(evHit, evTotal),                      EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 8,  "Average Bars To Hit",    f_avgS(evSumHitBars, evHit),                 EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 9,  "Average Bars To Failure",f_avgS(evSumFailBars, evFail),               EV_LEFT, EV_RIGHT)
    f_evMetric(ev, 10, "Average Lifetime",       f_avgS(evSumLifeBars, evHit + evFail + evExp), EV_LEFT, EV_RIGHT)

    // Score analysis
    f_evSection(ev, 11, "SCORE ANALYSIS")
    f_evAnalyseHdr(ev, 12)
    f_evAnalyseRow(ev, 13, "Score < 5",  array.get(scCount, 0), array.get(scHit, 0), array.get(scFail, 0), array.get(scExp, 0))
    f_evAnalyseRow(ev, 14, "5.0 - 5.99", array.get(scCount, 1), array.get(scHit, 1), array.get(scFail, 1), array.get(scExp, 1))
    f_evAnalyseRow(ev, 15, "6.0 - 6.99", array.get(scCount, 2), array.get(scHit, 2), array.get(scFail, 2), array.get(scExp, 2))
    f_evAnalyseRow(ev, 16, "Score >= 7", array.get(scCount, 3), array.get(scHit, 3), array.get(scFail, 3), array.get(scExp, 3))

    // Support analysis
    f_evSection(ev, 17, "SUPPORT ANALYSIS")
    f_evAnalyseHdr(ev, 18)
    f_evAnalyseRow(ev, 19, "Support 2",  array.get(spCount, 0), array.get(spHit, 0), array.get(spFail, 0), array.get(spExp, 0))
    f_evAnalyseRow(ev, 20, "Support 3",  array.get(spCount, 1), array.get(spHit, 1), array.get(spFail, 1), array.get(spExp, 1))
    f_evAnalyseRow(ev, 21, "Support 4",  array.get(spCount, 2), array.get(spHit, 2), array.get(spFail, 2), array.get(spExp, 2))
    f_evAnalyseRow(ev, 22, "Support 5+", array.get(spCount, 3), array.get(spHit, 3), array.get(spFail, 3), array.get(spExp, 3))

// =============================================================================
// PREDICTION ANALYTICS DASHBOARD (sol üst; yalnızca son barda; tek görünüm)
// =============================================================================
var table ana = na
if showAnalytics and barstate.islast
    if na(ana)
        ana := table.new(position.bottom_left, 11, 12, border_width = 1, frame_width = 1, frame_color = color.rgb(70, 70, 70))

    int   totRes  = evHit + evFail + evExp
    float base100 = (evHit + evFail) > 0 ? 100.0 * evHit / (evHit + evFail) : na
    string baseStr = na(base100) ? "—" : str.tostring(base100, "#.#") + "%"

    // Başlık + bilgi satırı
    table.cell(ana, 0, 0, "PREDICTION ANALYTICS · " + analyticsView, text_color = color.white, bgcolor = ANA_TITLE, text_size = size.normal, text_halign = text.align_left)
    for c = 1 to 10
        table.cell(ana, c, 0, "", bgcolor = ANA_TITLE)
    table.cell(ana, 0, 1, "Baseline " + baseStr + " · Resolved N " + str.tostring(totRes) + " · minN " + str.tostring(minReliableN), text_color = color.white, bgcolor = ANA_CELL, text_size = size.small, text_halign = text.align_left)
    for c = 1 to 10
        table.cell(ana, c, 1, "", bgcolor = ANA_CELL)

    if analyticsView == "Evaluation Summary"
        f_anMetric(ana, 2, "Total Predictions",  str.tostring(evTotal))
        f_anMetric(ana, 3, "Active",             str.tostring(array.size(activeList)))
        f_anMetric(ana, 4, "Hit",                str.tostring(evHit))
        f_anMetric(ana, 5, "Failed",             str.tostring(evFail))
        f_anMetric(ana, 6, "Expired",            str.tostring(evExp))
        f_anMetric(ana, 7, "Resolved Hit Rate",  f_pctS(evHit, evHit + evFail))
        f_anMetric(ana, 8, "Overall Success",    f_pctS(evHit, totRes))
    else
        f_anHeader(ana, 2)
        if analyticsView == "Score Thresholds"
            f_anRow(ana, 3, "Score >= 5.0", f_cumFrom(anSc_hit, 1), f_cumFrom(anSc_fail, 1), f_cumFrom(anSc_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "Score >= 5.5", f_cumFrom(anSc_hit, 2), f_cumFrom(anSc_fail, 2), f_cumFrom(anSc_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "Score >= 6.0", f_cumFrom(anSc_hit, 3), f_cumFrom(anSc_fail, 3), f_cumFrom(anSc_exp, 3), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "Score >= 6.5", f_cumFrom(anSc_hit, 4), f_cumFrom(anSc_fail, 4), f_cumFrom(anSc_exp, 4), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 7, "Score >= 7.0", f_cumFrom(anSc_hit, 5), f_cumFrom(anSc_fail, 5), f_cumFrom(anSc_exp, 5), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "Support Thresholds"
            f_anRow(ana, 3, "Support >= 2", f_cumFrom(anSp_hit, 0), f_cumFrom(anSp_fail, 0), f_cumFrom(anSp_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "Support >= 3", f_cumFrom(anSp_hit, 1), f_cumFrom(anSp_fail, 1), f_cumFrom(anSp_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "Support >= 4", f_cumFrom(anSp_hit, 2), f_cumFrom(anSp_fail, 2), f_cumFrom(anSp_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "Support >= 5", f_cumFrom(anSp_hit, 3), f_cumFrom(anSp_fail, 3), f_cumFrom(anSp_exp, 3), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "Direction"
            f_anRow(ana, 3, "Bullish", array.get(anDir_hit, 0), array.get(anDir_fail, 0), array.get(anDir_exp, 0), totRes, base100, minReliableN, array.get(anDir_hitBars, 0), array.get(anDir_failBars, 0))
            f_anRow(ana, 4, "Bearish", array.get(anDir_hit, 1), array.get(anDir_fail, 1), array.get(anDir_exp, 1), totRes, base100, minReliableN, array.get(anDir_hitBars, 1), array.get(anDir_failBars, 1))
        else if analyticsView == "Cluster Width"
            f_anRow(ana, 3, "W <= 0.25",   array.get(anCw_hit, 0), array.get(anCw_fail, 0), array.get(anCw_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "0.25 - 0.50", array.get(anCw_hit, 1), array.get(anCw_fail, 1), array.get(anCw_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "0.50 - 1.00", array.get(anCw_hit, 2), array.get(anCw_fail, 2), array.get(anCw_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "W > 1.00",    array.get(anCw_hit, 3), array.get(anCw_fail, 3), array.get(anCw_exp, 3), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "Target Distance"
            f_anRow(ana, 3, "<= 1 ATR",  array.get(anTd_hit, 0), array.get(anTd_fail, 0), array.get(anTd_exp, 0), totRes, base100, minReliableN, array.get(anTd_hitBars, 0), -1)
            f_anRow(ana, 4, "1 - 2 ATR", array.get(anTd_hit, 1), array.get(anTd_fail, 1), array.get(anTd_exp, 1), totRes, base100, minReliableN, array.get(anTd_hitBars, 1), -1)
            f_anRow(ana, 5, "2 - 4 ATR", array.get(anTd_hit, 2), array.get(anTd_fail, 2), array.get(anTd_exp, 2), totRes, base100, minReliableN, array.get(anTd_hitBars, 2), -1)
            f_anRow(ana, 6, "> 4 ATR",   array.get(anTd_hit, 3), array.get(anTd_fail, 3), array.get(anTd_exp, 3), totRes, base100, minReliableN, array.get(anTd_hitBars, 3), -1)
        else if analyticsView == "XA Scale"
            f_anRow(ana, 3, "< 3 ATR",    array.get(anXa_hit, 0), array.get(anXa_fail, 0), array.get(anXa_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "3 - 6 ATR",  array.get(anXa_hit, 1), array.get(anXa_fail, 1), array.get(anXa_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "6 - 10 ATR", array.get(anXa_hit, 2), array.get(anXa_fail, 2), array.get(anXa_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "> 10 ATR",   array.get(anXa_hit, 3), array.get(anXa_fail, 3), array.get(anXa_exp, 3), totRes, base100, minReliableN, -1, -1)
        else if analyticsView == "BC Ratio"
            f_anRow(ana, 3, "< 0.382",       array.get(anBc_hit, 0), array.get(anBc_fail, 0), array.get(anBc_exp, 0), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 4, "0.382 - 0.50",  array.get(anBc_hit, 1), array.get(anBc_fail, 1), array.get(anBc_exp, 1), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 5, "0.50 - 0.618",  array.get(anBc_hit, 2), array.get(anBc_fail, 2), array.get(anBc_exp, 2), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 6, "0.618 - 0.786", array.get(anBc_hit, 3), array.get(anBc_fail, 3), array.get(anBc_exp, 3), totRes, base100, minReliableN, -1, -1)
            f_anRow(ana, 7, "> 0.786",       array.get(anBc_hit, 4), array.get(anBc_fail, 4), array.get(anBc_exp, 4), totRes, base100, minReliableN, -1, -1)

// =============================================================================
// PREDICTION RESEARCH DASHBOARD (alt orta; yalnızca son barda; tek görünüm)
// =============================================================================
var table res = na
if showResearch and barstate.islast
    if na(res)
        res := table.new(position.bottom_center, 9, 22, border_width = 1, frame_width = 1, frame_color = color.rgb(70, 70, 70))

    int   totCreated = evTotal
    int   totRes     = evHit + evFail + evExp
    float base100    = (evHit + evFail) > 0 ? 100.0 * evHit / (evHit + evFail) : na
    string baseStr   = na(base100) ? "—" : str.tostring(base100, "#.#") + "%"

    // ---- Tekil aday listesi (mevcut analytics sayaçlarından) ----
    array<Cand> singles = array.new<Cand>()
    for li = 1 to 5
        [h, f, e] = f_condCounts(0, li)
        array.push(singles, Cand.new(0, li - 1, "Score>=" + (li == 1 ? "5.0" : li == 2 ? "5.5" : li == 3 ? "6.0" : li == 4 ? "6.5" : "7.0"), "", 0, li, -1, -1, h, f, e))
    for li = 0 to 3
        [h, f, e] = f_condCounts(1, li)
        array.push(singles, Cand.new(1, li, "Support>=" + str.tostring(li + 2), "", 1, li, -1, -1, h, f, e))
    for li = 0 to 1
        [h, f, e] = f_condCounts(4, li)
        array.push(singles, Cand.new(2, li, li == 0 ? "Bullish" : "Bearish", "", 4, li, -1, -1, h, f, e))
    for li = 0 to 2
        [h, f, e] = f_condCounts(3, li)
        array.push(singles, Cand.new(3, li, "Width<=" + (li == 0 ? "0.25" : li == 1 ? "0.50" : "1.00"), "", 3, li, -1, -1, h, f, e))
    for li = 0 to 2
        [h, f, e] = f_condCounts(2, li)
        array.push(singles, Cand.new(4, li, "Dist<=" + (li == 0 ? "1" : li == 1 ? "2" : "4") + "ATR", "", 2, li, -1, -1, h, f, e))
    for li = 0 to 3
        array.push(singles, Cand.new(5, li, li == 0 ? "XA<3" : li == 1 ? "XA3-6" : li == 2 ? "XA6-10" : "XA>10", "", -1, li, -1, -1, array.get(anXa_hit, li), array.get(anXa_fail, li), array.get(anXa_exp, li)))
    for li = 0 to 4
        string bl = li == 0 ? "BC<.382" : li == 1 ? "BC.382-.5" : li == 2 ? "BC.5-.618" : li == 3 ? "BC.618-.786" : "BC>.786"
        array.push(singles, Cand.new(6, li, bl, "", -1, li, -1, -1, array.get(anBc_hit, li), array.get(anBc_fail, li), array.get(anBc_exp, li)))

    // ---- Kombinasyon aday listesi (mevcut kombinasyon sayaçlarından) ----
    array<Cand> combos = array.new<Cand>()
    for ci = 0 to array.size(cbFam) - 1
        array.push(combos, Cand.new(7, ci, f_condLabel(array.get(cbKindA, ci), array.get(cbLvlA, ci)), f_condLabel(array.get(cbKindB, ci), array.get(cbLvlB, ci)), array.get(cbKindA, ci), array.get(cbLvlA, ci), array.get(cbKindB, ci), array.get(cbLvlB, ci), array.get(cbHit, ci), array.get(cbFail, ci), array.get(cbExp, ci)))

    // Başlık + bilgi satırı
    table.cell(res, 0, 0, "PREDICTION RESEARCH · " + researchView, text_color = color.white, bgcolor = RES_HDR, text_size = size.normal, text_halign = text.align_left)
    for c = 1 to 8
        table.cell(res, c, 0, "", bgcolor = RES_HDR)
    table.cell(res, 0, 1, "Baseline " + baseStr + " · Resolved " + str.tostring(totRes) + " · Çoklu test: sonuçlar KANIT değil, yalnız aday", text_color = color.white, bgcolor = RES_CELL, text_size = size.small, text_halign = text.align_left)
    for c = 1 to 8
        table.cell(res, c, 1, "", bgcolor = RES_CELL)

    if researchView == "Research Summary"
        int cntStrong    = 0
        int cntPromising = 0
        int cntNegative  = 0
        int cntLowN      = 0
        int   bestSingleI  = -1
        float bestSingleRS = -1.0
        float highRelLift  = na
        for i = 0 to array.size(singles) - 1
            Cand c = array.get(singles, i)
            int cls = f_classV(c.hit, c.fail, c.exp, base100, minReliableN, minStrongN, coverageFloor, totRes)
            cntStrong    += cls == 2 ? 1 : 0
            cntPromising += cls == 1 ? 1 : 0
            cntNegative  += cls == 3 ? 1 : 0
            cntLowN      += cls == 4 ? 1 : 0
            int   n    = c.hit + c.fail + c.exp
            float lift = f_liftV(c.hit, c.fail, base100)
            float cov  = f_covV(c.hit, c.fail, c.exp, totRes)
            if n >= minReliableN and cov >= coverageFloor and not na(lift)
                highRelLift := na(highRelLift) ? lift : math.max(highRelLift, lift)
            float rs = f_rScoreV(c.hit, c.fail, c.exp, base100, minStrongN, totRes)
            if not na(lift) and lift > 0 and rs > bestSingleRS
                bestSingleRS := rs
                bestSingleI  := i
        int   bestComboI  = -1
        float bestComboRS = -1.0
        for i = 0 to array.size(combos) - 1
            Cand c = array.get(combos, i)
            int   n    = c.hit + c.fail + c.exp
            float lift = f_liftV(c.hit, c.fail, base100)
            float cov  = f_covV(c.hit, c.fail, c.exp, totRes)
            if n >= minReliableN and cov >= coverageFloor and not na(lift) and lift >= 5.0
                float rs = f_rScoreV(c.hit, c.fail, c.exp, base100, minStrongN, totRes)
                if rs > bestComboRS
                    bestComboRS := rs
                    bestComboI  := i
        string bestSingleStr = bestSingleI < 0 ? "—" : array.get(singles, bestSingleI).label + " (" + f_liftStr(f_liftV(array.get(singles, bestSingleI).hit, array.get(singles, bestSingleI).fail, base100)) + ")"
        string bestComboStr  = bestComboI < 0 ? "—" : array.get(combos, bestComboI).label + "&" + array.get(combos, bestComboI).cond2 + " (" + f_liftStr(f_liftV(array.get(combos, bestComboI).hit, array.get(combos, bestComboI).fail, base100)) + ")"
        float bestCov = bestSingleI < 0 ? na : f_covV(array.get(singles, bestSingleI).hit, array.get(singles, bestSingleI).fail, array.get(singles, bestSingleI).exp, totRes)
        f_resMetric(res, 2,  "Baseline Hit Rate",     baseStr)
        f_resMetric(res, 3,  "Total Predictions",     str.tostring(totCreated))
        f_resMetric(res, 4,  "Resolved Predictions",  str.tostring(totRes))
        f_resMetric(res, 5,  "Feature candidates",    str.tostring(array.size(singles)))
        f_resMetric(res, 6,  "Combinations tested",   str.tostring(array.size(combos)))
        f_resMetric(res, 7,  "Strong / Promising",    str.tostring(cntStrong) + " / " + str.tostring(cntPromising))
        f_resMetric(res, 8,  "Negative / Low-N",      str.tostring(cntNegative) + " / " + str.tostring(cntLowN))
        f_resMetric(res, 9,  "Best single feature",   bestSingleStr)
        f_resMetric(res, 10, "Best combination",      bestComboStr)
        f_resMetric(res, 11, "Highest reliable lift", f_liftStr(highRelLift))
        f_resMetric(res, 12, "Coverage of best",      f_pctF(bestCov))
    else if researchView == "Top Features"
        f_resHdr9(res, 2, "#", "Feature", "Group", "N", "Hit%", "Lift", "Cov", "RScr", "Class")
        array<int> top = f_rankSingles(singles, 5, maxPerFamily, base100, totRes, minReliableN, minStrongN, coverageFloor)
        for m = 0 to array.size(top) - 1
            Cand c = array.get(singles, array.get(top, m))
            int cf = c.fam
            string famN = cf == 0 ? "Score" : cf == 1 ? "Support" : cf == 2 ? "Direction" : cf == 3 ? "ClusterW" : cf == 4 ? "TargetD" : cf == 5 ? "XA" : "BC"
            f_resRow9(res, 3 + m, str.tostring(m + 1), famN, c.label, c.hit, c.fail, c.exp, base100, totRes, minReliableN, minStrongN, coverageFloor)
        if array.size(top) == 0
            f_resMetric(res, 3, "No positive candidates", "—")
    else if researchView == "Negative Features"
        f_resHdr9(res, 2, "", "Feature", "Group", "N", "Hit%", "Lift", "Cov", "RScr", "Class")
        array<int> neg = f_rankNeg(singles, 5, base100, totRes, minReliableN, coverageFloor)
        for m = 0 to array.size(neg) - 1
            Cand c = array.get(singles, array.get(neg, m))
            int cf = c.fam
            string famN = cf == 0 ? "Score" : cf == 1 ? "Support" : cf == 2 ? "Direction" : cf == 3 ? "ClusterW" : cf == 4 ? "TargetD" : cf == 5 ? "XA" : "BC"
            f_resRow9(res, 3 + m, "", famN, c.label, c.hit, c.fail, c.exp, base100, totRes, minReliableN, minStrongN, coverageFloor)
        if array.size(neg) == 0
            f_resMetric(res, 3, "No reliable negatives", "—")
    else if researchView == "Top Combinations"
        f_resHdr9(res, 2, "#", "Cond1", "Cond2", "N", "Hit%", "Lift", "Cov", "RScr", "Class")
        array<int> topc = f_rankCombos(combos, 5, maxPerFamily, base100, totRes, minReliableN, minStrongN, coverageFloor)
        for m = 0 to array.size(topc) - 1
            Cand c = array.get(combos, array.get(topc, m))
            f_resRow9(res, 3 + m, str.tostring(m + 1), c.label, c.cond2, c.hit, c.fail, c.exp, base100, totRes, minReliableN, minStrongN, coverageFloor)
        if array.size(topc) > 0
            Cand c0 = array.get(combos, array.get(topc, 0))
            float cLift = f_liftV(c0.hit, c0.fail, base100)
            [h1, f1, e1] = f_condCounts(c0.kindA, c0.lvlA)
            [h2, f2, e2] = f_condCounts(c0.kindB, c0.lvlB)
            float l1 = f_liftV(h1, f1, base100)
            float l2 = f_liftV(h2, f2, base100)
            float comp = math.max(na(l1) ? -1000000.0 : l1, na(l2) ? -1000000.0 : l2)
            float benefit = (na(cLift) or comp <= -1000000.0) ? na : cLift - comp
            f_resMetric(res, 4 + array.size(topc), "Best Combo Benefit", f_liftStr(benefit))
        if array.size(topc) == 0
            f_resMetric(res, 3, "No combos pass guardrails", "—")
    else if researchView == "Stability"
        f_resHdr9(res, 2, "Family", "Group", "N", "", "", "Lift", "", "", "Stab")
        int rr = 3
        rr := f_resStab(res, rr, 0, "Score",    singles, base100)
        rr := f_resStab(res, rr, 1, "Support",  singles, base100)
        rr := f_resStab(res, rr, 4, "TargetD",  singles, base100)
        rr := f_resStab(res, rr, 3, "ClusterW", singles, base100)
    else
        f_resHdr9(res, 2, "#", "Feature", "Group", "N", "Hit%", "Lift", "Cov", "RScr", "Class")
        array<int> rec = f_rankSingles(singles, 3, maxPerFamily, base100, totRes, minReliableN, minStrongN, coverageFloor)
        int shown = 0
        int rrow  = 3
        for m = 0 to array.size(rec) - 1
            Cand c = array.get(singles, array.get(rec, m))
            int cls = f_classV(c.hit, c.fail, c.exp, base100, minReliableN, minStrongN, coverageFloor, totRes)
            if cls == 2 or cls == 1
                int cf = c.fam
                string famN = cf == 0 ? "Score" : cf == 1 ? "Support" : cf == 2 ? "Direction" : cf == 3 ? "ClusterW" : cf == 4 ? "TargetD" : cf == 5 ? "XA" : "BC"
                f_resRow9(res, rrow, str.tostring(shown + 1), famN, c.label, c.hit, c.fail, c.exp, base100, totRes, minReliableN, minStrongN, coverageFloor)
                rrow  += 1
                shown += 1
        f_resMetric(res, rrow, "Next step", "Forward test only — do not activate")
        rrow += 1
        table.cell(res, 0, rrow, "NOT SUPPORTED", text_color = color.yellow, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_left)
        for c = 1 to 8
            table.cell(res, c, rrow, "", bgcolor = RES_SECT)
        rrow += 1
        array<int> rej = f_rankNeg(singles, 3, base100, totRes, minReliableN, coverageFloor)
        for m = 0 to array.size(rej) - 1
            Cand c = array.get(singles, array.get(rej, m))
            int cf = c.fam
            string famN = cf == 0 ? "Score" : cf == 1 ? "Support" : cf == 2 ? "Direction" : cf == 3 ? "ClusterW" : cf == 4 ? "TargetD" : cf == 5 ? "XA" : "BC"
            f_resRow9(res, rrow, "", famN, c.label, c.hit, c.fail, c.exp, base100, totRes, minReliableN, minStrongN, coverageFloor)
            rrow += 1
        if shown == 0 and array.size(rej) == 0
            f_resMetric(res, rrow, "No candidates", "—")

// =============================================================================
// CONFIDENCE DASHBOARD (sol üst; yalnızca son barda)
// =============================================================================
var table cf = na
if showConf and barstate.islast
    if na(cf)
        cf := table.new(position.top_left, 8, 17, border_width = 1, frame_width = 1, frame_color = color.rgb(70, 70, 70))

    int   cTotRes = evHit + evFail + evExp
    float avgConf     = cTotRes > 0 ? cfSumAll / cTotRes : na
    float avgConfHit  = evHit > 0 ? cfSumHit / evHit : na
    float avgConfFail = evFail > 0 ? cfSumFail / evFail : na
    float avgConfExp  = evExp > 0 ? cfSumExp / evExp : na

    // Başlık
    table.cell(cf, 0, 0, "CONFIDENCE SUMMARY", text_color = color.white, bgcolor = RES_HDR, text_size = size.normal, text_halign = text.align_left)
    for c = 1 to 7
        table.cell(cf, c, 0, "", bgcolor = RES_HDR)
    f_cfMetric(cf, 1, "Average Confidence",       na(avgConf)     ? "—" : str.tostring(avgConf, "#.#"))
    f_cfMetric(cf, 2, "Avg Confidence of Hits",   na(avgConfHit)  ? "—" : str.tostring(avgConfHit, "#.#"))
    f_cfMetric(cf, 3, "Avg Confidence of Fails",  na(avgConfFail) ? "—" : str.tostring(avgConfFail, "#.#"))
    f_cfMetric(cf, 4, "Avg Confidence of Expired",na(avgConfExp)  ? "—" : str.tostring(avgConfExp, "#.#"))

    // Kalibrasyon
    table.cell(cf, 0, 5, "CALIBRATION", text_color = color.yellow, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_left)
    for c = 1 to 7
        table.cell(cf, c, 5, "", bgcolor = RES_SECT)
    f_cfHdr(cf, 6)
    f_cfCalRow(cf, 7,  "0-20",   array.get(cfHit, 0), array.get(cfFail, 0), array.get(cfExp, 0), array.get(cfLife, 0))
    f_cfCalRow(cf, 8,  "20-40",  array.get(cfHit, 1), array.get(cfFail, 1), array.get(cfExp, 1), array.get(cfLife, 1))
    f_cfCalRow(cf, 9,  "40-60",  array.get(cfHit, 2), array.get(cfFail, 2), array.get(cfExp, 2), array.get(cfLife, 2))
    f_cfCalRow(cf, 10, "60-80",  array.get(cfHit, 3), array.get(cfFail, 3), array.get(cfExp, 3), array.get(cfLife, 3))
    f_cfCalRow(cf, 11, "80-100", array.get(cfHit, 4), array.get(cfFail, 4), array.get(cfExp, 4), array.get(cfLife, 4))

    // Reliability
    table.cell(cf, 0, 12, "RELIABILITY", text_color = color.yellow, bgcolor = RES_SECT, text_size = size.small, text_halign = text.align_left)
    for c = 1 to 7
        table.cell(cf, c, 12, "", bgcolor = RES_SECT)
    float corr = na
    float denomX = cfN * cfSxx - cfSx * cfSx
    float denomY = cfN * cfSyy - cfSy * cfSy
    if cfN > 1 and denomX > 0 and denomY > 0
        corr := (cfN * cfSxy - cfSx * cfSy) / math.sqrt(denomX * denomY)
    float confLift = (na(avgConfHit) or na(avgConfFail)) ? na : avgConfHit - avgConfFail
    string scStr = ""
    for b = 0 to 5
        int cnt = array.get(anSc_hit, b) + array.get(anSc_fail, b) + array.get(anSc_exp, b)
        float av = cnt > 0 ? array.get(cfScSum, b) / cnt : na
        scStr := scStr + (b == 0 ? "" : "/") + (na(av) ? "-" : str.tostring(av, "#"))
    string spStr = ""
    for b = 0 to 3
        int cnt = array.get(anSp_hit, b) + array.get(anSp_fail, b) + array.get(anSp_exp, b)
        float av = cnt > 0 ? array.get(cfSpSum, b) / cnt : na
        spStr := spStr + (b == 0 ? "" : "/") + (na(av) ? "-" : str.tostring(av, "#"))
    f_cfMetric(cf, 13, "Corr(Conf, Success)",    na(corr) ? "—" : str.tostring(corr, "#.##"))
    f_cfMetric(cf, 14, "Avg Conf Lift (Hit-Fail)", na(confLift) ? "—" : (confLift >= 0 ? "+" : "") + str.tostring(confLift, "#.#"))
    f_cfMetric(cf, 15, "Avg Conf by Score", scStr)
    f_cfMetric(cf, 16, "Avg Conf by Support", spStr)

// =============================================================================
// AÇIKLAMA
// -----------------------------------------------------------------------------
// ÜRETİM: her yeni confirmed pivot (yeni C) bar-close event'inde XABC doğrulanır,
//   XA/BC projeksiyonları hesaplanır, adaptif tolerans + minimum support ile
//   kümelenir; Primary D Target bulunursa bir SNAPSHOT kayıt (records) yazılır.
// KALICILIK: records asla silinmez/yeniden hesaplanmaz. Yeni prediction gelince
//   eski kayıt SİLİNMEZ; yalnızca display modu gerektirirse eski ÇİZİM budanır.
// GÖRÜNTÜLEME: Latest only (1) / All historical (obje limitli üst sınır) /
//   Last N predictions (histCount). Mod yalnızca ÇİZİMİ sınırlar; kayıtları,
//   üretimi veya ileride yapılacak accuracy ölçümünü ETKİLEMEZ.
// OBJE LİMİTİ: max_boxes_count/max_labels_count = 500. drawn kuyruğu maxDrawn'ı
//   aşınca en eski ÇİZİM nesneleri silinir (kayıt korunur).
// DUPLICATE: aynı X-A-B-C bar imzası tekrar üretilmez (atlananlar sayılır).
// REPAINT YOK: motor yalnızca barstate.isconfirmed'de ilerler; her kutu
//   oluştuğu (confirmed C) bardan itibaren, x1 = o anki bar_index ile çizilir;
//   geçmişe gelecek bilgisi taşınmaz; request.security/lookahead yok.
// =============================================================================
