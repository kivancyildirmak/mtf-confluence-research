//@version=6
// =============================================================================
// HARMONIC PREDICTION ENGINE — D oluşmadan olası D fiyatlarını geleceğe projekte eder
// -----------------------------------------------------------------------------
// Bu proje ARTIK geçmiş harmonic pattern'ları gösteren bir indikatör DEĞİLDİR.
// Tek amaç: son confirmed X-A-B-C yapısından, D HENÜZ OLUŞMADAN, olası D fiyatlarını
// Fibonacci ile GELECEĞE SABİT projeksiyon çizgileri olarak göstermek.
//
// GRAFİKTE YALNIZCA: X/A/B/C harfleri + C barından sağa uzanan D projeksiyon
//   çizgileri + her çizginin Fibonacci oran etiketi. Başka HİÇBİR şey yok:
//   tablo/M2S/trend/HH-HL-LH-LL/zigzag/debug/pattern adı/PRZ/confidence/entry-exit YOK.
//
// KORUNAN ALTYAPI (yalnızca prediction'ı besler; ÇİZİLMEZ): repaint-safe
//   "Dual-Tracker Confirmed Deviation ZigZag" pivot motoru + Pivot veri yapısı +
//   ring buffer + yalnızca barstate.isconfirmed içinde state ilerletme.
//
// Kod sonundaki AÇIKLAMA bloğu: XABC doğrulaması, prediction üretim anı, XA/BC
//   formülleri ve neden repaint olmadığı.
// =============================================================================

indicator("Harmonic Prediction Engine", overlay = true, max_lines_count = 500, max_labels_count = 500)

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Pivot Engine")
pivK        = input.float(3.0, "Pivot sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = "Pivot Engine")
pivMinBars  = input.int(8,     "Pivot minimum bar",         minval = 1, group = "Pivot Engine")

grpPred     = "Prediction"
projLen     = input.int(50, "Projeksiyon uzunluğu (bar)", minval = 5, group = grpPred)
histMode    = input.string("Latest only", "Historical predictions", options = ["Latest only", "Keep last 5", "Keep last 10"], group = grpPred)
colXA       = input.color(color.aqua,   "XA çizgi rengi", group = grpPred)
colBC       = input.color(color.orange, "BC çizgi rengi", group = grpPred)
showPrice   = input.bool(false, "Etikette fiyatı da göster", group = grpPred)

grpFilt     = "XABC Geçerlilik Filtreleri"
abXaMin     = input.float(0.25, "AB/XA min", step = 0.01, group = grpFilt)
abXaMax     = input.float(0.90, "AB/XA max", step = 0.01, group = grpFilt)
bcAbMin     = input.float(0.30, "BC/AB min", step = 0.01, group = grpFilt)
bcAbMax     = input.float(2.00, "BC/AB max", step = 0.01, group = grpFilt)

keepCount = histMode == "Keep last 5" ? 5 : histMode == "Keep last 10" ? 10 : 1

// =============================================================================
// Veri yapıları (KORUNAN ALTYAPI)
// =============================================================================
// Onaylanmış pivot. kind: +1 = HIGH (tepe), -1 = LOW (dip).
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Pivot motoru durumu (state machine).
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// Bir prediction grubunun tüm çizim nesneleri (grup bazlı silme için).
type PredGroup
    array<line>  lines
    array<label> labels

// =============================================================================
// Repaint-safe pivot motoru (KORUNAN ALTYAPI — davranış değişmedi)
// -----------------------------------------------------------------------------
// "Dual-Tracker Confirmed Deviation ZigZag": bir uç, fiyat ondan (dondurulmuş)
// theta = k*ATR kadar TERS çekildiğinde VE en az minBars kapanmış bar geçince
// KESİNLEŞİR. Konservatif bar-içi kural: aynı mumda hem yeni ekstrem hem ters
// sapma oluşursa o barda onay verilmez. Yalnızca KAPANMIŞ barlarda çağrılır.
// =============================================================================
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// Prediction yardımcıları
// =============================================================================

// XABC geçerlilik kontrolü (oranlar GRAFİKTE gösterilmez; yalnızca filtre).
f_xabc_valid(Pivot X, Pivot A, Pivot B, Pivot C) =>
    bool chrono = X.bidx < A.bidx and A.bidx < B.bidx and B.bidx < C.bidx
    bool alt    = X.kind != A.kind and A.kind != B.kind and B.kind != C.kind
    bool form   = (X.kind == -1 and A.kind == 1 and B.kind == -1 and C.kind == 1) or (X.kind == 1 and A.kind == -1 and B.kind == 1 and C.kind == -1)
    float xa = math.abs(A.price - X.price)
    float ab = math.abs(B.price - A.price)
    float bc = math.abs(C.price - B.price)
    bool legs = xa > 0 and ab > 0 and bc > 0
    bool ratios = false
    if legs
        float abXa = ab / xa
        float bcAb = bc / ab
        ratios := abXa >= abXaMin and abXa <= abXaMax and bcAb >= bcAbMin and bcAb <= bcAbMax
    chrono and alt and form and legs and ratios

// Bir pivotu harf etiketiyle işaretler ve label'ı döndürür.
f_mark(int bidx, float price, string txt) =>
    label.new(bidx, price, txt, xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 25), textcolor = color.white, size = size.small,
         force_overlay = true)

// Bir D seviyesi için projeksiyon çizgisi + oran etiketi (gruba eklenir).
f_proj(PredGroup g, int x1, int x2, float d, float r, color col, string suffix) =>
    array.push(g.lines, line.new(x1, d, x2, d, xloc = xloc.bar_index, color = col, width = 1, force_overlay = true))
    string txt = str.tostring(r, "#.###") + " " + suffix + (showPrice ? "  " + str.tostring(d, format.mintick) : "")
    array.push(g.labels, label.new(x2, d, txt, xloc = xloc.bar_index, style = label.style_label_left,
         color = color.new(col, 80), textcolor = col, size = size.tiny, force_overlay = true))

// Bir prediction grubunun tüm nesnelerini güvenle siler.
f_group_delete(PredGroup g) =>
    if array.size(g.lines) > 0
        for ln in g.lines
            line.delete(ln)
        array.clear(g.lines)
    if array.size(g.labels) > 0
        for lb in g.labels
            label.delete(lb)
        array.clear(g.labels)

// =============================================================================
// Motor örneği + confirmed pivot ring buffer (KORUNAN ALTYAPI, çizilmez)
// =============================================================================
var Engine        pivEng = f_engine_new()
var array<Pivot>  pivots = array.new<Pivot>()
BUFFER_MAX = 16

atr = ta.atr(atrLen)

// REPAINT GÜVENLİĞİ: motor yalnızca KAPANMIŞ barda ilerler.
Pivot newPiv = na
if barstate.isconfirmed
    newPiv := f_engine_step(pivEng, pivK, pivMinBars, atr)
    if not na(newPiv)
        array.push(pivots, newPiv)
        if array.size(pivots) > BUFFER_MAX
            array.shift(pivots)

// =============================================================================
// PREDICTION ENGINE
// -----------------------------------------------------------------------------
// Fibonacci oranları. Formüller (yön-bağımsız):
//   XA projection: D = A - r*(A-X)   |   BC projection: D = C - r*(C-B)
// Sonuç MUTLAKA yön filtresinden geçer:
//   L-H-L-H (X dip)  -> yalnızca D < C    |   H-L-H-L (X tepe) -> yalnızca D > C
// =============================================================================
var array<float> xaRatios = array.from(0.786, 0.886, 1.000, 1.130, 1.272, 1.618)
var array<float> bcRatios = array.from(1.272, 1.414, 1.618, 2.000, 2.240, 2.618, 3.140, 3.618)

// Aktif prediction grupları (en yeni sonda). Grup bazlı saklanır/silinir.
var array<PredGroup> groups = array.new<PredGroup>()

// Yeni confirmed pivot (yeni C) geldiğinde: doğrula, hesapla, çiz (bir kez).
if not na(newPiv) and array.size(pivots) >= 4
    int n = array.size(pivots)
    Pivot X = array.get(pivots, n - 4)
    Pivot A = array.get(pivots, n - 3)
    Pivot B = array.get(pivots, n - 2)
    Pivot C = array.get(pivots, n - 1)

    if f_xabc_valid(X, A, B, C)
        // Yapı yönü: L-H-L-H (X dip) -> D aşağı (D<C) ; H-L-H-L (X tepe) -> D yukarı (D>C).
        bool wantDown = X.kind == -1

        PredGroup g = PredGroup.new(array.new<line>(), array.new<label>())

        // X A B C harfleri (yalnızca bunlar + geçerli projeksiyonlar).
        array.push(g.labels, f_mark(X.bidx, X.price, "X"))
        array.push(g.labels, f_mark(A.bidx, A.price, "A"))
        array.push(g.labels, f_mark(B.bidx, B.price, "B"))
        array.push(g.labels, f_mark(C.bidx, C.price, "C"))

        float xaDelta = A.price - X.price
        float bcDelta = C.price - B.price
        int   x1 = C.bidx
        int   x2 = C.bidx + projLen

        // XA retracement tabanlı D seviyeleri (yön filtresi ile).
        for i = 0 to array.size(xaRatios) - 1
            float r = array.get(xaRatios, i)
            float d = A.price - r * xaDelta
            bool ok = wantDown ? d < C.price : d > C.price
            if ok
                f_proj(g, x1, x2, d, r, colXA, "XA")

        // BC extension tabanlı D seviyeleri (yön filtresi ile).
        for i = 0 to array.size(bcRatios) - 1
            float r = array.get(bcRatios, i)
            float d = C.price - r * bcDelta
            bool ok = wantDown ? d < C.price : d > C.price
            if ok
                f_proj(g, x1, x2, d, r, colBC, "BC")

        // Grubu ekle; historical moda göre eski grupları sil.
        array.push(groups, g)
        while array.size(groups) > keepCount
            PredGroup old = array.shift(groups)
            f_group_delete(old)

// =============================================================================
// AÇIKLAMA
// -----------------------------------------------------------------------------
// XABC nasıl doğrulanır (f_xabc_valid):
//   - kronoloji: X.bidx < A.bidx < B.bidx < C.bidx
//   - alternasyon + biçim: dizi tam olarak L-H-L-H veya H-L-H-L
//   - leg>0: |A-X|, |B-A|, |C-B| > 0
//   - oran filtreleri: AB/XA ∈ [abXaMin,abXaMax], BC/AB ∈ [bcAbMin,bcAbMax]
//   Geçersizse hiçbir prediction çizilmez. Oranlar grafikte gösterilmez.
//
// Prediction ne zaman üretilir:
//   Yalnızca YENİ confirmed pivot (yeni C) geldiği bar-close event'inde, bir kez.
//   Üretim ve çizim AYNI event'te olur. Yeni pivot yoksa aktif prediction yeniden
//   hesaplanmaz. D'nin gerçekten oluşması beklenmez.
//
// XA / BC formülleri (yön-bağımsız), sonra yön filtresi:
//   D_XA = A - r*(A-X) ;  D_BC = C - r*(C-B)
//   L-H-L-H -> yalnızca D < C ;  H-L-H-L -> yalnızca D > C.
//
// Neden repaint olmaz:
//   - Motor yalnızca barstate.isconfirmed (KAPANMIŞ bar) içinde ilerler; pivot
//     onaylanınca bidx/price sabittir.
//   - Prediction confirmed C anında bir kez hesaplanır; X/A/B/C ve D fiyatları
//     ile başlangıç barları sonradan yeniden hesaplanmaz/taşınmaz.
//   - request.security ve lookahead KULLANILMAZ; geleceği bilen hesap yoktur.
//   - Historical gruplar bir daha güncellenmez; yalnızca (pruning'de) silinir.
// =============================================================================
