//@version=6
// =============================================================================
// HARMONIC PREDICTION ENGINE — Historical Prediction Display
// -----------------------------------------------------------------------------
// AMAÇ: confirmed XABC anında üretilen "Primary D Target" prediction'larını
//   geçmişte BAR BAR üretip, her birini SNAPSHOT kayıt olarak saklamak ve
//   seçilen görüntüleme moduna göre çizmek. Böylece geçmiş prediction'ların
//   gerçekten oluştuğu görsel olarak doğrulanabilir.
//
// KORUNAN ALTYAPI (davranış değişmedi): repaint-safe pivot motoru, XABC
//   doğrulaması, XA/BC projection hesapları, P0 cluster/confluence motoru,
//   adaptif tolerans, minimum support ve Primary D Target mantığı.
//
// BU SÜRÜMDE YOK (henüz): strategy(), entry/exit, HIT/FAILED/EXPIRED, trade logic.
//   Yalnızca historical prediction ÜRETİMİ ve GÖRÜNTÜLEME davranışı.
//
// REPAINT/TEST GÜVENLİĞİ: motor yalnızca barstate.isconfirmed içinde ilerler;
//   her kutu, prediction'ın OLUŞTUĞU (confirmed C) bardan itibaren çizilir;
//   geçmişe gelecek bilgisi taşınmaz; request.security/lookahead yok; kayıtlar
//   bir daha hesaplanmaz.
// =============================================================================

indicator("Harmonic Prediction Engine", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Pivot Engine")
pivK        = input.float(3.0, "Pivot sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = "Pivot Engine")
pivMinBars  = input.int(8,     "Pivot minimum bar",         minval = 1, group = "Pivot Engine")

grpPred     = "Prediction / Cluster"
projLen     = input.int(50, "Kutu uzunluğu (bar)",        minval = 5, group = grpPred)
patternTolPct = input.float(0.50, "Pattern tolerance (% of XA)", minval = 0.01, maxval = 5.0, step = 0.01, group = grpPred)
atrFloorMult  = input.float(0.10, "ATR floor multiplier",         minval = 0.0,  step = 0.01, group = grpPred)
minTolTicks   = input.int(5,      "Minimum tolerance ticks",      minval = 1, group = grpPred)
minSupport    = input.int(2,      "Minimum projections per cluster", minval = 2, group = grpPred)
showSecond  = input.bool(false, "Secondary D Target göster (yalnız görsel)", group = grpPred)
showSources = input.bool(false, "Kutuda kaynakları göster (XA/BC ratio)", group = grpPred)
colPrimary  = input.color(color.new(color.lime,   0), "Primary kutu rengi",   group = grpPred)
colSecond   = input.color(color.new(color.orange, 0), "Secondary kutu rengi", group = grpPred)

grpFilt     = "XABC Geçerlilik Filtreleri"
abXaMin     = input.float(0.25, "AB/XA min", step = 0.01, group = grpFilt)
abXaMax     = input.float(0.90, "AB/XA max", step = 0.01, group = grpFilt)
bcAbMin     = input.float(0.30, "BC/AB min", step = 0.01, group = grpFilt)
bcAbMax     = input.float(2.00, "BC/AB max", step = 0.01, group = grpFilt)

grpView     = "Görünüm / Historical"
histDisplay = input.string("All historical", "Historical display mode", options = ["Latest only", "All historical", "Last N predictions"], group = grpView)
histCount   = input.int(50, "Historical prediction count", minval = 1, group = grpView)
showXABC    = input.bool(false, "X/A/B/C harflerini göster", group = grpView)
showDebug   = input.bool(false, "Debug tablo göster (sağ alt)", group = grpView)

grpEval       = "Evaluation Engine"
failMode      = input.string("C ± ATR", "Failure Mode", options = ["C ± ATR", "X Pivot", "None"], group = grpEval)
evalAtrMult   = input.float(0.50, "ATR Multiplier", minval = 0.0, step = 0.05, group = grpEval)
maxActiveBars = input.int(50, "Maximum Active Bars", minval = 1, group = grpEval)
ambigMode     = input.string("Conservative", "Ambiguous Handling", options = ["Conservative", "Optimistic", "Ignore"], group = grpEval)
showEval      = input.bool(true, "Evaluation dashboard göster (sağ üst)", group = grpEval)

grpAn         = "Prediction Analytics"
analyticsView = input.string("Evaluation Summary", "Analytics View", options = ["Evaluation Summary", "Score Thresholds", "Support Thresholds", "Direction", "Cluster Width", "Target Distance", "XA Scale", "BC Ratio"], group = grpAn)
minReliableN  = input.int(20, "Minimum Reliable Sample", minval = 1, group = grpAn)
showAnalytics = input.bool(true, "Show Analytics Dashboard (sol alt)", group = grpAn)

grpRes         = "Prediction Research"
researchView   = input.string("Research Summary", "Research View", options = ["Research Summary", "Top Features", "Negative Features", "Top Combinations", "Stability", "Recommendations"], group = grpRes)
minStrongN     = input.int(50, "Minimum Strong Sample", minval = 1, group = grpRes)
coverageFloor  = input.float(10.0, "Coverage Floor (%)", minval = 0.0, step = 1.0, group = grpRes)
maxPerFamily   = input.int(2, "Maximum Results Per Feature Family", minval = 1, group = grpRes)
showResearch   = input.bool(true, "Show Research Dashboard (alt orta)", group = grpRes)

grpConf      = "Confidence Engine"
confGain     = input.float(2.0, "Confidence spread (gain)", minval = 0.5, maxval = 5.0, step = 0.1, group = grpConf)
showConfBox  = input.bool(true, "Kutuda Confidence göster", group = grpConf)
showConf     = input.bool(true, "Show Confidence Dashboard (sol üst)", group = grpConf)

// =============================================================================
// Veri yapıları
// =============================================================================
// Onaylanmış pivot. kind: +1 = HIGH (tepe), -1 = LOW (dip).
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Pivot motoru durumu (state machine).
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// Tek bir ham projeksiyon seviyesi. src: 0 = XA, 1 = BC.
type Proj
    float price
    int   src
    float ratio

// Bir prediction'ın çizim nesneleri (grup bazlı gizleme/silme için).
type PredGroup
    array<label> labels
    array<box>   boxes

// Prediction SNAPSHOT kaydı. Oluşturulunca yazılır, bir daha DEĞİŞMEZ/SİLİNMEZ.
// direction: +1 = D yukarıda (H-L-H-L), -1 = D aşağıda (L-H-L-H).
type PredRec
    int   id
    int   creationBar
    int   pivotCBar
    int   direction
    float targetLow
    float targetHigh
    float centerPrice
    float score
    int   support
    PredGroup viz        // canlı çizim nesneleri (yoksa boş/na)
    // --- Evaluation Engine snapshot alanları (oluşumda yazılır, bir daha değişmez) ---
    int   status             // 0 ACTIVE, 1 HIT, 2 FAILED, 3 EXPIRED
    int   resolvedBar        // çözüldüğü bar (na = henüz ACTIVE)
    float resultPrice        // çözümü tetikleyen fiyat (hedef / invalidation / expire close)
    int   barsAlive          // resolvedBar - creationBar
    float invalidationPrice  // FAILED seviyesi (snapshot; na = invalidation yok)
    float creationATR        // oluşum anındaki ATR (snapshot)
    // --- Analytics snapshot alanları (oluşumda dondurulur, pasif; algoritmayı etkilemez) ---
    float clusterSpread
    float clusterTolerance
    float normalizedClusterWidth
    float xaLength
    float bcLength
    float xaAtrMultiple
    float bcAtrMultiple
    float abXaRatio
    float bcAbRatio
    float targetDistance
    float targetDistanceATR
    float targetDistanceXA
    // --- Confidence Engine (oluşum anında, yalnız geçmiş istatistikten; dondurulur) ---
    float confidence

// Research Engine aday temsili (yalnızca son barda, sıralama/sınıflandırma için).
// fam: 0 Score 1 Support 2 Direction 3 ClusterWidth 4 TargetDist 5 XA 6 BC 7 Combo
// Tekil adayda kindB = -1. kind kodları: 0 Score,1 Support,2 TargetDist,3 ClusterWidth,4 Direction.
type Cand
    int    fam
    int    ord
    string label
    string cond2
    int    kindA
    int    lvlA
    int    kindB
    int    lvlB
    int    hit
    int    fail
    int    exp

// =============================================================================
// Repaint-safe pivot motoru (KORUNAN ALTYAPI — davranış değişmedi)
// -----------------------------------------------------------------------------
// "Dual-Tracker Confirmed Deviation ZigZag": bir uç, fiyat ondan (dondurulmuş)
// theta = k*ATR kadar TERS çekildiğinde VE en az minBars kapanmış bar geçince
// KESİNLEŞİR. Konservatif bar-içi kural: aynı mumda hem yeni ekstrem hem ters
// sapma oluşursa o barda onay verilmez. Yalnızca KAPANMIŞ barlarda çağrılır.
// =============================================================================
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// Prediction / Cluster yardımcıları (KORUNAN ALTYAPI)
// =============================================================================

// XABC geçerlilik kontrolü (oranlar GRAFİKTE gösterilmez; yalnızca filtre).
f_xabc_valid(Pivot X, Pivot A, Pivot B, Pivot C) =>
    bool chrono = X.bidx < A.bidx and A.bidx < B.bidx and B.bidx < C.bidx
    bool alt    = X.kind != A.kind and A.kind != B.kind and B.kind != C.kind
    bool form   = (X.kind == -1 and A.kind == 1 and B.kind == -1 and C.kind == 1) or (X.kind == 1 and A.kind == -1 and B.kind == 1 and C.kind == -1)
    float xa = math.abs(A.price - X.price)
    float ab = math.abs(B.price - A.price)
    float bc = math.abs(C.price - B.price)
    bool legs = xa > 0 and ab > 0 and bc > 0
    bool ratios = false
    if legs
        float abXa = ab / xa
        float bcAb = bc / ab
        ratios := abXa >= abXaMin and abXa <= abXaMax and bcAb >= bcAbMin and bcAb <= bcAbMax
    chrono and alt and form and legs and ratios

// En YÜKSEK SKORLU kümeyi bulur (used=true olanlar hariç). Skor = ağırlıklı:
//   + farklı ratio sayısı (aynı ratio tekrarına ekstra yok)
//   + XA ve BC birlikte varsa mix bonusu (+2)  (yalnız-BC / yalnız-XA daha düşük)
//   + sıkılık bonusu: 2*max(0, 1 - spread/(2*tol))  (spread=0→2, =tol→1, =2*tol→0)
// Bir küme aday olabilmek için en az minSupport DISTINCT projeksiyon içermelidir
//   (aynı fiyat+aynı oran kopyası ayrı destek saymaz). Uygun küme yoksa bestIdx=-1.
// DÖNÜŞ: [merkezIndex, skor, altFiyat, üstFiyat, destekSayısı].
f_best_cluster(array<Proj> projs, array<bool> used, float tol, int minSupport) =>
    int   nD = array.size(projs)
    int   bestIdx = -1
    float bestScore = -1.0
    float bestLo = na
    float bestHi = na
    int   bestSupport = 0
    // Sıfıra bölünmeye karşı güvenli alt sınır (tol zaten tickFloor ile > 0'dır).
    float safeTol = math.max(tol, syminfo.mintick)
    for i = 0 to nD - 1
        if not array.get(used, i)
            float center = array.get(projs, i).price
            float lo = na
            float hi = na
            bool  hasXA = false
            bool  hasBC = false
            int   distinct = 0
            int   support  = 0
            for j = 0 to nD - 1
                if not array.get(used, j)
                    Proj pj = array.get(projs, j)
                    if math.abs(pj.price - center) <= tol
                        lo := na(lo) ? pj.price : math.min(lo, pj.price)
                        hi := na(hi) ? pj.price : math.max(hi, pj.price)
                        if pj.src == 0
                            hasXA := true
                        else
                            hasBC := true
                        bool firstOfRatio  = true
                        bool firstOfMember = true
                        for k = 0 to j - 1
                            if not array.get(used, k)
                                Proj pk = array.get(projs, k)
                                if math.abs(pk.price - center) <= tol
                                    if pk.ratio == pj.ratio
                                        firstOfRatio := false
                                    // Aynı fiyat VE aynı oran = kaza eseri kopya; destek saymaz.
                                    if pk.ratio == pj.ratio and pk.price == pj.price
                                        firstOfMember := false
                        if firstOfRatio
                            distinct += 1
                        if firstOfMember
                            support += 1
            float spread     = na(hi) ? 0.0 : hi - lo
            float normSpread = spread / (2.0 * safeTol)
            float tight      = 2.0 * math.max(0.0, 1.0 - normSpread)
            float score      = distinct + (hasXA and hasBC ? 2.0 : 0.0) + tight
            // En az minSupport DISTINCT projeksiyon içeren kümeler aday olabilir.
            if support >= minSupport and score > bestScore
                bestIdx     := i
                bestScore   := score
                bestLo      := lo
                bestHi      := hi
                bestSupport := support
    [bestIdx, bestScore, bestLo, bestHi, bestSupport]

// Merkez etrafındaki (tol içi, used olmayan) üyeleri işaretler ve kaynak metnini
// ("XA 0.886, BC 2.240") döndürür. Skorlama sonrası kutu metni + used için tek geçiş.
f_cluster_src_and_mark(array<Proj> projs, array<bool> used, float tol, int centerIdx) =>
    float center = array.get(projs, centerIdx).price
    string s = ""
    for j = 0 to array.size(projs) - 1
        if not array.get(used, j)
            Proj pj = array.get(projs, j)
            if math.abs(pj.price - center) <= tol
                s := s + (s == "" ? "" : ", ") + (pj.src == 0 ? "XA " : "BC ") + str.tostring(pj.ratio, "#.###")
                array.set(used, j, true)
    s

// Bir pivotu harf etiketiyle işaretler ve label'ı döndürür.
f_mark(int bidx, float price, string txt) =>
    label.new(bidx, price, txt, xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 25), textcolor = color.white, size = size.small,
         force_overlay = true)

// D-target kümesini kutu olarak çizer ve kutuyu DÖNDÜRÜR (grup çağıran tarafından yönetilir).
// conf: na değilse "Confidence NN%" satırı eklenir (yalnız Score'un YANINDA; Score değişmez).
f_target_box(int x1, int x2, float lo, float hi, float score, string title, color col, float atrv, string srcText, float conf) =>
    float pad = (hi - lo) < atrv * 0.05 ? atrv * 0.20 : 0.0
    string txt = title + "\n" + str.tostring(lo, format.mintick) + " – " + str.tostring(hi, format.mintick) + "\nScore " + str.tostring(score, "#.#")
    if showConfBox and not na(conf)
        txt := txt + "\nConfidence " + str.tostring(conf, "#") + "%"
    if showSources and str.length(srcText) > 0
        txt := txt + "\n" + srcText
    box.new(x1, hi + pad, x2, lo - pad, border_color = col, bgcolor = color.new(col, 82),
         text = txt, text_color = col, text_size = size.small,
         text_halign = text.align_left, text_valign = text.align_center, force_overlay = true)

// Bir prediction grubunun tüm ÇİZİM nesnelerini güvenle siler (KAYIT silinmez).
f_group_delete(PredGroup g) =>
    if array.size(g.labels) > 0
        for lb in g.labels
            label.delete(lb)
        array.clear(g.labels)
    if array.size(g.boxes) > 0
        for bx in g.boxes
            box.delete(bx)
        array.clear(g.boxes)

// Debug tabloya bir "etiket | değer" satırı yazar.
f_drow(table t, int r, string lbl, string val, color bg) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = bg, text_size = size.small, text_halign = text.align_right)

// =============================================================================
// Evaluation Engine yardımcıları (saf; prediction algoritmasına dokunmaz)
// =============================================================================
f_scoreBucket(float s) => s < 5.0 ? 0 : s < 6.0 ? 1 : s < 7.0 ? 2 : 3
f_supBucket(int sup)   => sup <= 2 ? 0 : sup == 3 ? 1 : sup == 4 ? 2 : 3
f_pctS(int num, int den) => den > 0 ? str.tostring(100.0 * num / den, "#.#") + "%" : "—"
f_avgS(int sum, int den) => den > 0 ? str.tostring(sum / den, "#.#") : "—"

// Dashboard renk paleti (Light/Dark okunabilir, yüksek kontrast).
var color EV_TITLE  = color.rgb(35, 35, 35)
var color EV_LEFT   = color.rgb(55, 55, 55)
var color EV_RIGHT  = color.rgb(20, 20, 20)
var color EV_HIT    = color.rgb(0, 90, 0)
var color EV_FAIL   = color.rgb(120, 0, 0)
var color EV_EXP    = color.rgb(120, 70, 0)
var color EV_ACTIVE = color.rgb(0, 50, 120)
var color EV_SECT   = color.rgb(45, 45, 45)

// "etiket | değer" metrik satırı (kalan sütunlar valBg ile doldurulur, kompakt görünüm).
f_evMetric(table t, int r, string lbl, string val, color lblBg, color valBg) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = lblBg, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = valBg, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, "", bgcolor = valBg)
    table.cell(t, 3, r, "", bgcolor = valBg)
    table.cell(t, 4, r, "", bgcolor = valBg)
    table.cell(t, 5, r, "", bgcolor = valBg)

// Bölüm başlığı satırı (sarı yazı).
f_evSection(table t, int r, string title) =>
    for c = 0 to 5
        table.cell(t, c, r, c == 0 ? title : "", text_color = color.yellow, bgcolor = EV_SECT, text_size = size.small, text_halign = text.align_left)

// Analiz alt-tablosu başlık satırı.
f_evAnalyseHdr(table t, int r) =>
    table.cell(t, 0, r, "Group", text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, "N",     text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, "Hit",   text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3, r, "Fail",  text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, "Exp",   text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, "Hit%",  text_color = color.white, bgcolor = EV_TITLE, text_size = size.small, text_halign = text.align_right)

// Analiz alt-tablosu veri satırı.
f_evAnalyseRow(table t, int r, string lbl, int c, int h, int f, int e) =>
    table.cell(t, 0, r, lbl,               text_color = color.white, bgcolor = EV_LEFT,  text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, str.tostring(c),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2, r, str.tostring(h),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3, r, str.tostring(f),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4, r, str.tostring(e),   text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5, r, f_pctS(h, h + f),  text_color = color.white, bgcolor = EV_RIGHT, text_size = size.small, text_halign = text.align_right)

// =============================================================================
// PREDICTION ANALYTICS yardımcıları (pasif; prediction/evaluation'a dokunmaz)
// =============================================================================
// Bucket / bin fonksiyonları (saf).
f_scBin(float s) => s < 5.0 ? 0 : s < 5.5 ? 1 : s < 6.0 ? 2 : s < 6.5 ? 3 : s < 7.0 ? 4 : 5
f_spBin(int sup) => sup <= 2 ? 0 : sup == 3 ? 1 : sup == 4 ? 2 : 3
f_cwBin(float w) => na(w) ? 3 : w <= 0.25 ? 0 : w <= 0.50 ? 1 : w <= 1.00 ? 2 : 3
f_tdBin(float t) => na(t) ? 3 : t <= 1.0 ? 0 : t <= 2.0 ? 1 : t <= 4.0 ? 2 : 3
f_xaBin(float x) => na(x) ? 0 : x < 3.0 ? 0 : x < 6.0 ? 1 : x < 10.0 ? 2 : 3
f_bcBin(float r) => na(r) ? 0 : r < 0.382 ? 0 : r < 0.50 ? 1 : r < 0.618 ? 2 : r < 0.786 ? 3 : 4

// CONFIDENCE v2 — evidence-weighted LOG-ODDS kanıt birikimi (Naive-Bayes tarzı).
// Bir feature bucket'ının log-odds kaymasını (δ) ve kanıt ağırlığını (evidence-weighted
// feature weight) döndürür: [wNum, wDen]. Bunlar dış tarafta ağırlıklı ORTALAMA'ya girer.
//   δ  = clamp( logit(hitRate_bucket) - logit(baseline), ±dmax )   (tek feature domine edemez)
//   ev = (h+f) / ((h+f)+K)   → düşük örneklem yumuşak biçimde sönümlenir (K = prior)
//   wNum = wFeat*ev*δ , wDen = wFeat*ev
// Veri yoksa (h+f=0) katkı 0. Additif "lift/10" sıkıştırması KALDIRILDI.
f_confAcc(int h, int f, float p0, int K, float dmax, float wFeat) =>
    float wn = 0.0
    float wd = 0.0
    if (h + f) >= 1 and not na(p0) and p0 > 0.0 and p0 < 1.0
        float pb = math.max(0.02, math.min(0.98, h / (h + f)))
        float d  = math.max(-dmax, math.min(dmax, math.log(pb / (1.0 - pb)) - math.log(p0 / (1.0 - p0))))
        float ev = (h + f) / (float(h + f) + K)
        wn := wFeat * ev * d
        wd := wFeat * ev
    [wn, wd]

// Confidence kalibrasyon bini: 0:0-20 1:20-40 2:40-60 3:60-80 4:80-100.
f_confBin(float conf) => na(conf) ? 2 : conf < 20 ? 0 : conf < 40 ? 1 : conf < 60 ? 2 : conf < 80 ? 3 : 4

// Bir üçlü (hit/fail/exp) sayaç dizisinde bucket b'yi rs sonucuna göre artırır.
f_bump3(array<int> h, array<int> f, array<int> e, int b, int rs) =>
    if rs == 1
        array.set(h, b, array.get(h, b) + 1)
    else if rs == 2
        array.set(f, b, array.get(f, b) + 1)
    else
        array.set(e, b, array.get(e, b) + 1)

// start bin'den sona kümülatif toplam (threshold tabloları için).
f_cumFrom(array<int> a, int start) =>
    int s = 0
    for i = start to array.size(a) - 1
        s += array.get(a, i)
    s

// Analytics renk paleti (task 14).
var color ANA_TITLE = color.rgb(25, 25, 25)
var color ANA_HDR   = color.rgb(50, 50, 50)
var color ANA_CELL  = color.rgb(20, 20, 20)
var color ANA_LEFT  = color.rgb(55, 55, 55)
var color ANA_LOWN  = color.rgb(90, 70, 0)   // koyu sarı/kahve
var color ANA_POS   = color.rgb(0, 90, 0)    // pozitif lift
var color ANA_NEG   = color.rgb(120, 0, 0)   // negatif lift

// Analytics sütun başlığı satırı (11 sütun).
f_anHeader(table t, int r) =>
    table.cell(t, 0,  r, "Group",   text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1,  r, "N",       text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2,  r, "Hit",     text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3,  r, "Fail",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4,  r, "Exp",     text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5,  r, "ResHit%", text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6,  r, "Ovr%",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7,  r, "Cov%",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8,  r, "Lift",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 9,  r, "AvgH",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 10, r, "AvgF",    text_color = color.white, bgcolor = ANA_HDR, text_size = size.small, text_halign = text.align_right)

// Analytics veri satırı. sumHit/sumFail < 0 => AvgH/AvgF sütunu boş. base100 na olabilir.
f_anRow(table t, int r, string lbl, int h, int f, int e, int totRes, float base100, int minN, int sumHit, int sumFail) =>
    int   n     = h + f + e
    bool  lowN  = n < minN
    color cb    = lowN ? ANA_LOWN : ANA_CELL
    int   resDen = h + f
    string resStr  = resDen > 0 ? str.tostring(100.0 * h / resDen, "#.#") + "%" + (lowN ? " LOW N" : "") : "—"
    string ovStr   = n > 0 ? str.tostring(100.0 * h / n, "#.#") + "%" : "—"
    string covStr  = totRes > 0 ? str.tostring(100.0 * n / totRes, "#.#") + "%" : "—"
    float  lift    = resDen > 0 ? (100.0 * h / resDen - base100) : na
    string liftStr = na(lift) ? "—" : (lift >= 0 ? "+" : "") + str.tostring(lift, "#.#") + " pp"
    color  liftBg  = lowN ? ANA_LOWN : na(lift) ? ANA_CELL : lift > 0 ? ANA_POS : lift < 0 ? ANA_NEG : ANA_CELL
    string ahStr   = sumHit  < 0 ? "" : (h > 0 ? str.tostring(sumHit  / h, "#.#") : "—")
    string afStr   = sumFail < 0 ? "" : (f > 0 ? str.tostring(sumFail / f, "#.#") : "—")
    color  ahBg    = sumHit  < 0 ? ANA_CELL : cb
    color  afBg    = sumFail < 0 ? ANA_CELL : cb
    table.cell(t, 0,  r, lbl,             text_color = color.white, bgcolor = ANA_LEFT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1,  r, str.tostring(n), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 2,  r, str.tostring(h), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 3,  r, str.tostring(f), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 4,  r, str.tostring(e), text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 5,  r, resStr,          text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 6,  r, ovStr,           text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 7,  r, covStr,          text_color = color.white, bgcolor = cb,     text_size = size.small, text_halign = text.align_right)
    table.cell(t, 8,  r, liftStr,         text_color = color.white, bgcolor = liftBg, text_size = size.small, text_halign = text.align_right)
    table.cell(t, 9,  r, ahStr,           text_color = color.white, bgcolor = ahBg,   text_size = size.small, text_halign = text.align_right)
    table.cell(t, 10, r, afStr,           text_color = color.white, bgcolor = afBg,   text_size = size.small, text_halign = text.align_right)

// Analytics özet metrik satırı (label | value; kalan sütunlar doldurulur).
f_anMetric(table t, int r, string lbl, string val) =>
    table.cell(t, 0, r, lbl, text_color = color.white, bgcolor = ANA_LEFT, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, val, text_color = color.white, bgcolor = ANA_CELL, text_size = size.small, text_halign = text.align_right)
    for c = 2 to 10
        table.cell(t, c, r, "", bgcolor = ANA_CELL)

