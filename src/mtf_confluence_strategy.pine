//@version=6
// =============================================================================
// HARMONIC PREDICTION ENGINE — olası D bölgesini kümelenmiş TEK hedef olarak gösterir
// -----------------------------------------------------------------------------
// Amaç: son confirmed X-A-B-C yapısından, D HENÜZ OLUŞMADAN, olası D fiyatlarını
// Fibonacci ile hesapla; ham seviyeleri ÇİZME. Bunun yerine birbirine yakın
// seviyeleri fiyat toleransına göre KÜMELENDİR ve en güçlü kümeyi
// "Most Probable D Target" olarak TEK KUTU halinde göster (Primary; opsiyonel
// Secondary). Varsayılan yalnızca Primary.
//
// GRAFİKTE YALNIZCA: X/A/B/C harfleri + Primary (ve istenirse Secondary) D Target
//   kutusu. Ham XA/BC çizgileri, tablo, trend, HH/HL, zigzag, debug, pattern adı YOK.
//
// KORUNAN ALTYAPI (çizilmez): repaint-safe "Dual-Tracker Confirmed Deviation
//   ZigZag" pivot motoru + Pivot veri yapısı + ring buffer + yalnızca
//   barstate.isconfirmed içinde state ilerletme. request.security / lookahead YOK.
// =============================================================================

indicator("Harmonic Prediction Engine", overlay = true, max_labels_count = 200, max_boxes_count = 100)

// =============================================================================
// Girdiler
// =============================================================================
atrLen      = input.int(14,  "ATR uzunluğu",              minval = 1, group = "Pivot Engine")
pivK        = input.float(3.0, "Pivot sapma eşiği (× ATR)", minval = 0.1, step = 0.1, group = "Pivot Engine")
pivMinBars  = input.int(8,     "Pivot minimum bar",         minval = 1, group = "Pivot Engine")

grpPred     = "Prediction"
projLen     = input.int(50, "Kutu uzunluğu (bar)",        minval = 5, group = grpPred)
histMode    = input.string("Latest only", "Historical predictions", options = ["Latest only", "Keep last 5", "Keep last 10"], group = grpPred)
clusterTol  = input.float(0.5, "Küme toleransı (× ATR)",  minval = 0.05, step = 0.05, group = grpPred)
showSecond  = input.bool(false, "Secondary D Target göster", group = grpPred)
colPrimary  = input.color(color.new(color.lime,   0), "Primary kutu rengi",   group = grpPred)
colSecond   = input.color(color.new(color.orange, 0), "Secondary kutu rengi", group = grpPred)

grpFilt     = "XABC Geçerlilik Filtreleri"
abXaMin     = input.float(0.25, "AB/XA min", step = 0.01, group = grpFilt)
abXaMax     = input.float(0.90, "AB/XA max", step = 0.01, group = grpFilt)
bcAbMin     = input.float(0.30, "BC/AB min", step = 0.01, group = grpFilt)
bcAbMax     = input.float(2.00, "BC/AB max", step = 0.01, group = grpFilt)

keepCount = histMode == "Keep last 5" ? 5 : histMode == "Keep last 10" ? 10 : 1

// =============================================================================
// Veri yapıları (KORUNAN ALTYAPI)
// =============================================================================
// Onaylanmış pivot. kind: +1 = HIGH (tepe), -1 = LOW (dip).
type Pivot
    float price
    int   bidx
    int   ptime
    int   kind
    int   confIdx
    float theta

// Pivot motoru durumu (state machine).
type Engine
    bool  init
    bool  booted
    int   dir
    float curPrice
    int   curIdx
    int   curTime
    float curTheta
    float oppPrice
    int   oppIdx
    int   oppTime
    float oppTheta

// Bir prediction grubunun çizim nesneleri (grup bazlı silme için).
type PredGroup
    array<label> labels
    array<box>   boxes

// =============================================================================
// Repaint-safe pivot motoru (KORUNAN ALTYAPI — davranış değişmedi)
// -----------------------------------------------------------------------------
// "Dual-Tracker Confirmed Deviation ZigZag": bir uç, fiyat ondan (dondurulmuş)
// theta = k*ATR kadar TERS çekildiğinde VE en az minBars kapanmış bar geçince
// KESİNLEŞİR. Konservatif bar-içi kural: aynı mumda hem yeni ekstrem hem ters
// sapma oluşursa o barda onay verilmez. Yalnızca KAPANMIŞ barlarda çağrılır.
// =============================================================================
f_engine_new() =>
    Engine.new(init = false, booted = false, dir = 0,
         curPrice = na, curIdx = na, curTime = na, curTheta = na,
         oppPrice = na, oppIdx = na, oppTime = na, oppTheta = na)

f_engine_step(Engine e, float k, int minBars, float atr) =>
    Pivot result = na

    if not na(atr)
        if not e.init
            e.init     := true
            e.booted   := false
            e.curPrice := high
            e.curIdx   := bar_index
            e.curTime  := time
            e.curTheta := k * atr
            e.oppPrice := low
            e.oppIdx   := bar_index
            e.oppTime  := time
            e.oppTheta := k * atr

        else if not e.booted
            newHigh = high > e.curPrice
            newLow  = low  < e.oppPrice
            if newHigh
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
            if newLow
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

            dropFromHigh = (not newHigh) and (e.curPrice - low) >= e.curTheta and (bar_index - e.curIdx) >= minBars
            riseFromLow  = (not newLow)  and (high - e.oppPrice) >= e.oppTheta and (bar_index - e.oppIdx) >= minBars

            bool doHigh = false
            bool doLow  = false
            if dropFromHigh and riseFromLow
                if e.curIdx < e.oppIdx
                    doHigh := true
                else if e.oppIdx < e.curIdx
                    doLow  := true
            else if dropFromHigh
                doHigh := true
            else if riseFromLow
                doLow  := true

            if doHigh
                result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                e.booted := true
                e.dir    := -1
                e.curPrice := low
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := high
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr
            else if doLow
                result := Pivot.new(e.oppPrice, e.oppIdx, e.oppTime, -1, bar_index, e.oppTheta)
                e.booted := true
                e.dir    := 1
                e.curPrice := high
                e.curIdx   := bar_index
                e.curTime  := time
                e.curTheta := k * atr
                e.oppPrice := low
                e.oppIdx   := bar_index
                e.oppTime  := time
                e.oppTheta := k * atr

        else
            if e.dir == 1
                if high > e.curPrice
                    e.curPrice := high
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := low
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if low < e.oppPrice
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.curPrice - e.oppPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, 1, bar_index, e.curTheta)
                        e.dir      := -1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
            else
                if low < e.curPrice
                    e.curPrice := low
                    e.curIdx   := bar_index
                    e.curTime  := time
                    e.curTheta := k * atr
                    e.oppPrice := high
                    e.oppIdx   := bar_index
                    e.oppTime  := time
                    e.oppTheta := k * atr
                else
                    if high > e.oppPrice
                        e.oppPrice := high
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
                    if (e.oppPrice - e.curPrice) >= e.curTheta and (bar_index - e.curIdx) >= minBars
                        result := Pivot.new(e.curPrice, e.curIdx, e.curTime, -1, bar_index, e.curTheta)
                        e.dir      := 1
                        e.curPrice := e.oppPrice
                        e.curIdx   := e.oppIdx
                        e.curTime  := e.oppTime
                        e.curTheta := e.oppTheta
                        e.oppPrice := low
                        e.oppIdx   := bar_index
                        e.oppTime  := time
                        e.oppTheta := k * atr
    result

// =============================================================================
// Prediction yardımcıları
// =============================================================================

// XABC geçerlilik kontrolü (oranlar GRAFİKTE gösterilmez; yalnızca filtre).
f_xabc_valid(Pivot X, Pivot A, Pivot B, Pivot C) =>
    bool chrono = X.bidx < A.bidx and A.bidx < B.bidx and B.bidx < C.bidx
    bool alt    = X.kind != A.kind and A.kind != B.kind and B.kind != C.kind
    bool form   = (X.kind == -1 and A.kind == 1 and B.kind == -1 and C.kind == 1) or (X.kind == 1 and A.kind == -1 and B.kind == 1 and C.kind == -1)
    float xa = math.abs(A.price - X.price)
    float ab = math.abs(B.price - A.price)
    float bc = math.abs(C.price - B.price)
    bool legs = xa > 0 and ab > 0 and bc > 0
    bool ratios = false
    if legs
        float abXa = ab / xa
        float bcAb = bc / ab
        ratios := abXa >= abXaMin and abXa <= abXaMax and bcAb >= bcAbMin and bcAb <= bcAbMax
    chrono and alt and form and legs and ratios

// En güçlü kümeyi bulur: her aday merkez için tol içindeki üye sayısını sayar;
// en çok üyeli (eşitlikte en dar aralıklı) kümeyi döndürür. `used`=true olanlar
// (önceki kümeye ait) atlanır. DÖNÜŞ: [merkezIndex, üyeSayısı, altFiyat, üstFiyat].
f_cluster(array<float> dvals, array<bool> used, float tol) =>
    int   bestIdx = -1
    int   bestCnt = 0
    float bestLo  = na
    float bestHi  = na
    int   nD = array.size(dvals)
    for i = 0 to nD - 1
        if not array.get(used, i)
            float center = array.get(dvals, i)
            int   cnt = 0
            float lo  = na
            float hi  = na
            for j = 0 to nD - 1
                if not array.get(used, j)
                    float dj = array.get(dvals, j)
                    if math.abs(dj - center) <= tol
                        cnt += 1
                        lo := na(lo) ? dj : math.min(lo, dj)
                        hi := na(hi) ? dj : math.max(hi, dj)
            bool better = cnt > bestCnt or (cnt == bestCnt and not na(hi) and not na(bestHi) and (hi - lo) < (bestHi - bestLo))
            if better
                bestIdx := i
                bestCnt := cnt
                bestLo  := lo
                bestHi  := hi
    [bestIdx, bestCnt, bestLo, bestHi]

// Bir pivotu harf etiketiyle işaretler ve label'ı döndürür.
f_mark(int bidx, float price, string txt) =>
    label.new(bidx, price, txt, xloc = xloc.bar_index, style = label.style_label_center,
         color = color.new(color.gray, 25), textcolor = color.white, size = size.small,
         force_overlay = true)

// Bir D-target kümesini kutu olarak çizer (C barından sağa uzanır) ve gruba ekler.
f_target_box(PredGroup g, int x1, int x2, float lo, float hi, int cnt, string title, color col, float atrv) =>
    float pad = (hi - lo) < atrv * 0.05 ? atrv * 0.20 : 0.0
    float mid = (lo + hi) / 2.0
    box b = box.new(x1, hi + pad, x2, lo - pad, border_color = col, bgcolor = color.new(col, 82),
         text = title + "  " + str.tostring(mid, format.mintick) + "  (x" + str.tostring(cnt) + ")",
         text_color = col, text_size = size.small, text_halign = text.align_left, text_valign = text.align_center,
         force_overlay = true)
    array.push(g.boxes, b)

// Bir prediction grubunun tüm nesnelerini güvenle siler.
f_group_delete(PredGroup g) =>
    if array.size(g.labels) > 0
        for lb in g.labels
            label.delete(lb)
        array.clear(g.labels)
    if array.size(g.boxes) > 0
        for bx in g.boxes
            box.delete(bx)
        array.clear(g.boxes)

// =============================================================================
// Motor örneği + confirmed pivot ring buffer (KORUNAN ALTYAPI, çizilmez)
// =============================================================================
var Engine        pivEng = f_engine_new()
var array<Pivot>  pivots = array.new<Pivot>()
BUFFER_MAX = 16

atr = ta.atr(atrLen)

// REPAINT GÜVENLİĞİ: motor yalnızca KAPANMIŞ barda ilerler.
Pivot newPiv = na
if barstate.isconfirmed
    newPiv := f_engine_step(pivEng, pivK, pivMinBars, atr)
    if not na(newPiv)
        array.push(pivots, newPiv)
        if array.size(pivots) > BUFFER_MAX
            array.shift(pivots)

// =============================================================================
// PREDICTION ENGINE — hesapla (ham çizme) -> kümelendir -> en güçlü hedef(ler)i çiz
// -----------------------------------------------------------------------------
// XA projection: D = A - r*(A-X)   |   BC projection: D = C - r*(C-B)
// Yön filtresi: L-H-L-H (X dip) yalnızca D<C ; H-L-H-L (X tepe) yalnızca D>C.
// Geçerli D'ler bir havuza toplanır; ham çizilmez. Fiyat toleransına göre
// kümelenir; en güçlü küme Primary, ikincisi (opsiyonel) Secondary olarak kutu.
// =============================================================================
var array<float> xaRatios = array.from(0.786, 0.886, 1.000, 1.130, 1.272, 1.618)
var array<float> bcRatios = array.from(1.272, 1.414, 1.618, 2.000, 2.240, 2.618, 3.140, 3.618)

// Aktif prediction grupları (en yeni sonda). Grup bazlı saklanır/silinir.
var array<PredGroup> groups = array.new<PredGroup>()

// Yeni confirmed pivot (yeni C) geldiğinde: doğrula, hesapla, kümelendir, çiz (bir kez).
if not na(newPiv) and array.size(pivots) >= 4
    int n = array.size(pivots)
    Pivot X = array.get(pivots, n - 4)
    Pivot A = array.get(pivots, n - 3)
    Pivot B = array.get(pivots, n - 2)
    Pivot C = array.get(pivots, n - 1)

    if f_xabc_valid(X, A, B, C)
        bool wantDown = X.kind == -1   // L-H-L-H -> D aşağı ; H-L-H-L -> D yukarı

        // 1) Geçerli D seviyelerini içeride topla (HAM ÇİZME).
        array<float> dvals = array.new<float>()
        float xaDelta = A.price - X.price
        float bcDelta = C.price - B.price
        for i = 0 to array.size(xaRatios) - 1
            float r = array.get(xaRatios, i)
            float d = A.price - r * xaDelta
            if (wantDown ? d < C.price : d > C.price)
                array.push(dvals, d)
        for i = 0 to array.size(bcRatios) - 1
            float r = array.get(bcRatios, i)
            float d = C.price - r * bcDelta
            if (wantDown ? d < C.price : d > C.price)
                array.push(dvals, d)

        if array.size(dvals) > 0
            // 2) Kümelendir.
            float tol = clusterTol * atr
            array<bool> used = array.new<bool>(array.size(dvals), false)
            [pIdx, pCnt, pLo, pHi] = f_cluster(dvals, used, tol)

            if pIdx >= 0 and pCnt > 0
                PredGroup g = PredGroup.new(array.new<label>(), array.new<box>())
                int x1 = C.bidx
                int x2 = C.bidx + projLen

                // X A B C harfleri.
                array.push(g.labels, f_mark(X.bidx, X.price, "X"))
                array.push(g.labels, f_mark(A.bidx, A.price, "A"))
                array.push(g.labels, f_mark(B.bidx, B.price, "B"))
                array.push(g.labels, f_mark(C.bidx, C.price, "C"))

                // 3) Primary D Target kutusu.
                f_target_box(g, x1, x2, pLo, pHi, pCnt, "Primary D Target", colPrimary, atr)

                // Primary üyelerini işaretle -> Secondary için hariç tut.
                float pc = array.get(dvals, pIdx)
                for j = 0 to array.size(dvals) - 1
                    if math.abs(array.get(dvals, j) - pc) <= tol
                        array.set(used, j, true)

                // 4) Secondary D Target (opsiyonel).
                if showSecond
                    [sIdx, sCnt, sLo, sHi] = f_cluster(dvals, used, tol)
                    if sIdx >= 0 and sCnt > 0
                        f_target_box(g, x1, x2, sLo, sHi, sCnt, "Secondary D Target", colSecond, atr)

                // 5) Grubu ekle; historical moda göre eski grupları sil.
                array.push(groups, g)
                while array.size(groups) > keepCount
                    PredGroup old = array.shift(groups)
                    f_group_delete(old)

// =============================================================================
// AÇIKLAMA
// -----------------------------------------------------------------------------
// XABC doğrulaması (f_xabc_valid): kronoloji + alternasyon + tam L-H-L-H/H-L-H-L
//   biçimi + leg>0 + AB/XA ve BC/AB oran sınırları. Geçersizse hiçbir hedef çizilmez.
// Üretim anı: yalnızca yeni confirmed pivot (yeni C) bar-close event'inde, bir kez;
//   üretim ve çizim aynı event.
// XA / BC formülleri: D_XA = A - r*(A-X) ; D_BC = C - r*(C-B). Yön filtresinden geçer.
// Kümelendirme: geçerli D'ler ham çizilmez; tol = clusterTol*ATR içinde en çok üyeli
//   küme Primary, kalanlardan en güçlüsü Secondary (opsiyonel). Kutu = küme aralığı.
// Neden repaint yok: motor yalnızca barstate.isconfirmed içinde ilerler; C onaylanınca
//   X/A/B/C ve D fiyatları/kutu sınırları sabit; request.security/lookahead yok;
//   historical gruplar bir daha güncellenmez, yalnızca (pruning'de) silinir.
// =============================================================================
